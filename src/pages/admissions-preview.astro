---
// Admissions Page Preview — full design, matches design-preview aesthetic
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Admissions — Sunbright Recovery Center</title>
  <meta name="robots" content="noindex"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --navy:#1a2e5a; --navy-dk:#101d3a; --navy-mid:#254080; --navy-lt:#edf1fa;
      --gold:#c8900a; --gold-lt:#f0c040; --gold-pale:#fdf5e0; --gold-bg:#fef9ee;
      --cream:#f8f3ea; --cream-dk:#efe8d8; --white:#fff;
      --text:#1a2438; --mid:#3d4a5c; --soft:#6b7a8d; --border:#e2d9c8;
    }
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.6}
    h1,h2,h3,h4{font-family:'Lora',Georgia,serif;line-height:1.2}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    .wrap{max-width:1160px;margin:0 auto;padding:0 28px}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 28px;border-radius:8px;font-size:14.5px;font-weight:700;font-family:'Inter',sans-serif;transition:all .2s;cursor:pointer;border:none;text-decoration:none}
    .btn:hover{transform:translateY(-2px)}
    .btn-gold{background:var(--gold);color:#fff;box-shadow:0 4px 16px rgba(200,144,10,.4)}
    .btn-gold:hover{background:#a87008}
    .btn-navy{background:var(--navy);color:#fff;box-shadow:0 4px 14px rgba(26,46,90,.35)}
    .btn-navy:hover{background:var(--navy-dk)}
    .btn-ghost{background:rgba(255,255,255,.14);color:#fff;border:2px solid rgba(255,255,255,.45)}
    .btn-ghost:hover{background:rgba(255,255,255,.25)}
    .btn-outline{background:transparent;color:var(--navy);border:2px solid var(--navy)}
    .btn-outline:hover{background:var(--navy-lt)}

    /* NAV */
    nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(26,46,90,.08)}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;height:82px}
    .nav-in img{height:66px;width:auto}
    .nav-links{display:flex;align-items:center;gap:2px}
    .nav-links a{padding:8px 12px;border-radius:6px;font-size:13.5px;font-weight:500;color:var(--mid);transition:all .15s}
    .nav-links a:hover,.nav-links a.active{color:var(--navy);background:var(--navy-lt)}
    .nav-cta{display:flex;align-items:center;gap:7px;background:var(--navy);color:#fff;padding:11px 20px;border-radius:8px;font-size:14px;font-weight:700;box-shadow:0 2px 12px rgba(26,46,90,.3);transition:all .2s}
    .nav-cta:hover{background:var(--navy-dk);transform:translateY(-1px)}
    svg.ph{width:15px;height:15px;flex-shrink:0}

    /* PAGE HEADER */
    .page-hero{background:var(--navy-dk);position:relative;overflow:hidden;padding:64px 28px 80px}
    .page-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 110% 140% at 50% 100%,#243a7a 0%,#1a2e5a 40%,#0d1e3a 100%)}
    .page-hero::after{content:'';position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:700px;height:400px;background:radial-gradient(ellipse,rgba(240,192,64,.18),transparent 65%)}
    .ph-in{position:relative;z-index:2;max-width:1160px;margin:0 auto;text-align:center}
    .ph-crumb{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:14px;display:flex;align-items:center;justify-content:center;gap:8px}
    .ph-crumb a{color:rgba(255,255,255,.45);transition:color .15s}
    .ph-crumb a:hover{color:var(--gold-lt)}
    .ph-script{font-family:'Dancing Script',cursive;font-size:30px;color:var(--gold-lt);display:block;margin-bottom:4px}
    .page-hero h1{font-size:clamp(38px,5.5vw,60px);font-weight:700;color:#fff;letter-spacing:-.02em;margin-bottom:16px;line-height:1.1}
    .page-hero .lead{font-size:17px;color:rgba(255,255,255,.65);line-height:1.75;max-width:620px;margin:0 auto 28px}
    .ph-ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

    /* INTRO REASSURANCE */
    .intro{padding:60px 0;background:var(--cream);text-align:center}
    .intro-in{max-width:720px;margin:0 auto}
    .intro .script-sm{font-family:'Dancing Script',cursive;font-size:26px;color:var(--gold);display:block;margin-bottom:4px}
    .intro h2{font-size:clamp(24px,3vw,34px);color:var(--navy);margin-bottom:14px}
    .intro p{font-size:17px;color:var(--mid);line-height:1.8}

    /* PROCESS STEPS */
    .process{padding:72px 0;background:var(--white)}
    .sec-head{text-align:center;margin-bottom:44px}
    .sec-script{font-family:'Dancing Script',cursive;font-size:28px;color:var(--gold);display:block;margin-bottom:2px}
    .sec-h2{font-size:clamp(26px,3.5vw,40px);color:var(--navy);margin-bottom:8px}
    .sec-sub{font-size:16px;color:var(--soft);max-width:520px;margin:0 auto}

    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
    .step{position:relative}
    .step-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:28px 22px;height:100%;display:flex;flex-direction:column;transition:all .25s}
    .step-card:hover{border-color:var(--gold);box-shadow:0 8px 24px rgba(200,144,10,.1);transform:translateY(-3px)}
    .step-num{width:48px;height:48px;border-radius:50%;background:var(--gold);color:var(--navy-dk);font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-bottom:16px;box-shadow:0 4px 12px rgba(200,144,10,.35)}
    .step-card h3{font-family:'Inter',sans-serif;font-size:16px;font-weight:700;color:var(--navy);margin-bottom:6px}
    .step-time{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
    .step-card p{font-size:13.5px;color:var(--soft);line-height:1.7;flex:1}

    /* PAYMENT — the big one */
    .payment{padding:80px 0;background:var(--gold-bg)}
    .payment-head{text-align:center;max-width:680px;margin:0 auto 40px}
    .payment-head .script-lg{font-family:'Dancing Script',cursive;font-size:34px;color:var(--gold);display:block;margin-bottom:4px}
    .payment-head h2{font-size:clamp(28px,3.8vw,44px);color:var(--navy);margin-bottom:14px;line-height:1.2}
    .payment-head .promise{font-size:18px;color:var(--mid);line-height:1.7;font-style:italic}
    .pay-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px}
    .pay-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:30px;transition:all .25s}
    .pay-card.now{border:2px solid var(--gold)}
    .pay-card-top{display:flex;align-items:center;gap:14px;margin-bottom:16px}
    .pay-status{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .pay-status.now{background:var(--gold);color:#fff}
    .pay-status.soon{background:var(--navy-lt);color:var(--navy)}
    .pay-card h3{font-size:19px;color:var(--navy);margin-bottom:2px}
    .pay-card-label{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .pay-card-label.now{color:var(--gold)}
    .pay-card-label.soon{color:var(--navy-mid)}
    .pay-card p{font-size:14.5px;color:var(--mid);line-height:1.7;margin-bottom:14px}
    .pay-card ul{list-style:none;display:flex;flex-direction:column;gap:7px}
    .pay-card ul li{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--mid)}
    .pay-card ul li svg{width:14px;height:14px;color:var(--gold);flex-shrink:0}
    .pay-banner{background:var(--navy);border-radius:16px;padding:36px 32px;text-align:center;position:relative;overflow:hidden}
    .pay-banner::before{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:500px;height:300px;background:radial-gradient(ellipse,rgba(200,144,10,.15),transparent 65%)}
    .pay-banner-script{font-family:'Dancing Script',cursive;font-size:32px;color:var(--gold-lt);display:block;margin-bottom:4px;position:relative}
    .pay-banner h3{font-size:24px;color:#fff;margin-bottom:10px;position:relative}
    .pay-banner p{font-size:16px;color:rgba(255,255,255,.65);max-width:560px;margin:0 auto 22px;line-height:1.7;position:relative}
    .pay-banner-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;position:relative}

    /* WHAT TO EXPECT */
    .expect{padding:72px 0;background:var(--cream)}
    .expect-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .expect-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:28px;transition:all .25s}
    .expect-card:hover{border-color:var(--gold);box-shadow:0 6px 20px rgba(26,46,90,.08)}
    .expect-icon{width:48px;height:48px;border-radius:12px;background:var(--gold-pale);border:1.5px solid var(--cream-dk);display:flex;align-items:center;justify-content:center;margin-bottom:14px}
    .expect-card h3{font-size:18px;color:var(--navy);margin-bottom:8px}
    .expect-card p{font-size:14px;color:var(--soft);line-height:1.7}

    /* WHAT TO BRING */
    .bring{padding:72px 0;background:var(--white)}
    .bring-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
    .bring-script{font-family:'Dancing Script',cursive;font-size:26px;color:var(--gold);display:block;margin-bottom:4px}
    .bring h2{font-size:clamp(26px,3.3vw,38px);color:var(--navy);margin-bottom:14px}
    .bring p{font-size:15.5px;color:var(--mid);line-height:1.8;margin-bottom:20px}
    .bring-cols{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .bring-col h4{font-family:'Inter',sans-serif;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;padding-bottom:8px;border-bottom:1.5px solid var(--gold-pale)}
    .bring-col ul{list-style:none;display:flex;flex-direction:column;gap:7px}
    .bring-col ul li{display:flex;align-items:flex-start;gap:7px;font-size:13.5px;color:var(--mid);line-height:1.5}
    .bring-col ul li::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--gold);margin-top:8px;flex-shrink:0}
    .bring-col.no h4{color:var(--navy)}
    .bring-col.no ul li::before{background:var(--navy)}

    /* CONTACT FORM */
    .contact-cta{padding:72px 0;background:var(--navy);position:relative;overflow:hidden}
    .contact-cta::before{content:'';position:absolute;top:-100px;right:-100px;width:500px;height:500px;background:radial-gradient(ellipse,rgba(200,144,10,.1),transparent 65%)}
    .contact-grid{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
    .contact-text .script-lg{font-family:'Dancing Script',cursive;font-size:54px;color:var(--gold-lt);display:block;line-height:1;margin-bottom:2px}
    .contact-text h2{font-size:clamp(28px,3.5vw,40px);color:#fff;margin-bottom:16px}
    .contact-text p{font-size:16px;color:rgba(255,255,255,.6);line-height:1.8;margin-bottom:28px}
    .contact-points{display:flex;flex-direction:column;gap:10px}
    .contact-point{display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(255,255,255,.75)}
    .contact-point svg{width:18px;height:18px;color:var(--gold-lt);flex-shrink:0}
    .contact-card{background:var(--white);border-radius:18px;padding:36px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
    .contact-card .label{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
    .contact-card h3{font-size:22px;color:var(--navy);margin-bottom:18px}
    .form-row{margin-bottom:14px}
    .form-row label{display:block;font-size:12px;font-weight:700;color:var(--navy);margin-bottom:6px}
    .form-row input,.form-row textarea,.form-row select{width:100%;padding:11px 14px;font-family:'Inter',sans-serif;font-size:14px;color:var(--text);background:var(--white);border:1.5px solid var(--border);border-radius:8px;transition:border-color .15s}
    .form-row input:focus,.form-row textarea:focus,.form-row select:focus{outline:none;border-color:var(--gold)}
    .form-row textarea{resize:vertical;min-height:90px}
    .form-row-double{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .form-priv{font-size:12px;color:var(--soft);margin-top:10px;display:flex;align-items:flex-start;gap:6px;line-height:1.5}
    .form-priv svg{width:14px;height:14px;color:var(--gold);flex-shrink:0;margin-top:2px}
    .form-submit{margin-top:18px;width:100%}

    /* FAQ */
    .faq-sec{padding:72px 0;background:var(--cream)}
    .faq-list{max-width:740px;margin:0 auto;display:flex;flex-direction:column;gap:9px}
    .faq-item{background:var(--white);border:1.5px solid var(--border);border-radius:12px;overflow:hidden}
    .faq-item.open{border-color:var(--navy)}
    .faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px 22px;background:none;border:none;cursor:pointer;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;color:var(--navy);text-align:left;transition:background .15s}
    .faq-q:hover{background:var(--navy-lt)}
    .faq-q svg{width:18px;height:18px;color:var(--gold);flex-shrink:0;transition:transform .25s}
    .faq-item.open .faq-q svg{transform:rotate(180deg)}
    .faq-a{padding:0 22px 18px;font-size:14.5px;color:var(--mid);line-height:1.8;display:none}
    .faq-item.open .faq-a{display:block}

    /* FINAL CTA */
    .final{padding:72px 0;background:var(--gold-bg)}
    .final-in{text-align:center}
    .final-script{font-family:'Dancing Script',cursive;font-size:54px;color:var(--gold);display:block;margin-bottom:2px}
    .final h2{font-size:clamp(28px,3.8vw,44px);color:var(--navy);margin-bottom:12px}
    .final p{font-size:17px;color:var(--soft);margin-bottom:30px;max-width:480px;margin-left:auto;margin-right:auto}
    .final-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:18px}
    .final-priv{display:flex;align-items:center;justify-content:center;gap:7px;font-size:12.5px;color:var(--soft)}
    .final-priv svg{width:12px;height:12px;color:var(--gold)}

    /* FOOTER (compact) */
    footer{background:var(--navy-dk);padding:36px 28px;text-align:center;color:rgba(255,255,255,.5);font-size:13px}
    footer .ft{font-family:'Dancing Script',cursive;font-size:18px;color:rgba(255,255,255,.4);margin-top:8px}

    .sticky{position:fixed;bottom:20px;right:20px;z-index:200}
    .sticky a{display:flex;align-items:center;gap:8px;background:var(--navy);color:#fff;padding:12px 20px;border-radius:100px;font-size:14px;font-weight:700;box-shadow:0 8px 24px rgba(26,46,90,.5);transition:all .2s}
    .sticky a:hover{background:var(--navy-dk);transform:translateY(-2px)}
  </style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-in">
    <a href="/"><img src="/logo.png" alt="Sunbright Recovery Center"/></a>
    <div class="nav-links">
      <a href="/programs">Programs</a><a href="/what-we-treat">What We Treat</a>
      <a href="/our-approach">Our Approach</a><a href="/admissions" class="active">Admissions</a>
      <a href="/insurance">Insurance</a><a href="/team">Team</a><a href="/contact">Contact</a>
    </div>
    <a href="tel:+15305282342" class="nav-cta">
      <svg class="ph" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      (530) 528-2342
    </a>
  </div>
</nav>


<!-- PAGE HERO -->
<section class="page-hero">
  <div class="ph-in">
    <div class="ph-crumb">
      <a href="/">Home</a> <span>›</span> Admissions
    </div>
    <span class="ph-script">Your journey</span>
    <h1>Begins with one call.</h1>
    <p class="lead">We've made admissions as simple as we possibly can. One private conversation, an honest assessment, and a clear path forward. No pressure. No commitment until you're ready.</p>
    <div class="ph-ctas">
      <a href="tel:+15305282342" class="btn btn-gold">
        <svg class="ph" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call (530) 528-2342
      </a>
      <a href="#contact-form" class="btn btn-ghost">Send a Message</a>
    </div>
  </div>
</section>


<!-- INTRO REASSURANCE -->
<section class="intro">
  <div class="intro-in">
    <span class="script-sm">Before you call</span>
    <h2>You don't need to have it all figured out.</h2>
    <p>You don't need insurance lined up. You don't need to know what level of care you need. You don't need to be ready to commit. All you need to do is call. We'll handle the rest — together.</p>
  </div>
</section>


<!-- PROCESS STEPS -->
<section class="process">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-script">How it works</span>
      <h2 class="sec-h2">The admissions process</h2>
      <p class="sec-sub">Four simple steps, designed to feel supportive — not bureaucratic.</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-card">
          <div class="step-num">01</div>
          <h3>Call or Message Us</h3>
          <div class="step-time">5–10 Minutes</div>
          <p>Reach out by phone or through the form below. We'll listen first, then answer every question you have. No pressure, no script — just a real conversation.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-card">
          <div class="step-num">02</div>
          <h3>Free Assessment</h3>
          <div class="step-time">30–45 Minutes</div>
          <p>A brief, confidential clinical screening helps us understand what level of care fits best. Done by phone or in person — whatever feels right to you.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-card">
          <div class="step-num">03</div>
          <h3>Plan Your Path</h3>
          <div class="step-time">Same Day</div>
          <p>We talk through your treatment plan, walk you through what arrival looks like, and have an honest conversation about payment options that work for you.</p>
        </div>
      </div>
      <div class="step">
        <div class="step-card">
          <div class="step-num">04</div>
          <h3>Begin Recovery</h3>
          <div class="step-time">Within 3–5 Days</div>
          <p>Most clients are admitted within three to five days of their first call. We help coordinate travel, pre-admission needs, and a smooth arrival.</p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- PAYMENT — the honest section -->
<section class="payment">
  <div class="wrap">
    <div class="payment-head">
      <span class="script-lg">Let's be honest</span>
      <h2>Cost should never be the reason someone doesn't get help.</h2>
      <p class="promise">We believe that. So we've built our admissions process around making care accessible — whatever that looks like for you.</p>
    </div>

    <div class="pay-grid">
      <!-- Private Pay -->
      <div class="pay-card now">
        <div class="pay-card-top">
          <div class="pay-status now">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <div class="pay-card-label now">Available Today</div>
            <h3>Private Pay</h3>
          </div>
        </div>
        <p>We currently accept private pay (also called self-pay) for all our programs. This means treatment costs are paid directly — but it doesn't mean you're on your own.</p>
        <ul>
          <li><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Transparent, upfront pricing</li>
          <li><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Payment plan options available</li>
