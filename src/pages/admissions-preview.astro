<!-- WHAT TO EXPECT -->
<section class="expect">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-script">When you call</span>
      <h2 class="sec-h2">What to expect</h2>
      <p class="sec-sub">Calling for the first time can feel hard. Here's exactly what happens.</p>
    </div>
    <div class="expect-grid">
      <div class="expect-card">
        <div class="expect-icon">
          <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#c8900a" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h3>Complete privacy</h3>
        <p>Your call is private and confidential. Nothing is shared with anyone outside our team without your written permission. We follow HIPAA confidentiality standards.</p>
      </div>
      <div class="expect-card">
        <div class="expect-icon">
          <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#c8900a" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
