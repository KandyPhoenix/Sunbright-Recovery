    .ways-banner{display:flex;align-items:center;justify-content:space-between;gap:24px;background:linear-gradient(120deg,var(--navy) 0%,var(--navy-mid) 100%);border:1px solid rgba(240,192,64,.3);border-radius:16px;padding:22px 30px;margin:20px 0 28px;text-decoration:none;transition:transform .25s,box-shadow .25s,border-color .25s}
