---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ProgramCard from '../components/ProgramCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABanner from '../components/CTABanner.astro';
import { homepageFaqSchema } from '../schema/faqPage';

const programs = [
  {
    title: 'Residential Rehab',
    description: '30, 60, or 90-day inpatient programs in a safe, structured environment. Full-time support as you build the foundation for lasting recovery.',
    href: '/programs/residential',
    icon: 'home' as const,
    tag: 'Primary Program',
  },
  {
    title: 'Outpatient (IOP / PHP)',
    description: 'Intensive outpatient and partial hospitalization programs — structured treatment that fits around your life and responsibilities.',
    href: '/programs/outpatient',
    icon: 'outpatient' as const,
  },
  {
    title: 'Sober Living & Aftercare',
    description: 'Transitional housing and step-down support for people leaving residential treatment. Community, accountability, and a path forward.',
    href: '/programs/sober-living',
    icon: 'sober' as const,
  },
];

const conditions = [
  { label: 'Alcohol Use Disorder', href: '/what-we-treat/alcohol', icon: '🍃' },
  { label: 'Opioid Addiction', href: '/what-we-treat/opioids', icon: '🌿' },
  { label: 'Dual Diagnosis', href: '/what-we-treat/dual-diagnosis', icon: '🌱' },
  { label: 'Trauma & Addiction', href: '/what-we-treat/trauma-addiction', icon: '☀️' },
];

const trustPillars = [
  {
    title: 'Faith-integrated, never required',
    description: 'Recovery rooted in hope and meaning. Spiritual support is available for those who want it — never pushed on those who don\'t.',
    icon: 'faith',
  },
  {
    title: 'Evidence-based therapies',
    description: 'CBT, motivational interviewing, trauma-informed care, and family systems therapy — proven approaches that actually work.',
    icon: 'evidence',
  },
  {
    title: 'Medi-Cal accepted',
    description: 'Recovery should be reachable regardless of income. We accept Medi-Cal, Medicare, and private insurance. Sliding scale available.',
    icon: 'insurance',
  },
];

const admissionSteps = [
  { step: '01', title: 'Call Us', desc: 'One private conversation. No commitment. We\'ll listen and answer every question.' },
  { step: '02', title: 'Assessment', desc: 'A brief clinical assessment helps us understand what level of care fits you best.' },
  { step: '03', title: 'Verify Insurance', desc: 'We\'ll verify your Medi-Cal, Medicare, or private insurance coverage — fast and free.' },
  { step: '04', title: 'Begin Recovery', desc: 'Most clients are admitted within 3–5 days of their first call. Your journey starts here.' },
];

const homepageFAQs = [
  {
    question: 'Does Sunbright Recovery accept Medi-Cal?',
    answer: 'Yes. Medi-Cal is accepted and is a priority for us. Many people don\'t realize Medi-Cal covers substance use disorder treatment — including residential rehab. We\'ll verify your coverage at no cost to you.',
  },
  {
    question: 'How quickly can I get admitted?',
    answer: 'Most clients are admitted within 3–5 days of their first call. We\'ll work with your insurance, do the assessment, and get you into treatment as quickly as possible. Call us today to start the process.',
  },
  {
    question: 'Is Sunbright a Christian rehab?',
    answer: 'Sunbright is faith-integrated, not faith-required. Spiritual support and faith-based programming are available for those who want it — but recovery here does not require any particular religious belief. Everyone is welcome.',
  },
  {
    question: 'Where is Sunbright Recovery located?',
    answer: 'Sunbright Recovery Center is located at 22425 Sunbright Ave in Red Bluff, California — serving all of Northern California including Redding, Chico, and the Sacramento corridor.',
  },
  {
    question: 'What is the difference between residential and outpatient treatment?',
    answer: 'Residential (inpatient) treatment means you live at the facility during your 30–90 day program, with 24/7 support. Outpatient (IOP/PHP) means you attend structured programming during the day or evenings but return home. The right level depends on the severity of your situation — we\'ll help you figure that out.',
  },
];
---

<PageLayout
  title="Sunbright Recovery Center | Faith-Based Rehab California"
  description="Faith-integrated, evidence-based addiction recovery in Northern California. Residential, outpatient & sober living. Medi-Cal accepted. Call 530-528-2342."
  schema={homepageFaqSchema(homepageFAQs)}
>

  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28" style="background:#101d3a;">
    <!-- Brightening gradient — navy darkens at top, lightens toward bottom -->
    <div class="absolute inset-0" aria-hidden="true" style="background:radial-gradient(ellipse 110% 140% at 75% 50%, #243a7a 0%, #1a2e5a 35%, #0d1e3a 100%);"></div>

    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-gold-400 text-sm font-medium mb-5">
          <span class="w-1 h-4 bg-gold-500 rounded-full flex-shrink-0"></span>
          Founded by Linda Spyres, LCSW, LAADC-CA · 20+ years specialized addiction expertise
        </div>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold text-white leading-tight mb-5">
          Recovery Starts Here
        </h1>
        <p class="text-lg sm:text-xl text-navy-200 leading-relaxed mb-8 max-w-2xl">
          Faith-integrated, evidence-based addiction recovery in Northern California. Founded by people who've walked alongside recovery for 20+ years.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="tel:+15305282342" class="flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (530) 528-2342
          </a>
          <a href="/admissions" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/25 px-6 py-3.5 rounded-xl text-base font-semibold transition-all backdrop-blur-sm hover:-translate-y-0.5">
            Verify Your Insurance
          </a>
        </div>
        <p class="mt-5 text-sm text-navy-300 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Your call is completely private. We follow HIPAA confidentiality.
        </p>
      </div>
    </div>
  </section>

  <!-- Programs overview -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-ink-900 mb-3">
          Programs built for real recovery
        </h2>
        <p class="text-lg text-ink-500 leading-relaxed">
          From 30-day residential to step-down sober living — we meet you where you are and walk with you all the way through.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {programs.map(p => (
          <ProgramCard {...p} />
        ))}
      </div>
    </div>
  </section>

  <!-- Trust pillars -->
  <section class="py-14 lg:py-20 bg-navy-50">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-ink-900 mb-3">
          Why families choose Sunbright
        </h2>
        <p class="text-ink-500 text-lg">We built what Northern California was missing.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {trustPillars.map(pillar => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-gold-500 mx-auto mb-5 flex items-center justify-center shadow-md shadow-gold-500/30">
              {pillar.icon === 'faith' && (
                <svg class="w-7 h-7 text-navy-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1M4.22 4.22l.707.707m12.728 12.728l.707.707M1 12h2m18 0h2M4.22 19.78l.707-.707M18.364 5.636l.707-.707" />
                </svg>
              )}
              {pillar.icon === 'evidence' && (
                <svg class="w-7 h-7 text-navy-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {pillar.icon === 'insurance' && (
                <svg class="w-7 h-7 text-navy-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
              )}
            </div>
            <h3 class="font-serif text-xl font-semibold text-ink-900 mb-2">{pillar.title}</h3>
            <p class="text-ink-500 text-sm leading-relaxed max-w-xs mx-auto">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we treat -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-ink-900 mb-3">
          What we treat
        </h2>
        <p class="text-ink-500 text-lg">Addiction rarely comes alone. We treat the whole person.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {conditions.map(c => (
          <a
            href={c.href}
            class="group flex flex-col items-center text-center p-6 rounded-2xl border border-navy-100 hover:border-gold-300 hover:bg-gold-50 transition-all"
          >
            <span class="text-3xl mb-3">{c.icon}</span>
            <span class="font-medium text-ink-900 text-sm group-hover:text-navy-700 transition-colors">{c.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet Linda -->
  <section class="py-14 lg:py-20 bg-navy-800 text-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-gold-400 text-sm font-medium mb-5">
          <span class="w-1 h-4 bg-gold-500 rounded-full"></span>
          Meet Our Founder
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-white mb-5">
          20 years watching people heal. Sunbright is what Linda built when she realized Northern California needed more.
        </h2>
        <p class="text-navy-300 text-lg leading-relaxed mb-6">
          Linda Spyres, LCSW, LAADC-CA has spent over two decades in specialized addiction treatment. She's sat across from people in their darkest moments — and walked with them out the other side. Sunbright Recovery Center is the program she wished had existed all along.
        </p>
        <a href="/team" class="inline-flex items-center gap-2 text-gold-400 hover:text-gold-300 font-medium text-sm transition-colors">
          Meet the full team
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How admissions works -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-ink-900 mb-3">
          How admissions works
        </h2>
        <p class="text-ink-500 text-lg">Simple. Private. No pressure.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {admissionSteps.map((s, i) => (
          <div class="relative">
            {i < admissionSteps.length - 1 && (
              <div class="hidden lg:block absolute top-6 left-full w-full h-px bg-navy-100 z-0" style="width: calc(100% - 2.75rem); left: 2.75rem;"></div>
            )}
            <div class="relative">
              <div class="w-12 h-12 rounded-full bg-navy-700 text-white font-bold text-sm flex items-center justify-center mb-4 shadow-md">
                {s.step}
              </div>
              <h3 class="font-semibold text-ink-900 mb-1">{s.title}</h3>
              <p class="text-sm text-ink-500 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href="/admissions"
          class="inline-flex items-center gap-2 bg-navy-700 hover:bg-navy-800 text-white px-7 py-3.5 rounded-xl font-semibold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
        >
          Start Admissions
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Community Support / Donations -->
  <section class="py-14 lg:py-20 bg-gold-50 border-y border-gold-200">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 bg-gold-100 text-gold-700 text-sm font-semibold px-4 py-1.5 rounded-full mb-5 border border-gold-300">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          Community Support Needed
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-navy-800 mb-4">
          Help us build something beautiful for our community
        </h2>
        <p class="text-ink-500 text-lg leading-relaxed">
          Sunbright Recovery Center is preparing to open its doors. We're equipping the facility room by room — and we need this community's help to make it feel like home.
        </p>
      </div>

      <!-- Donation categories grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">

        <!-- Physical items -->
        <div class="bg-white rounded-2xl border border-gold-200 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-gold-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-ink-900 mb-2">Furnish a Room</h3>
          <p class="text-sm text-ink-500 leading-relaxed mb-3">Help us turn empty rooms into places of rest and healing.</p>
          <ul class="space-y-1.5 text-sm text-ink-700">
            {['Mattresses & bed frames', 'Bedding & pillows', 'Washable fabric chairs', 'Dressers & storage', 'Lamps & curtains'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Kitchen & appliances -->
        <div class="bg-white rounded-2xl border border-gold-200 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-gold-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-ink-900 mb-2">Kitchen & Appliances</h3>
          <p class="text-sm text-ink-500 leading-relaxed mb-3">Teaching people to cook their own meals is part of rebuilding independence.</p>
          <ul class="space-y-1.5 text-sm text-ink-700">
            {['Kitchen equipment & cookware', 'Refrigerator & microwave', 'Dishes, cups & utensils', 'Pantry staples', 'Appliances of any kind'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Life skills volunteers -->
        <div class="bg-white rounded-2xl border border-gold-200 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-gold-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-ink-900 mb-2">Volunteer Your Skills</h3>
          <p class="text-sm text-ink-500 leading-relaxed mb-3">Life skills are the bridge between recovery and a self-sufficient life.</p>
          <ul class="space-y-1.5 text-sm text-ink-700">
            {['Teach cooking or nutrition', 'Lead knitting or crafts', 'Garden & grow food together', 'Financial literacy coaching', 'Job readiness & resume help'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Farm & garden -->
        <div class="bg-white rounded-2xl border border-gold-200 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-gold-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-ink-900 mb-2">Farm, Garden & Animals</h3>
          <p class="text-sm text-ink-500 leading-relaxed mb-3">Growing things is one of the most healing things a person can do in recovery.</p>
          <ul class="space-y-1.5 text-sm text-ink-700">
            {['Chickens & chicken coops', 'Coop building supplies', 'Help training with chickens', 'Seeds, soil & garden tools', 'Raised garden bed materials'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Church / adopt a room -->
        <div class="bg-white rounded-2xl border border-navy-200 p-6 shadow-sm border-2">
          <div class="w-10 h-10 rounded-xl bg-navy-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="font-serif text-lg font-semibold text-ink-900">Churches: Adopt a Room</h3>
            <span class="text-xs font-semibold text-navy-700 bg-navy-50 px-2 py-0.5 rounded-full border border-navy-200">Featured</span>
          </div>
          <p class="text-sm text-ink-500 leading-relaxed mb-3">Your congregation can fully sponsor and furnish one room or one bed. A meaningful, tangible way to serve your community.</p>
          <ul class="space-y-1.5 text-sm text-ink-700">
            {['Sponsor a complete bedroom', 'Furnish a shared living space', 'Ongoing prayer partnership', 'Volunteer as a congregation', 'Monthly supply donations'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-navy-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Cash / gift cards -->
        <div class="bg-white rounded-2xl border border-gold-200 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-gold-100 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-lg font-semibold text-ink-900 mb-2">Cash & Gift Cards</h3>
          <p class="text-sm text-ink-500 leading-relaxed mb-3">Every dollar goes directly to equipping the facility and supporting people in recovery.</p>
          <ul class="space-y-1.5 text-sm text-ink-700">
            {['Cash donations (any amount)', 'Walmart gift cards for supplies', 'Amazon wish list items', 'Restaurant gift cards for residents', 'Gas cards for family visits'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

      </div>

      <!-- Facility photos -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-12">
        <img src="/images/facility-exterior.jpg" alt="Sunbright Recovery Center exterior — Red Bluff, CA" class="rounded-xl object-cover w-full h-40 lg:h-48" />
        <img src="/images/facility-common-room.jpg" alt="Common room under renovation" class="rounded-xl object-cover w-full h-40 lg:h-48" />
        <img src="/images/facility-interior.jpg" alt="Interior space being prepared" class="rounded-xl object-cover w-full h-40 lg:h-48" />
        <img src="/images/facility-tile.jpg" alt="New tile flooring being installed" class="rounded-xl object-cover w-full h-40 lg:h-48" />
      </div>

      <!-- CTA row -->
      <div class="bg-navy-800 rounded-2xl p-8 text-center">
        <h3 class="font-serif text-2xl font-semibold text-white mb-3">
          Any way you can help matters.
        </h3>
        <p class="text-navy-300 text-base mb-6 max-w-xl mx-auto">
          Whether it's a mattress, a morning teaching a cooking class, or a donation of $20 — every contribution helps bring someone closer to a life of recovery.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/donate"
            class="flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 px-6 py-3.5 rounded-xl font-bold transition-all shadow-md hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            Donate or Get Involved
          </a>
          <a
            href="/contact"
            class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/25 px-6 py-3.5 rounded-xl font-semibold transition-all hover:-translate-y-0.5"
          >
            Contact Us to Volunteer
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial / quote -->
  <section class="py-14 lg:py-16 bg-cream-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <svg class="w-10 h-10 text-gold-400 mx-auto mb-6" fill="currentColor" viewBox="0 0 32 32">
        <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
      </svg>
      <blockquote class="font-serif text-xl lg:text-2xl text-ink-900 leading-relaxed mb-6 italic">
        "People recover every day. We've watched it happen for 20 years. Sunbright exists because healing needs a safe place to start — and Northern California deserves one."
      </blockquote>
      <cite class="not-italic text-sm text-ink-500 font-medium">
        — Linda Spyres, LCSW, LAADC-CA, Founder
      </cite>
    </div>
  </section>

  <!-- FAQs -->
  <FAQAccordion
    heading="Common questions about recovery"
    items={homepageFAQs}
  />

  <!-- Final CTA -->
  <CTABanner
    heading="You don't have to figure this out alone."
    subtext="Call Sunbright Recovery. One private conversation can change everything."
    primaryCta={{ label: 'Call (530) 528-2342', href: 'tel:+15305282342' }}
    secondaryCta={{ label: 'Schedule a Tour', href: '/tour' }}
    variant="navy"
  />

</PageLayout>
