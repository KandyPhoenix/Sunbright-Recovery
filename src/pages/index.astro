    .sup-names{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:36px}
    .sup-pill{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:100px;padding:7px 16px;font-size:13px;color:rgba(255,255,255,.7);font-weight:500;transition:all .2s}
