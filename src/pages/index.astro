    .supporters::after{content:'';position:absolute;bottom:-60px;right:-60px;width:350px;height:350px;background:radial-gradient(ellipse,rgba(200,144,10,.06),transparent 65%);pointer-events:none}
    .sup-head{text-align:center;margin-bottom:44px;position:relative}
