    .f-col h4{font-family:'Dancing Script',cursive;font-size:16px;font-weight:700;color:rgba(255,255,255,.7);margin-bottom:16px}
    .f-col ul{list-style:none;display:flex;flex-direction:column;gap:10px}
    .f-col ul a{font-size:12px;color:rgba(255,255,255,.4);transition:color .15s;line-height:1.6}
    .f-col ul a:hover{color:var(--gold-lt)}
    .f-col .mt{margin-top:10px}
    .f-bot{max-width:1160px;margin:0 auto;border-top:1px solid rgba(255,255,255,.06);padding:20px 28px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.2)}
    .f-bot a{color:rgba(255,255,255,.28);transition:color .2s}
    .f-bot a:hover{color:var(--gold-lt)}
    .f-heal{font-family:'Dancing Script',cursive;font-size:15px;color:rgba(255,255,255,.25)}
    svg.ph{width:15px;height:15px;flex-shrink:0}
    /* --- hero sun: rises in the east, arcs west, sets, and repeats --- */
    @keyframes sunArc{
      0%{transform:translate(250px,95px) scale(.86);opacity:0;filter:brightness(.82) drop-shadow(0 0 26px rgba(240,192,64,.28))}
      14%{opacity:.7}
      30%{transform:translate(120px,6px) scale(.96);opacity:1;filter:brightness(1) drop-shadow(0 0 34px rgba(240,192,64,.4))}
      50%{transform:translate(0,-16px) scale(1);opacity:1;filter:brightness(1.07) drop-shadow(0 0 46px rgba(240,192,64,.5))}
      70%{transform:translate(-120px,6px) scale(.96);opacity:1;filter:brightness(1) drop-shadow(0 0 34px rgba(240,192,64,.4))}
      86%{opacity:.7}
      100%{transform:translate(-250px,95px) scale(.86);opacity:0;filter:brightness(.82) drop-shadow(0 0 26px rgba(240,192,64,.28))}
    }
    .hero-sun-only img{animation:sunArc 20s ease-in-out infinite;filter:brightness(1) drop-shadow(0 0 34px rgba(240,192,64,.4));position:relative;z-index:1}
    @keyframes twinkle{0%,100%{opacity:.3}50%{opacity:.6}}
    .hero-stars{animation:twinkle 6s ease-in-out infinite}
    /* --- scroll reveal --- */
    .rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
    .rv.in{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){
      .hero-sun-only img,.hero-stars{animation:none}
      .rv{opacity:1!important;transform:none!important}
    }
  </style>
</head>
