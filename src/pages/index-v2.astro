---
// V2 Homepage — Flyer palette: warm cream + forest green + antique gold + deep navy
import PageLayout from '../layouts/PageLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { homepageFaqSchema } from '../schema/faqPage';

const programs = [
  {
    title: 'Residential Rehab',
    description: '30, 60, or 90-day inpatient programs. Full-time support as you build the foundation for lasting recovery.',
    href: '/programs/residential',
    icon: '🏡',
    tag: 'Primary Program',
  },
  {
    title: 'Outpatient (IOP / PHP)',
    description: 'Intensive outpatient and partial hospitalization — structured treatment that fits around your life.',
    href: '/programs/outpatient',
    icon: '📅',
  },
  {
    title: 'Sober Living & Aftercare',
    description: 'Transitional housing and step-down support. Community, accountability, and a path forward.',
    href: '/programs/sober-living',
    icon: '🌱',
  },
];

const trustPillars = [
  {
    title: 'Faith-integrated, never required',
    description: 'Recovery rooted in hope and meaning. Spiritual support is available for those who want it — never pushed on those who don\'t.',
    icon: '☀️',
  },
  {
    title: 'Evidence-based therapies',
    description: 'CBT, motivational interviewing, trauma-informed care, and family systems therapy — proven approaches that work.',
    icon: '🌿',
  },
  {
    title: 'Medi-Cal accepted',
    description: 'Recovery should be reachable for everyone. We accept Medi-Cal, Medicare, and private insurance. Sliding scale available.',
    icon: '🤝',
  },
];

const admissionSteps = [
  { step: '01', title: 'Call Us', desc: 'One private conversation. No commitment. We\'ll listen and answer every question.' },
  { step: '02', title: 'Assessment', desc: 'A brief clinical assessment helps us understand what level of care fits you best.' },
  { step: '03', title: 'Verify Insurance', desc: 'We\'ll verify your coverage fast and free — Medi-Cal, Medicare, or private insurance.' },
  { step: '04', title: 'Begin Recovery', desc: 'Most clients are admitted within 3–5 days of their first call. Your journey starts here.' },
];

const donationNeeds = [
  { category: 'Furnish a Room', items: ['Mattresses & bed frames', 'Bedding & pillows', 'Washable fabric chairs', 'Dressers & storage', 'Lamps & curtains'], icon: '🛏️' },
  { category: 'Kitchen & Appliances', items: ['Kitchen equipment & cookware', 'Refrigerator & microwave', 'Dishes, cups & utensils', 'Pantry staples', 'Appliances of any kind'], icon: '🍳' },
  { category: 'Volunteer Your Skills', items: ['Teach cooking or nutrition', 'Lead knitting or crafts', 'Garden & grow food together', 'Financial literacy coaching', 'Job readiness help'], icon: '🙌' },
  { category: 'Farm & Garden', items: ['Chickens & chicken coops', 'Coop building supplies', 'Help training with animals', 'Seeds, soil & garden tools', 'Raised garden bed materials'], icon: '🐓' },
  { category: 'Churches: Adopt a Room', items: ['Sponsor a complete bedroom', 'Furnish a shared living space', 'Ongoing prayer partnership', 'Volunteer as a congregation', 'Monthly supply donations'], icon: '⛪', featured: true },
  { category: 'Cash & Gift Cards', items: ['Cash donations (any amount)', 'Walmart gift cards', 'Amazon wish list items', 'Restaurant gift cards', 'Gas cards for family visits'], icon: '💛' },
];

const homepageFAQs = [
  { question: 'Does Sunbright Recovery accept Medi-Cal?', answer: 'Yes. Medi-Cal is accepted and is a priority for us. Many people don\'t realize Medi-Cal covers substance use disorder treatment — including residential rehab. We\'ll verify your coverage at no cost to you.' },
  { question: 'How quickly can I get admitted?', answer: 'Most clients are admitted within 3–5 days of their first call. We\'ll work with your insurance, do the assessment, and get you into treatment as quickly as possible.' },
  { question: 'Is Sunbright a Christian rehab?', answer: 'Sunbright is faith-integrated, not faith-required. Spiritual support and faith-based programming are available for those who want it — but recovery here does not require any particular religious belief.' },
  { question: 'Where is Sunbright Recovery located?', answer: 'Sunbright Recovery Center is located at 22425 Sunbright Ave in Red Bluff, California — serving all of Northern California.' },
  { question: 'What is the difference between residential and outpatient?', answer: 'Residential means you live at the facility during your 30–90 day program with 24/7 support. Outpatient means structured daytime programming while you return home each day. We\'ll help you figure out the right fit.' },
];
---

<PageLayout
  title="Sunbright Recovery Center | Faith-Based Rehab California"
  description="Faith-integrated, evidence-based addiction recovery in Northern California. Residential, outpatient & sober living. Medi-Cal accepted. Call 530-528-2342."
  schema={homepageFaqSchema(homepageFAQs)}
>

  <!-- Hero — cream background, forest green headline, antique gold accent -->
  <section class="relative overflow-hidden bg-burlap-200 py-20 lg:py-28">
    <!-- Decorative leaves -->
    <div class="absolute top-0 right-0 w-64 h-64 opacity-10 pointer-events-none" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M180 10 C160 40 140 30 120 60 C100 90 110 120 90 140 C70 160 40 150 20 180" stroke="#3a5220" stroke-width="3" fill="none"/>
        <ellipse cx="150" cy="30" rx="20" ry="10" fill="#5A7A35" opacity="0.6" transform="rotate(-30 150 30)"/>
        <ellipse cx="170" cy="60" rx="18" ry="9" fill="#5A7A35" opacity="0.5" transform="rotate(-15 170 60)"/>
        <ellipse cx="140" cy="80" rx="22" ry="11" fill="#3a5220" opacity="0.4" transform="rotate(10 140 80)"/>
      </svg>
    </div>
    <div class="absolute bottom-0 left-0 w-48 h-48 opacity-10 pointer-events-none" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="40" cy="160" rx="20" ry="10" fill="#5A7A35" opacity="0.6" transform="rotate(20 40 160)"/>
        <ellipse cx="20" cy="130" rx="18" ry="9" fill="#3a5220" opacity="0.5" transform="rotate(-10 20 130)"/>
        <ellipse cx="60" cy="140" rx="22" ry="11" fill="#5A7A35" opacity="0.4" transform="rotate(40 60 140)"/>
      </svg>
    </div>

    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-antique-500 text-sm font-semibold mb-5">
          <span class="w-1 h-4 bg-antique-500 rounded-full"></span>
          Founded by Linda Spyres, LCSW, LAADC-CA · 20+ years specialized addiction expertise
        </div>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-forest-700 leading-tight mb-5">
          Recovery Starts Here
        </h1>
        <p class="text-lg sm:text-xl text-forest-800/70 leading-relaxed mb-8 max-w-2xl">
          Faith-integrated, evidence-based addiction recovery in Northern California. Built by people who've walked alongside recovery for 20+ years.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="tel:+15305282342" class="flex items-center justify-center gap-2 bg-forest-700 hover:bg-forest-800 text-white px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (530) 528-2342
          </a>
          <a href="/admissions" class="flex items-center justify-center gap-2 bg-antique-500 hover:bg-antique-600 text-white px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
            Verify Your Insurance
          </a>
        </div>
        <p class="mt-5 text-sm text-forest-700/60 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-antique-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Your call is completely private. We follow HIPAA confidentiality.
        </p>
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-forest-700 mb-3">Programs built for real recovery</h2>
        <p class="text-lg text-ink-500 leading-relaxed">From 30-day residential to step-down sober living — we meet you where you are.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {programs.map(p => (
          <a href={p.href} class="group flex flex-col bg-burlap-50 hover:bg-burlap-100 rounded-2xl border border-burlap-300 p-6 transition-all hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start justify-between mb-4">
              <span class="text-3xl">{p.icon}</span>
              {p.tag && <span class="text-xs font-semibold text-antique-600 bg-antique-50 px-2.5 py-1 rounded-full border border-antique-200">{p.tag}</span>}
            </div>
            <h3 class="font-serif text-lg font-bold text-forest-700 mb-2 group-hover:text-forest-600 transition-colors">{p.title}</h3>
            <p class="text-sm text-ink-500 leading-relaxed flex-1 mb-4">{p.description}</p>
            <span class="flex items-center gap-1.5 text-sm font-semibold text-antique-600 group-hover:gap-2.5 transition-all">
              Learn more
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust pillars — forest green band -->
  <section class="py-14 lg:py-20 bg-forest-700 text-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-white mb-3">Why families choose Sunbright</h2>
        <p class="text-forest-200 text-lg">We built what Northern California was missing.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {trustPillars.map(p => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-antique-500 mx-auto mb-5 flex items-center justify-center text-2xl shadow-lg">
              {p.icon}
            </div>
            <h3 class="font-serif text-xl font-bold text-white mb-2">{p.title}</h3>
            <p class="text-forest-200 text-sm leading-relaxed max-w-xs mx-auto">{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we treat — cream bg -->
  <section class="py-14 lg:py-20 bg-burlap-200">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-forest-700 mb-3">What we treat</h2>
        <p class="text-forest-700/60 text-lg">Addiction rarely comes alone. We treat the whole person.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { label: 'Alcohol Use Disorder', href: '/what-we-treat/alcohol', icon: '🍃' },
          { label: 'Opioid Addiction', href: '/what-we-treat/opioids', icon: '🌿' },
          { label: 'Dual Diagnosis', href: '/what-we-treat/dual-diagnosis', icon: '🌱' },
          { label: 'Trauma & Addiction', href: '/what-we-treat/trauma-addiction', icon: '☀️' },
        ].map(c => (
          <a href={c.href} class="group flex flex-col items-center text-center p-6 rounded-2xl bg-white border border-burlap-300 hover:border-antique-300 hover:bg-antique-50 transition-all">
            <span class="text-3xl mb-3">{c.icon}</span>
            <span class="font-semibold text-forest-700 text-sm group-hover:text-forest-600 transition-colors">{c.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet Linda — navy band -->
  <section class="py-14 lg:py-20 bg-navy-800 text-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-antique-400 text-sm font-semibold mb-5">
          <span class="w-1 h-4 bg-antique-500 rounded-full"></span>
          Meet Our Founder
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-white mb-5">
          20 years watching people heal. Sunbright is what Linda built when she realized Northern California needed more.
        </h2>
        <p class="text-navy-300 text-lg leading-relaxed mb-6">
          Linda Spyres, LCSW, LAADC-CA has spent over two decades in specialized addiction treatment. Sunbright Recovery Center is the program she wished had existed all along.
        </p>
        <a href="/team" class="inline-flex items-center gap-2 text-antique-400 hover:text-antique-300 font-semibold text-sm transition-colors">
          Meet the full team
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Admissions steps — white -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-forest-700 mb-3">How admissions works</h2>
        <p class="text-ink-500 text-lg">Simple. Private. No pressure.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {admissionSteps.map((s) => (
          <div>
            <div class="w-12 h-12 rounded-full bg-forest-700 text-white font-bold text-sm flex items-center justify-center mb-4 shadow-md">
              {s.step}
            </div>
            <h3 class="font-bold text-forest-700 mb-1">{s.title}</h3>
            <p class="text-sm text-ink-500 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/admissions" class="inline-flex items-center gap-2 bg-forest-700 hover:bg-forest-800 text-white px-7 py-3.5 rounded-xl font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
          Start Admissions
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Community Support / Donations — cream bg -->
  <section class="py-14 lg:py-20 bg-burlap-200 border-y border-burlap-300">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 bg-antique-100 text-antique-700 text-sm font-bold px-4 py-1.5 rounded-full mb-5 border border-antique-300">
          ♡ Community Support Needed
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-forest-700 mb-4">
          Help us build something beautiful for our community
        </h2>
        <p class="text-forest-700/70 text-lg leading-relaxed">
          Sunbright Recovery Center is preparing to open its 16-bed in-patient facility. We're equipping it room by room — and we need this community's help to make it feel like home.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {donationNeeds.map(d => (
          <div class={`bg-white rounded-2xl p-6 shadow-sm ${d.featured ? 'border-2 border-forest-400' : 'border border-burlap-300'}`}>
            <div class="flex items-start justify-between mb-4">
              <span class="text-3xl">{d.icon}</span>
              {d.featured && <span class="text-xs font-bold text-forest-700 bg-forest-50 px-2.5 py-1 rounded-full border border-forest-200">Featured</span>}
            </div>
            <h3 class="font-serif text-lg font-bold text-forest-700 mb-2">{d.category}</h3>
            <ul class="space-y-1.5">
              {d.items.map(item => (
                <li class="flex items-center gap-2 text-sm text-ink-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-antique-500 flex-shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Donation CTA — forest green -->
      <div class="bg-forest-700 rounded-2xl p-8 text-center">
        <h3 class="font-serif text-2xl font-bold text-white mb-3">Any way you can help matters.</h3>
        <p class="text-forest-200 text-base mb-6 max-w-xl mx-auto">
          Whether it's a mattress, a morning teaching cooking, or a $20 donation — every contribution brings someone closer to a life of recovery.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/donate" class="flex items-center justify-center gap-2 bg-antique-500 hover:bg-antique-400 text-white px-6 py-3.5 rounded-xl font-bold transition-all shadow-md hover:-translate-y-0.5">
            ♡ Donate or Get Involved
          </a>
          <a href="/contact" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/30 px-6 py-3.5 rounded-xl font-semibold transition-all hover:-translate-y-0.5">
            Contact Us to Volunteer
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote — burlap/cream -->
  <section class="py-14 lg:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-antique-500 text-4xl font-serif mb-4">"</p>
      <blockquote class="font-serif text-xl lg:text-2xl text-forest-700 leading-relaxed mb-6 italic">
        Recovery is real. Hope is real. Change is possible. Addiction does not define a person — recovery does.
      </blockquote>
      <cite class="not-italic text-sm text-ink-500 font-semibold">— Linda Spyres, LCSW, LAADC-CA, Founder</cite>
    </div>
  </section>

  <!-- FAQs — cream bg -->
  <FAQAccordion heading="Common questions about recovery" items={homepageFAQs} />

  <!-- Final CTA — antique gold band -->
  <section class="py-14 lg:py-16 bg-antique-500">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl lg:text-4xl font-bold text-white mb-3">You don't have to figure this out alone.</h2>
      <p class="text-antique-100 text-lg mb-8 max-w-xl mx-auto">Call Sunbright Recovery. One private conversation can change everything.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:+15305282342" class="flex items-center justify-center gap-2 bg-forest-700 hover:bg-forest-800 text-white px-7 py-3.5 rounded-xl font-bold transition-all shadow-md hover:-translate-y-0.5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call (530) 528-2342
        </a>
        <a href="/tour" class="flex items-center justify-center gap-2 bg-white/20 hover:bg-white/30 text-white border border-white/40 px-7 py-3.5 rounded-xl font-semibold transition-all hover:-translate-y-0.5">
          Schedule a Tour
        </a>
      </div>
      <p class="mt-5 text-sm text-antique-100 flex items-center justify-center gap-1.5">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        HIPAA confidential. No commitment required.
      </p>
    </div>
  </section>

</PageLayout>
