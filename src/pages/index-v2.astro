---
// V2 Homepage — Landscape palette: sandstone + stone + moss + terracotta + waterfall blue
import PageLayout from '../layouts/PageLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { homepageFaqSchema } from '../schema/faqPage';

const programs = [
  { title: 'Residential Rehab', description: '30, 60, or 90-day inpatient programs. Full-time support as you build the foundation for lasting recovery.', href: '/programs/residential', icon: '🏡', tag: 'Primary Program' },
  { title: 'Outpatient (IOP / PHP)', description: 'Intensive outpatient and partial hospitalization — structured treatment that fits around your life.', href: '/programs/outpatient', icon: '📅' },
  { title: 'Sober Living & Aftercare', description: 'Transitional housing and step-down support. Community, accountability, and a path forward.', href: '/programs/sober-living', icon: '🌿' },
];

const trustPillars = [
  { title: 'Faith-integrated, never required', description: 'Recovery rooted in hope and meaning. Spiritual support for those who want it — never pushed on those who don\'t.', icon: '☀️' },
  { title: 'Evidence-based therapies', description: 'CBT, motivational interviewing, trauma-informed care, and family systems therapy — proven approaches that work.', icon: '🌿' },
  { title: 'Medi-Cal accepted', description: 'Recovery should be reachable for everyone. We accept Medi-Cal, Medicare, and private insurance. Sliding scale available.', icon: '🤝' },
];

const admissionSteps = [
  { step: '01', title: 'Call Us', desc: 'One private conversation. No commitment. We\'ll listen and answer every question.' },
  { step: '02', title: 'Assessment', desc: 'A brief clinical assessment helps us understand what level of care fits you best.' },
  { step: '03', title: 'Verify Insurance', desc: 'We\'ll verify your Medi-Cal, Medicare, or private insurance — fast and free.' },
  { step: '04', title: 'Begin Recovery', desc: 'Most clients are admitted within 3–5 days of their first call. Your journey starts here.' },
];

const donationNeeds = [
  { category: 'Furnish a Room', items: ['Mattresses & bed frames', 'Bedding & pillows', 'Washable fabric chairs', 'Dressers & storage', 'Lamps & curtains'], icon: '🛏️' },
  { category: 'Kitchen & Appliances', items: ['Kitchen equipment & cookware', 'Refrigerator & microwave', 'Dishes, cups & utensils', 'Pantry staples', 'Appliances of any kind'], icon: '🍳' },
  { category: 'Volunteer Your Skills', items: ['Teach cooking or nutrition', 'Lead knitting or crafts', 'Garden & grow food together', 'Financial literacy coaching', 'Job readiness help'], icon: '🙌' },
  { category: 'Farm & Garden', items: ['Chickens & chicken coops', 'Coop building supplies', 'Help training with animals', 'Seeds, soil & garden tools', 'Raised garden bed materials'], icon: '🐓' },
  { category: 'Churches: Adopt a Room', items: ['Sponsor a complete bedroom', 'Furnish a shared living space', 'Ongoing prayer partnership', 'Volunteer as a congregation', 'Monthly supply donations'], icon: '⛪', featured: true },
  { category: 'Cash & Gift Cards', items: ['Cash donations (any amount)', 'Walmart gift cards', 'Amazon wish list items', 'Restaurant gift cards', 'Gas cards for family visits'], icon: '💛' },
];

const homepageFAQs = [
  { question: 'Does Sunbright Recovery accept Medi-Cal?', answer: 'Yes. Medi-Cal is accepted and is a priority for us. Many people don\'t realize Medi-Cal covers substance use disorder treatment — including residential rehab. We\'ll verify your coverage at no cost to you.' },
  { question: 'How quickly can I get admitted?', answer: 'Most clients are admitted within 3–5 days of their first call. We\'ll work with your insurance, do the assessment, and get you into treatment as quickly as possible.' },
  { question: 'Is Sunbright a Christian rehab?', answer: 'Sunbright is faith-integrated, not faith-required. Spiritual support and faith-based programming are available for those who want it — but recovery here does not require any particular religious belief.' },
  { question: 'Where is Sunbright Recovery located?', answer: 'Sunbright Recovery Center is located at 22425 Sunbright Ave in Red Bluff, California — serving all of Northern California.' },
  { question: 'What is the difference between residential and outpatient?', answer: 'Residential means you live at the facility during your 30–90 day program with 24/7 support. Outpatient means structured daytime programming while you return home each day. We\'ll help you figure out the right fit.' },
];
---

<PageLayout
  title="Sunbright Recovery Center | Faith-Based Rehab California"
  description="Faith-integrated, evidence-based addiction recovery in Northern California. Residential, outpatient & sober living. Medi-Cal accepted. Call 530-727-2211."
  schema={homepageFaqSchema(homepageFAQs)}
>

  <!-- ═══════════════════════════════════════════
       HERO — warm sandstone, landscape feel
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-sand-200 via-sand-100 to-white py-20 lg:py-28">

    <!-- Facility exterior as background -->
    <div class="absolute inset-0" aria-hidden="true">
      <img src="/images/facility-exterior.jpg" alt="" class="w-full h-full object-cover object-center opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-sand-200/95 via-sand-200/80 to-sand-100/50"></div>
    </div>
    <!-- Soft rock/mist overlays -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -bottom-8 right-32 w-56 h-56 rounded-full bg-sand-300 opacity-30 blur-xl"></div>
      <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
    </div>

    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-moss-700 text-sm font-semibold mb-5">
          <span class="w-6 h-px bg-moss-500"></span>
          <span>Founded by Linda Spyres, LCSW, LAADC-CA · 20+ years specialized addiction expertise</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-stone-900 leading-tight mb-5">
          Recovery Starts Here
        </h1>

        <p class="text-lg sm:text-xl text-stone-700 leading-relaxed mb-8 max-w-2xl">
          Faith-integrated, evidence-based addiction recovery in Northern California. Built by people who've walked alongside recovery for 20+ years.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="tel:+15307272211" class="flex items-center justify-center gap-2 bg-terra-600 hover:bg-terra-700 text-white px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md shadow-terra-900/20 hover:shadow-lg hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call (530) 727-2211
          </a>
          <a href="/admissions" class="flex items-center justify-center gap-2 bg-stone-800 hover:bg-stone-900 text-white px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
            Verify Your Insurance
          </a>
        </div>

        <p class="mt-5 text-sm text-stone-500 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-water-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Your call is completely private. We follow HIPAA confidentiality.
        </p>
      </div>
    </div>

    <!-- Rock ledge / waterfall edge divider -->
    <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none" aria-hidden="true">
      <svg viewBox="0 0 1440 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 56L60 44C120 32 240 8 360 4C480 0 600 16 720 22C840 28 960 24 1080 18C1200 12 1320 4 1380 2L1440 0V56H0Z" fill="white"/>
      </svg>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PROGRAMS — white, sandstone card borders
  ═══════════════════════════════════════════ -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-stone-900 mb-3">Programs built for real recovery</h2>
        <p class="text-lg text-stone-500 leading-relaxed">From 30-day residential to step-down sober living — we meet you where you are.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {programs.map(p => (
          <a href={p.href} class="group flex flex-col bg-sand-50 hover:bg-sand-100 rounded-2xl border border-sand-300 hover:border-sand-400 p-6 transition-all hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-start justify-between mb-4">
              <span class="text-3xl">{p.icon}</span>
              {p.tag && <span class="text-xs font-semibold text-terra-600 bg-terra-50 px-2.5 py-1 rounded-full border border-terra-200">{p.tag}</span>}
            </div>
            <h3 class="font-serif text-lg font-bold text-stone-800 mb-2 group-hover:text-stone-900 transition-colors">{p.title}</h3>
            <p class="text-sm text-stone-500 leading-relaxed flex-1 mb-4">{p.description}</p>
            <span class="flex items-center gap-1.5 text-sm font-semibold text-terra-600 group-hover:gap-2.5 transition-all">
              Learn more
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       TRUST PILLARS — deep stone / rock wall
  ═══════════════════════════════════════════ -->
  <section class="relative py-14 lg:py-20 bg-stone-800 text-white overflow-hidden">
    <!-- Rock texture overlay -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 left-0 w-full h-full opacity-5" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 40px, rgba(255,255,255,0.03) 40px, rgba(255,255,255,0.03) 41px), repeating-linear-gradient(90deg, transparent, transparent 60px, rgba(255,255,255,0.02) 60px, rgba(255,255,255,0.02) 61px);"></div>
      <div class="absolute -top-20 -right-20 w-96 h-96 rounded-full bg-stone-700 opacity-40 blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-72 h-72 rounded-full bg-stone-900 opacity-60 blur-2xl"></div>
    </div>

    <!-- Waterfall top edge -->
    <div class="absolute top-0 left-0 right-0 overflow-hidden" aria-hidden="true">
      <svg viewBox="0 0 1440 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 0L60 8C120 16 240 32 360 36C480 40 600 32 720 28C840 24 960 28 1080 32C1200 36 1320 40 1380 40L1440 40V0H0Z" fill="white"/>
      </svg>
    </div>

    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-white mb-3">Why families choose Sunbright</h2>
        <p class="text-stone-300 text-lg">We built what Northern California was missing.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {trustPillars.map(p => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-terra-500 mx-auto mb-5 flex items-center justify-center text-2xl shadow-lg shadow-terra-900/30">
              {p.icon}
            </div>
            <h3 class="font-serif text-xl font-bold text-white mb-2">{p.title}</h3>
            <p class="text-stone-300 text-sm leading-relaxed max-w-xs mx-auto">{p.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Waterfall bottom edge — water flowing down -->
    <div class="absolute bottom-0 left-0 right-0 overflow-hidden" aria-hidden="true">
      <svg viewBox="0 0 1440 56" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 56L80 40C160 24 320 0 480 0C640 0 720 24 880 32C1040 40 1200 32 1320 28L1440 24V56H0Z" fill="#f5f3f1"/>
      </svg>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       WHAT WE TREAT — light stone/sand bg
  ═══════════════════════════════════════════ -->
  <section class="py-14 lg:py-20 bg-stone-50">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-stone-900 mb-3">What we treat</h2>
        <p class="text-stone-500 text-lg">Addiction rarely comes alone. We treat the whole person.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { label: 'Alcohol Use Disorder', href: '/what-we-treat/alcohol', icon: '🍃' },
          { label: 'Opioid Addiction', href: '/what-we-treat/opioids', icon: '🌿' },
          { label: 'Dual Diagnosis', href: '/what-we-treat/dual-diagnosis', icon: '🌱' },
          { label: 'Trauma & Addiction', href: '/what-we-treat/trauma-addiction', icon: '☀️' },
        ].map(c => (
          <a href={c.href} class="group flex flex-col items-center text-center p-6 rounded-2xl bg-white border border-stone-200 hover:border-terra-300 hover:bg-terra-50 transition-all hover:shadow-sm">
            <span class="text-3xl mb-3">{c.icon}</span>
            <span class="font-semibold text-stone-800 text-sm group-hover:text-terra-700 transition-colors">{c.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       WATERFALL BREAK — water color band
  ═══════════════════════════════════════════ -->
  <div class="relative h-10 bg-stone-50 overflow-hidden" aria-hidden="true">
    <svg viewBox="0 0 1440 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="absolute bottom-0 w-full" preserveAspectRatio="none">
      <path d="M0 40C200 20 400 0 720 0C1040 0 1240 20 1440 40H0Z" fill="#1f3f4e"/>
    </svg>
  </div>


  <!-- ═══════════════════════════════════════════
       MEET LINDA — deep water / pool color
  ═══════════════════════════════════════════ -->
  <section class="relative py-14 lg:py-20 bg-water-800 text-white overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 right-0 w-96 h-96 bg-water-700 opacity-30 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-water-900 opacity-50 rounded-full blur-2xl -translate-x-1/4 translate-y-1/4"></div>
    </div>
    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 text-water-300 text-sm font-semibold mb-5">
          <svg class="w-4 h-4 text-terra-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Meet Our Founder
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-white mb-5">
          20 years watching people heal. Sunbright is what Linda built when she realized Northern California needed more.
        </h2>
        <p class="text-water-200 text-lg leading-relaxed mb-6">
          Linda Spyres, LCSW, LAADC-CA has spent over two decades in specialized addiction treatment. Sunbright Recovery Center is the program she wished had existed all along.
        </p>
        <a href="/team" class="inline-flex items-center gap-2 text-terra-400 hover:text-terra-300 font-semibold text-sm transition-colors">
          Meet the full team
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>

    <!-- River edge out -->
    <div class="absolute bottom-0 left-0 right-0 overflow-hidden" aria-hidden="true">
      <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" preserveAspectRatio="none">
        <path d="M0 48L120 36C240 24 480 0 720 0C960 0 1200 24 1320 36L1440 48V48H0Z" fill="white"/>
      </svg>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       ADMISSIONS STEPS — white, terra accent
  ═══════════════════════════════════════════ -->
  <section class="py-14 lg:py-20 bg-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-stone-900 mb-3">How admissions works</h2>
        <p class="text-stone-500 text-lg">Simple. Private. No pressure.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {admissionSteps.map((s, i) => (
          <div class="relative">
            <div class="w-12 h-12 rounded-full bg-terra-600 text-white font-bold text-sm flex items-center justify-center mb-4 shadow-md shadow-terra-900/20">
              {s.step}
            </div>
            <h3 class="font-bold text-stone-800 mb-1">{s.title}</h3>
            <p class="text-sm text-stone-500 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/admissions" class="inline-flex items-center gap-2 bg-stone-800 hover:bg-stone-900 text-white px-7 py-3.5 rounded-xl font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
          Start Admissions
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       COMMUNITY DONATIONS — sandstone bg
  ═══════════════════════════════════════════ -->
  <section class="relative py-14 lg:py-20 bg-sand-200 overflow-hidden">
    <!-- Sandy texture blobs -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-sand-300 opacity-50 blur-3xl"></div>
      <div class="absolute -bottom-10 -left-10 w-60 h-60 rounded-full bg-sand-300 opacity-40 blur-2xl"></div>
    </div>

    <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 bg-terra-100 text-terra-700 text-sm font-bold px-4 py-1.5 rounded-full mb-5 border border-terra-200">
          ♡ Community Support Needed
        </div>
        <h2 class="font-serif text-3xl lg:text-4xl font-bold text-stone-900 mb-4">
          Help us build something beautiful for our community
        </h2>
        <p class="text-stone-600 text-lg leading-relaxed">
          Sunbright Recovery Center is preparing to open its doors. We're equipping the facility room by room — and we need this community's help to make it feel like home.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {donationNeeds.map(d => (
          <div class={`bg-white rounded-2xl p-6 shadow-sm ${d.featured ? 'border-2 border-stone-600' : 'border border-sand-300'}`}>
            <div class="flex items-start justify-between mb-4">
              <span class="text-3xl">{d.icon}</span>
              {d.featured && <span class="text-xs font-bold text-stone-700 bg-stone-100 px-2.5 py-1 rounded-full border border-stone-300">Featured</span>}
            </div>
            <h3 class="font-serif text-lg font-bold text-stone-800 mb-2">{d.category}</h3>
            <ul class="space-y-1.5">
              {d.items.map(item => (
                <li class="flex items-center gap-2 text-sm text-stone-600">
                  <span class="w-1.5 h-1.5 rounded-full bg-terra-500 flex-shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Facility photos -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-12">
        <img src="/images/facility-exterior.jpg" alt="Sunbright Recovery Center exterior — Red Bluff, CA" class="rounded-xl object-cover w-full h-40 lg:h-48" />
        <img src="/images/facility-common-room.jpg" alt="Common room under renovation" class="rounded-xl object-cover w-full h-40 lg:h-48" />
        <img src="/images/facility-interior.jpg" alt="Interior space being prepared" class="rounded-xl object-cover w-full h-40 lg:h-48" />
        <img src="/images/facility-tile.jpg" alt="New tile flooring being installed" class="rounded-xl object-cover w-full h-40 lg:h-48" />
      </div>

      <!-- CTA block — deep stone -->
      <div class="bg-stone-800 rounded-2xl p-8 text-center">
        <h3 class="font-serif text-2xl font-bold text-white mb-3">Any way you can help matters.</h3>
        <p class="text-stone-300 text-base mb-6 max-w-xl mx-auto">
          Whether it's a mattress, a morning teaching cooking, or a $20 donation — every contribution brings someone closer to a life of recovery.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/donate" class="flex items-center justify-center gap-2 bg-terra-500 hover:bg-terra-600 text-white px-6 py-3.5 rounded-xl font-bold transition-all shadow-md hover:-translate-y-0.5">
            ♡ Donate or Get Involved
          </a>
          <a href="/contact" class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/25 px-6 py-3.5 rounded-xl font-semibold transition-all hover:-translate-y-0.5">
            Contact Us to Volunteer
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       QUOTE — mossy stone
  ═══════════════════════════════════════════ -->
  <section class="relative py-14 lg:py-16 bg-moss-700 text-white overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.4) 1px, transparent 0); background-size: 28px 28px;"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-12 h-1 bg-terra-400 mx-auto mb-6 rounded-full"></div>
      <blockquote class="font-serif text-xl lg:text-2xl text-white leading-relaxed mb-6 italic">
        "People recover every day. We've watched it happen for 20 years. Sunbright exists because healing needs a safe place to start — and Northern California deserves one."
      </blockquote>
      <cite class="not-italic text-sm text-moss-200 font-semibold">— Linda Spyres, LCSW, LAADC-CA, Founder</cite>
    </div>
