---
// Community / Pre-Launch Fundraising Page
// PURPOSE: Public-facing while awaiting DHCS licensing.
// LEGAL: No clinical service claims. No admissions process. No 501(c)(3) tax-deductibility
//        claim (determination pending). Future tense only for services.
// TODO: Remove `noindex` when real domain is connected and Linda is ready to go live.
// TODO: Replace [VENMO_LINK], [CASHAPP_LINK], [SQUARE_LINK] with real payment URLs.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Sunbright Recovery — Coming to Red Bluff, CA</title>
  <meta name="description" content="Sunbright Recovery is preparing to open a 16-bed nonprofit addiction recovery center in Red Bluff, CA. Help us open our doors — donate, volunteer, or adopt a space."/>
  <meta name="robots" content="noindex"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --navy:#1a2e5a; --navy-dk:#101d3a; --navy-mid:#254080; --navy-lt:#edf1fa;
      --gold:#c8900a; --gold-lt:#f0c040; --gold-pale:#fdf5e0; --gold-bg:#fef9ee;
      --cream:#ede4d0; --cream-dk:#ddd2b8; --white:#fff;
      --text:#1a2438; --mid:#3d4a5c; --soft:#6b7a8d; --border:#e2d9c8;
    }
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.6}
    h1,h2,h3,h4{font-family:'Lora',Georgia,serif;line-height:1.2}
    .script{font-family:'Dancing Script',cursive}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    .wrap{max-width:1160px;margin:0 auto;padding:0 28px}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 28px;border-radius:8px;font-size:14.5px;font-weight:700;font-family:'Inter',sans-serif;transition:all .2s;cursor:pointer;border:none;text-decoration:none}
    .btn:hover{transform:translateY(-2px)}
    .btn-gold{background:var(--gold);color:#fff}
    .btn-gold:hover{background:#a87008}
    .btn-navy{background:var(--navy);color:#fff;box-shadow:0 4px 14px rgba(26,46,90,.35)}
    .btn-navy:hover{background:var(--navy-dk)}
    .btn-ghost{background:rgba(255,255,255,.14);color:#fff;border:2px solid rgba(255,255,255,.45)}
    .btn-ghost:hover{background:rgba(255,255,255,.25)}
    .btn-outline{background:transparent;color:var(--navy);border:2px solid var(--navy)}
    .btn-outline:hover{background:var(--navy-lt)}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;background:transparent;backdrop-filter:none;border-bottom:1px solid transparent;box-shadow:none;transition:background .3s,backdrop-filter .3s,border-color .3s,box-shadow .3s}
    nav.nav-scrolled{background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(26,46,90,.08)}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;height:110px;overflow:hidden}
    .nav-in img{height:108px;width:auto;flex-shrink:0;filter:brightness(0) invert(1);opacity:.95;transition:filter .3s,opacity .3s}
    nav.nav-scrolled .nav-in img{filter:none;opacity:1}
    .nav-links{display:flex;align-items:center;gap:2px}
    .nav-links a{padding:8px 12px;border-radius:6px;font-size:14.5px;font-weight:600;color:rgba(255,255,255,.9);transition:all .2s;letter-spacing:-.005em}
    .nav-links a:hover{color:var(--gold-lt);background:rgba(255,255,255,.1)}
    nav.nav-scrolled .nav-links a{color:var(--navy)}
    nav.nav-scrolled .nav-links a:hover{color:var(--gold-dk);background:var(--navy-lt)}
    .nav-cta{display:flex;align-items:center;gap:7px;background:#fff;color:var(--navy);padding:11px 20px;border-radius:8px;font-size:14px;font-weight:700;border:none;box-shadow:none;transition:all .25s}
    .nav-cta:hover{background:var(--cream);color:var(--navy-dk);transform:translateY(-1px)}
    nav.nav-scrolled .nav-cta{background:var(--gold);color:#fff;box-shadow:0 2px 12px rgba(200,144,10,.35)}
    nav.nav-scrolled .nav-cta:hover{background:#a87008}

    /* HERO */
    .hero{position:relative;overflow:hidden;background:#0d1e3a}
    .hero-bg{position:absolute;inset:0;background:linear-gradient(180deg,#0d1e3a 0%,#152960 50%,#2a4a90 100%)}
    .hero-stars{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.55) 1px,transparent 1px),radial-gradient(circle,rgba(255,255,255,.3) 1px,transparent 1px),radial-gradient(circle,rgba(255,255,255,.4) 1px,transparent 1px);background-size:160px 160px,110px 110px,220px 220px;background-position:30px 25px,70px 90px,150px 50px;opacity:.35;pointer-events:none}
    .hero-inner{position:relative;z-index:2;max-width:1160px;margin:0 auto;padding:140px 28px 60px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
    .hero-tagline-top{font-family:'Dancing Script',cursive;font-size:30px;color:var(--gold-lt);display:block;margin-bottom:6px}
    .hero h1{font-size:clamp(38px,5.5vw,64px);font-weight:700;color:#fff;letter-spacing:-.02em;margin-bottom:10px;line-height:1.06;text-shadow:0 2px 20px rgba(0,0,0,.4)}
    .hero h1 em{font-style:italic;color:var(--gold-lt)}
    .hero-type{font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:14px;display:flex;align-items:center;gap:8px}
    .hero-type::before{content:'';width:24px;height:2px;background:var(--gold-lt);border-radius:2px;display:block}
    .hero-sub{font-size:16.5px;color:rgba(255,255,255,.68);line-height:1.75;margin-bottom:28px;max-width:460px}
    .hero-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}
    .hero-opening{display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(255,255,255,.45);font-style:italic}
    .hero-right{position:relative;min-height:480px;display:flex;align-items:flex-end;justify-content:center;overflow:visible}
    .hero-sun-only{position:relative;width:200%;margin-left:-50%;margin-right:-50%;height:418px;overflow:hidden;pointer-events:none;display:flex;align-items:flex-start;justify-content:center}
    .hero-sun-only img{width:100%;max-width:none;display:block;margin:0 auto;transform:scale(1.15) translateX(82px);transform-origin:top center}

    /* BAND */
    .band{background:var(--navy);padding:56px 28px;text-align:center;position:relative;overflow:hidden}
    .band-inner{position:relative;max-width:1160px;margin:0 auto}
    .band-label{font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:28px;display:flex;align-items:center;justify-content:center;gap:14px}
    .band-label::before,.band-label::after{content:'';height:1px;width:40px;background:var(--gold-lt);opacity:.5}
    .band-badges{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-bottom:28px}
    .band-badge-card{background:linear-gradient(180deg,rgba(255,255,255,.08) 0%,rgba(255,255,255,.03) 100%);border:1px solid rgba(240,192,64,.2);border-radius:16px;padding:28px 26px 24px;text-align:center;transition:all .3s;position:relative;overflow:hidden}
    .band-badge-card::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:50%;height:2px;background:linear-gradient(90deg,transparent,var(--gold-lt),transparent);opacity:.5;transition:width .3s,opacity .3s}
    .band-badge-card:hover{background:linear-gradient(180deg,rgba(240,192,64,.12) 0%,rgba(240,192,64,.04) 100%);border-color:var(--gold-lt);transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.25)}
    .band-badge-card:hover::before{width:80%;opacity:1}
    .band-badge-icon{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--gold) 0%,var(--gold-lt) 100%);margin:0 auto 14px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(240,192,64,.35),inset 0 1px 0 rgba(255,255,255,.3);transition:transform .3s}
    .band-badge-card:hover .band-badge-icon{transform:scale(1.08) rotate(-3deg)}
    .band-badge-icon svg{width:24px;height:24px;color:var(--navy-dk)}
    .band-badge-card strong{display:block;font-family:'Lora',serif;font-size:clamp(15px,1.8vw,19px);font-weight:700;color:#fff;margin-bottom:5px;letter-spacing:-.005em;line-height:1.25}
    .band-badge-card span{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-lt);opacity:.85}
    .band-sub{font-size:18px;color:rgba(255,255,255,.55);margin-bottom:0;font-family:'Dancing Script',cursive}

    /* ABOUT */
    .about{padding:72px 0;background:var(--white)}
    .about-grid{display:grid;grid-template-columns:0.85fr 1.15fr;column-gap:56px;row-gap:0;align-items:stretch}
    .about-text-main{grid-column:1;grid-row:1;align-self:start}
    .about-visual{grid-column:2;grid-row:1 / 3;align-self:stretch}
    .about-stats-row{grid-column:1;grid-row:2;align-self:start}
    .about-text-main .eyebrow{font-size:11.5px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:block}
    .about-text-main h2{font-family:'Lora',serif;font-size:clamp(28px,3.6vw,42px);color:var(--navy);margin-bottom:18px;line-height:1.15;letter-spacing:-.01em}
    .about-text-main p{font-size:16px;color:var(--mid);line-height:1.8;margin-bottom:14px}
    .about-text-main p:last-of-type{margin-bottom:0}
    .about-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px;padding-top:24px;border-top:1px solid var(--border)}
    .about-stat strong{display:block;font-family:'Lora',serif;font-size:30px;color:var(--gold);font-weight:700;line-height:1;margin-bottom:4px}
    .about-stat span{font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--soft)}
    .about-visual{position:relative;border-radius:18px;overflow:hidden;box-shadow:0 20px 50px rgba(26,46,90,.18);height:100%;display:flex;flex-direction:column}
    .aq-top{flex:1;background:linear-gradient(160deg,var(--navy-mid) 0%,var(--navy) 100%);padding:48px 38px;display:flex;flex-direction:column;justify-content:center;position:relative}
    .aq-top::before{content:'';position:absolute;top:-60px;right:-60px;width:280px;height:280px;background:radial-gradient(ellipse,rgba(200,144,10,.1),transparent 65%);pointer-events:none}
    .aq-mark{font-family:'Dancing Script',cursive;font-size:88px;color:var(--gold-lt);line-height:.55;display:block;margin:0 auto 12px;text-align:center;position:relative}
    .about-visual blockquote{font-family:'Lora',serif;font-size:clamp(18px,1.8vw,21px);font-style:italic;color:#fff;line-height:1.65;margin-bottom:18px;position:relative;z-index:1;text-align:center}
    .about-visual cite{font-style:normal;font-size:11.5px;font-weight:700;color:rgba(255,255,255,.55);letter-spacing:.08em;text-transform:uppercase;position:relative;z-index:1;display:block;text-align:center}
    .aq-heal{background:linear-gradient(160deg,#3a78c4 0%,#2a5aa0 100%);padding:26px 38px;text-align:center;position:relative}
    .aq-heal p{font-family:'Dancing Script',cursive;font-size:23px;color:#fff;line-height:1.3;letter-spacing:.005em}

    /* NONPROFIT BAND */
    .nonprofit-band{padding:72px 0;background:var(--navy);position:relative;overflow:hidden}
    .nonprofit-band::before{content:'';position:absolute;top:-60px;right:-60px;width:400px;height:400px;background:radial-gradient(ellipse,rgba(200,144,10,.08),transparent 65%)}
    .np-head{text-align:center;margin-bottom:48px;position:relative}
    .np-eyebrow{font-size:11.5px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:8px;display:block}
    .np-head h2{font-family:'Lora',serif;font-size:clamp(28px,3.5vw,40px);color:#fff;margin-bottom:10px;letter-spacing:-.01em}
    .np-head p{font-size:15.5px;color:rgba(255,255,255,.5);max-width:560px;margin:0 auto;line-height:1.7}
    .nonprofit-grid{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:48px}
    .np-card{display:flex;flex-direction:column;align-items:flex-start;gap:16px}
    .np-icon{width:52px;height:52px;border-radius:12px;background:rgba(240,192,64,.12);border:1px solid rgba(240,192,64,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .np-icon svg{width:26px;height:26px;color:var(--gold-lt)}
    .np-card-body{display:flex;flex-direction:column}
    .np-card h3{font-family:'Lora',serif;font-size:18px;font-weight:600;color:#fff;margin-bottom:8px;letter-spacing:-.005em;line-height:1.3}
    .np-card p{font-size:14px;color:rgba(255,255,255,.62);line-height:1.75}
    .np-note{position:relative;margin-top:40px;border-top:1px solid rgba(255,255,255,.1);padding-top:24px;text-align:center;font-size:13.5px;color:rgba(255,255,255,.38);line-height:1.65;max-width:680px;margin-left:auto;margin-right:auto}

    /* WHAT WE'LL OFFER */
    .offer{padding:72px 0;background:var(--gold-bg);position:relative}
    .offer::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:64px;height:3px;background:var(--gold-lt);border-radius:2px}
    .sec-head{text-align:center;margin-bottom:44px}
    .sec-script{font-family:'Dancing Script',cursive;font-size:28px;color:var(--gold);display:block;margin-bottom:2px}
    .sec-h2{font-size:clamp(26px,3.5vw,40px);color:var(--navy);margin-bottom:8px}
    .sec-sub{font-size:16px;color:var(--soft);max-width:540px;margin:0 auto}
    .offer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .offer-card{border:1.5px solid var(--border);border-radius:16px;padding:28px;background:var(--white);transition:all .25s;display:flex;flex-direction:column;position:relative;overflow:hidden}
    .offer-top-bar{position:absolute;top:0;left:0;right:0;height:3px;background:var(--gold);opacity:0;transition:opacity .25s}
    .offer-card:hover{border-color:var(--gold);box-shadow:0 12px 32px rgba(200,144,10,.12);transform:translateY(-3px)}
    .offer-card:hover .offer-top-bar{opacity:1}
    .offer-ico{width:46px;height:46px;border-radius:12px;background:var(--gold-pale);border:1.5px solid var(--cream-dk);display:flex;align-items:center;justify-content:center;margin-bottom:14px}
    .offer-tag{position:absolute;top:18px;right:18px;font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--navy);background:var(--navy-lt);padding:4px 10px;border-radius:100px}
    .offer-card h3{font-size:20px;color:var(--navy);margin-bottom:8px}
    .offer-card p{font-size:14px;color:var(--soft);line-height:1.7;flex:1}

    /* WHY SUNBRIGHT */
    .why{padding:80px 0;background:var(--cream)}
    .why-head{text-align:center;margin-bottom:56px}
    .why-divider{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:18px}
    .why-divider .line{width:80px;height:1.5px;background:var(--gold);border-radius:1px}
    .why-eyebrow{font-size:11.5px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;display:block}
    .why-head h2{font-family:'Lora',serif;font-size:clamp(32px,4.5vw,52px);color:var(--navy);margin-bottom:10px;font-weight:700;letter-spacing:-.01em}
    .why-head .sub{font-size:16px;color:var(--soft)}
    .why-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0;max-width:1100px;margin:0 auto;position:relative}
    .why-card{position:relative;padding:20px 36px 24px;text-align:left;border-left:1px solid rgba(200,144,10,.18)}
    .why-card:first-child{border-left:none;padding-left:8px}
    .why-card:last-child{padding-right:8px}
    .why-numeral{position:absolute;top:-20px;left:24px;font-family:'Lora',serif;font-size:120px;font-weight:700;color:var(--gold);opacity:.12;line-height:1;letter-spacing:-.04em;pointer-events:none;z-index:0;font-style:italic}
    .why-card:first-child .why-numeral{left:0}
    .why-card-content{position:relative;z-index:1}
    .why-icon{width:54px;height:54px;display:flex;align-items:center;justify-content:center;margin-bottom:22px;color:var(--gold-dk);background:linear-gradient(135deg,rgba(240,192,64,.18) 0%,rgba(240,192,64,.05) 100%);border-radius:14px;transition:transform .3s,background .3s}
    .why-card:hover .why-icon{transform:translateY(-3px);background:linear-gradient(135deg,rgba(240,192,64,.3) 0%,rgba(240,192,64,.1) 100%)}
    .why-icon svg{width:26px;height:26px}
    .why-card h3{font-family:'Lora',serif;font-size:22px;font-weight:700;color:var(--navy);margin-bottom:12px;letter-spacing:-.01em;line-height:1.2}
    .why-card p{font-size:14.5px;color:var(--mid);line-height:1.75}

    /* DONATIONS */
    .donations{padding:80px 0;background:var(--cream)}
    .don-intro{max-width:680px;margin:0 0 32px}
    .don-intro .eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:block}
    .don-intro h2{font-family:'Lora',serif;font-size:clamp(34px,4.5vw,52px);color:var(--navy);margin-bottom:18px;line-height:1.1;letter-spacing:-.01em}
    .don-intro p{font-size:16px;color:var(--mid);line-height:1.7;max-width:560px}
    .don-intro .np-pending{font-size:13px;color:var(--soft);display:flex;align-items:flex-start;gap:7px;margin-top:12px;font-style:italic;line-height:1.5}
    .don-intro .np-pending svg{color:var(--gold);flex-shrink:0;margin-top:2px}

    /* DONATE NOW methods */
    .donate-now{background:var(--navy);border-radius:20px;padding:44px 40px;margin-bottom:40px;position:relative;overflow:hidden}
    .donate-now::before{content:'';position:absolute;top:-40px;right:-40px;width:300px;height:300px;background:radial-gradient(ellipse,rgba(200,144,10,.12),transparent 65%);pointer-events:none}
    .donate-now-head{position:relative;margin-bottom:28px}
    .donate-now-head h3{font-family:'Lora',serif;font-size:clamp(22px,2.8vw,32px);color:#fff;margin-bottom:8px}
    .donate-now-head p{font-size:15px;color:rgba(255,255,255,.55);line-height:1.6;max-width:500px}
    .method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;position:relative;margin-bottom:18px}
    .method-card{background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.2);border-radius:14px;padding:22px 20px;display:flex;flex-direction:column;align-items:center;gap:10px;transition:all .25s;cursor:pointer;text-align:center}
    .method-card:hover{background:rgba(255,255,255,.14);border-color:var(--gold-lt);transform:translateY(-3px);box-shadow:0 10px 28px rgba(0,0,0,.2)}
    .method-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:4px}
    .method-icon.venmo-ico{background:#008CFF;color:#fff}
    .method-icon.cash-ico{background:#00D64F;color:#fff}
    .method-icon.square-ico{background:#fff;color:#1a1a1a}
    .method-icon svg{width:24px;height:24px}
    .method-name{font-size:15px;font-weight:700;color:#fff;line-height:1}
    .method-desc{font-size:12px;color:rgba(255,255,255,.5);line-height:1.3}
    .method-handle{font-size:11.5px;font-weight:700;color:var(--gold-lt);letter-spacing:.02em;line-height:1}
    .check-info{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;position:relative}
    .check-info svg{color:var(--gold-lt);flex-shrink:0}
    .check-info p{font-size:13px;color:rgba(255,255,255,.5);line-height:1.5}
    .check-info strong{color:rgba(255,255,255,.75)}

    .don-row-label{font-size:11px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin:24px 0 12px;display:flex;align-items:center;gap:10px}
    .don-row-label::before,.don-row-label::after{content:'';height:1px;background:var(--gold-lt);flex:1;opacity:.5}
    .don-row-label:first-of-type{margin-top:0}
    .don-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:18px}
    .don-card{background:var(--white);border:1px solid var(--border);border-radius:14px;padding:24px;transition:all .2s;position:relative}
    .don-card:hover{box-shadow:0 6px 20px rgba(26,46,90,.06);transform:translateY(-2px)}
    .don-card.feat{background:var(--gold-pale);border:1px solid var(--gold-lt)}
    .don-card.urgent{border-color:var(--gold);border-width:1.5px}
    .don-icon-box{width:38px;height:38px;border-radius:8px;background:var(--navy-lt);display:flex;align-items:center;justify-content:center;margin-bottom:18px}
    .don-card.feat .don-icon-box{background:var(--gold);color:#fff}
    .don-icon-box svg{width:20px;height:20px;color:var(--navy)}
    .don-card.feat .don-icon-box svg{color:#fff}
    .don-tag{position:absolute;top:22px;right:22px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:var(--gold);padding:4px 10px;border-radius:100px}
    .don-card h3{font-family:'Inter',sans-serif;font-size:17px;font-weight:700;color:var(--navy);margin-bottom:10px}
    .don-card p{font-size:14px;color:var(--mid);line-height:1.55;margin-bottom:0}
    .don-link{display:inline-flex;align-items:center;gap:6px;margin-top:16px;font-size:13.5px;font-weight:700;color:var(--gold);transition:gap .2s}
    .don-link:hover{gap:10px;color:#a87008}
    .don-link svg{width:14px;height:14px}
    .fac-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
    .fac-strip img{border-radius:10px;width:100%;height:160px;object-fit:cover;box-shadow:0 4px 16px rgba(0,0,0,.08);transition:transform .2s}
    .fac-strip img:hover{transform:scale(1.02)}
    .don-partners{background:var(--white);border:1.5px dashed var(--gold-lt);border-radius:14px;padding:22px 26px;display:flex;align-items:center;gap:20px;margin-top:8px;margin-bottom:24px}
    .don-partners-icon{width:48px;height:48px;border-radius:12px;background:var(--gold-pale);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .don-partners-icon svg{width:24px;height:24px;color:var(--gold)}
    .don-partners-body{flex:1}
    .don-partners h4{font-family:'Lora',serif;font-size:18px;font-weight:600;color:var(--navy);margin-bottom:4px}
    .don-partners p{font-size:13.5px;color:var(--mid);line-height:1.6;margin:0}
    .don-partners-cta{flex-shrink:0;background:var(--navy);color:#fff;padding:11px 20px;border-radius:8px;font-size:13px;font-weight:700;transition:all .2s}
    .don-partners-cta:hover{background:var(--navy-dk);transform:translateY(-1px)}

    /* FAQ */
    .faq-sec{padding:80px 0;background:linear-gradient(180deg,var(--cream) 0%,#f5ede0 100%)}
    .faq-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:64px;align-items:start}
    .faq-side .script-sub{font-family:'Dancing Script',cursive;font-size:30px;color:var(--gold);display:block;margin-bottom:4px;line-height:1.1}
    .faq-side h2{font-family:'Lora',serif;font-size:clamp(30px,3.8vw,44px);color:var(--navy);margin-bottom:18px;line-height:1.15;letter-spacing:-.01em}
    .faq-side p{font-size:15.5px;color:var(--mid);line-height:1.75;margin-bottom:24px}
    .faq-side-card{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:14px;box-shadow:0 4px 20px rgba(26,46,90,.06)}
    .faq-side-card .label{font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
    .faq-side-card .ask{font-family:'Lora',serif;font-size:18px;color:var(--navy);line-height:1.4;font-weight:600;margin-bottom:4px}
    .faq-side-card a{display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;padding:11px 18px;border-radius:8px;font-size:14px;font-weight:700;align-self:flex-start;transition:all .2s}
    .faq-side-card a:hover{background:var(--navy-dk);transform:translateY(-1px)}
    .faq-side-card a svg{width:14px;height:14px}
    .faq-list{display:flex;flex-direction:column;gap:10px}
    .faq-item{background:var(--white);border:1px solid #e8dfc8;border-radius:14px;overflow:hidden;transition:all .25s;box-shadow:0 2px 8px rgba(26,46,90,.03)}
    .faq-item:hover{border-color:var(--gold-lt)}
    .faq-item.open{background:#fffaf0;border-color:var(--gold-lt);box-shadow:0 6px 20px rgba(200,144,10,.08)}
    .faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;background:none;border:none;cursor:pointer;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;color:var(--navy);text-align:left;transition:background .15s}
    .faq-q:hover{background:rgba(240,192,64,.05)}
    .faq-q svg{width:18px;height:18px;color:var(--gold);flex-shrink:0;transition:transform .25s}
    .faq-item.open .faq-q svg{transform:rotate(180deg);color:#a87008}
    .faq-a{padding:0 22px 20px;font-size:14.5px;color:var(--mid);line-height:1.8;display:none}
    .faq-item.open .faq-a{display:block}

    /* FINAL CTA */
    .final{padding:72px 0;background:var(--gold-bg)}
    .final-inner{text-align:center}
    .final-script{font-family:'Dancing Script',cursive;font-size:54px;color:var(--gold);display:block;margin-bottom:2px}
    .final h2{font-size:clamp(28px,3.8vw,44px);color:var(--navy);margin-bottom:12px}
    .final p{font-size:17px;color:var(--soft);margin-bottom:30px;max-width:460px;margin-left:auto;margin-right:auto;line-height:1.6}
    .final-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:18px}
    .final-note{font-size:12.5px;color:var(--soft);text-align:center}

    /* FOOTER */
    footer{background:var(--navy-dk)}
    .f-crisis{background:var(--navy);padding:11px 28px;text-align:center;font-size:13px;color:rgba(255,255,255,.6)}
    .f-crisis a{color:var(--gold-lt);font-weight:700;transition:color .2s}
    .f-crisis a:hover{color:#fff}
    .f-main{padding:28px 28px 20px;max-width:1160px;margin:0 auto}
    .f-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:28px;align-items:start}
    .f-brand img{width:100%;max-width:280px;height:auto;margin-bottom:6px;margin-top:-8px;filter:brightness(0) invert(1);opacity:.92;display:block}
    .f-tagline{font-family:'Dancing Script',cursive;font-size:17px;color:rgba(255,255,255,.35);margin-bottom:8px;line-height:1.2}
    .f-brand-p{font-size:12.5px;color:rgba(255,255,255,.32);line-height:1.55;margin-bottom:10px}
    .f-contact{display:flex;flex-direction:column;gap:12px;margin-bottom:4px}
    .f-contact a{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:rgba(255,255,255,.45);transition:color .15s;line-height:1.5}
    .f-contact a svg{margin-top:2px;flex-shrink:0;color:var(--gold-lt)}
    .f-contact a:hover{color:rgba(255,255,255,.85)}
    .f-contact .phone{color:var(--gold-lt) !important;font-weight:700;font-size:14px}
    .f-col h4{font-family:'Lora',serif;font-size:12px;font-weight:600;color:#fff;margin-bottom:8px;padding-bottom:5px;position:relative}
    .f-col h4::after{content:'';position:absolute;bottom:0;left:0;width:18px;height:1.5px;background:var(--gold-lt);border-radius:1px}
    .f-col ul{list-style:none;display:flex;flex-direction:column;gap:5px}
    .f-col ul a{font-size:12.5px;color:rgba(255,255,255,.4);transition:color .15s;line-height:1.4}
    .f-col ul a:hover{color:var(--gold-lt)}
    .f-col .mt{margin-top:14px}
    .f-bot{max-width:1160px;margin:0 auto;border-top:1px solid rgba(255,255,255,.06);padding:12px 28px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.2)}
    .f-bot a{color:rgba(255,255,255,.28);transition:color .2s}
    .f-bot a:hover{color:var(--gold-lt)}
    .f-heal{font-family:'Dancing Script',cursive;font-size:15px;color:rgba(255,255,255,.25)}

    .sticky{position:fixed;bottom:20px;right:20px;z-index:200}
    .sticky a{display:flex;align-items:center;gap:8px;background:var(--gold);color:#fff;padding:12px 20px;border-radius:100px;font-size:14px;font-weight:700;box-shadow:0 8px 24px rgba(200,144,10,.5);transition:all .2s}
    .sticky a:hover{background:#a87008;transform:translateY(-2px)}
    svg.ph{width:15px;height:15px;flex-shrink:0}
  </style>
</head>
