---
// Thank You — Contact Form Confirmation
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Message Sent — Sunbright Recovery Center</title>
  <meta name="robots" content="noindex"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --navy:#1a2e5a; --navy-dk:#101d3a; --navy-mid:#254080; --navy-lt:#edf1fa;
      --gold:#c8900a; --gold-lt:#f0c040; --gold-pale:#fdf5e0;
      --cream:#ede4d0; --white:#fff;
      --text:#1a2438; --mid:#3d4a5c; --soft:#6b7a8d; --border:#e2d9c8;
    }
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
    h1,h2,h3{font-family:'Lora',Georgia,serif;line-height:1.2}
    a{text-decoration:none;color:inherit}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(26,46,90,.08)}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;height:110px;overflow:hidden;gap:0}
    .nav-in img{height:108px;width:auto;flex-shrink:0}
    .nav-links{display:flex;align-items:center;gap:4px;margin-left:20px}
    .nav-links a{padding:8px 16px;border-radius:8px;font-size:14px;font-weight:600;color:var(--navy);transition:all .2s;display:flex;align-items:center;gap:7px}
    .nav-links a svg{width:16px;height:16px;flex-shrink:0;opacity:.5}
    .nav-links a:hover{color:var(--gold);background:var(--navy-lt)}
    .nav-links a:hover svg{opacity:.9}
    .nav-links a:hover{color:var(--gold);background:var(--navy-lt)}
    .nav-cta{display:flex;align-items:center;gap:7px;background:var(--gold);color:#fff;padding:11px 20px;border-radius:8px;font-size:14px;font-weight:700;border:none;box-shadow:0 2px 12px rgba(200,144,10,.35);transition:all .25s}
    .nav-cta:hover{background:#a87008;transform:translateY(-1px)}

    /* MAIN */
    main{flex:1;display:flex;align-items:center;justify-content:center;padding:140px 28px 80px}
    .card{max-width:560px;width:100%;text-align:center}

    .check-wrap{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#e8f7ee,#d0f0e0);border:2px solid #4caf80;display:flex;align-items:center;justify-content:center;margin:0 auto 28px}
    .check-wrap svg{width:38px;height:38px;color:#2d9b5e}

    .script{font-family:'Dancing Script',cursive;font-size:20px;color:var(--gold);margin-bottom:10px;display:block}
    h1{font-size:clamp(28px,4vw,42px);color:var(--navy);letter-spacing:-.02em;margin-bottom:14px}
    .sub{font-size:16px;color:var(--mid);line-height:1.75;margin-bottom:36px;max-width:440px;margin-left:auto;margin-right:auto}

    .actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .btn-primary{display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;padding:13px 24px;border-radius:9px;font-size:14.5px;font-weight:700;transition:all .2s}
    .btn-primary:hover{background:var(--navy-dk);transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,46,90,.25)}
    .btn-ghost{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--navy);padding:13px 24px;border-radius:9px;font-size:14.5px;font-weight:600;border:1.5px solid var(--border);transition:all .2s}
    .btn-ghost:hover{border-color:var(--gold);color:var(--gold);transform:translateY(-2px)}

    .divider{height:1px;background:var(--border);margin:40px 0}
    .contact-line{font-size:13.5px;color:var(--soft);line-height:1.7}
    .contact-line a{color:var(--gold);font-weight:600}
    .contact-line a:hover{text-decoration:underline}

    /* FOOTER */
    footer{background:var(--navy-dk);padding:16px 28px;text-align:center}
    .f-bot{font-size:12px;color:rgba(255,255,255,.2)}
    .f-bot a{color:rgba(255,255,255,.28);transition:color .2s}
    .f-bot a:hover{color:var(--gold-lt)}
  </style>
</head>
<body>

<nav>
  <div class="nav-in">
    <a href="/community"><img src="/logo.png" alt="Sunbright Recovery Center"/></a>
    <div class="nav-links">
      <a href="/community#what-we-build"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>About</a>
      <a href="/events"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>Events</a>
      <a href="/get-involved"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>Get Involved</a>
      <a href="/contact"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>Contact</a>
    </div>
    <a href="/get-involved" class="nav-cta">
      <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      Donate Now
    </a>
  </div>
</nav>

<main>
  <div class="card">
    <div class="check-wrap">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <span class="script">Thank you</span>
    <h1>Your message is on its way.</h1>
    <p class="sub">Someone from the Sunbright team will read your message personally and get back to you as soon as possible. We appreciate you reaching out.</p>

    <div class="actions">
      <a href="/community" class="btn-primary">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Back to Home
      </a>
      <a href="/community#donate" class="btn-ghost">
        View Ways to Give
      </a>
    </div>

    <div class="divider"></div>
    <p class="contact-line">Need to reach us sooner? Call <a href="tel:+15307272211">(530) 727-2211</a> or email <a href="mailto:info@sunbrightrecovery.org">info@sunbrightrecovery.org</a> directly.</p>
    <p class="contact-line" style="margin-top:6px;font-size:12px;font-style:italic;opacity:.6">Calls are answered by our partner team while the center prepares to open.</p>
  </div>
</main>

<footer>
  <div class="f-bot">&copy; 2026 <a href="/community">Sunbright Recovery Center</a> Â· Site by <a href="https://phoenixmethodseo.com">Phoenix Method SEO</a></div>
</footer>

</body>
</html>

