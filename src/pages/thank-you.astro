      <a href="/get-involved" class="btn-ghost">
        View Ways to Give
      </a>
    </div>

    <div class="divider"></div>
    <p class="contact-line">Need to reach us sooner? Call <a href="tel:+15305134294">(530) 513-4294</a> or email <a href="mailto:info@sunbrightrecovery.org">info@sunbrightrecovery.org</a> directly.</p>
  </div>
</main>

