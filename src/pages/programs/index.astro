---
import SiteLayout from '../../layouts/SiteLayout.astro';

const meta = {
  title: 'Addiction Recovery Programs | Sunbright Recovery California',
  description:
    'Residential rehab, intensive outpatient (IOP/PHP), and sober living programs in Northern California. Personalized recovery paths at a nonprofit recovery center.',
  primaryKeyword: 'addiction recovery programs california',
};

const breadcrumbs = [
  { name: 'Home', url: '/design-preview' },
  { name: 'Programs', url: '/programs' },
];
---

<SiteLayout {...meta} breadcrumbs={breadcrumbs} activeNav="programs">
  <header class="page-header">
    <div class="wrap ph-inner">
      <span class="eyebrow">Programs &amp; Levels of Care</span>
      <h1>Addiction recovery programs built around <em>where you are.</em></h1>
      <p class="lead">Sunbright Recovery Center offers a complete continuum of care — from residential rehab to outpatient treatment and sober living — so you can step through recovery at the right pace, with consistent support every step of the way in Northern California.</p>
      <div class="btn-row">
        <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
        <a href="/admissions" class="btn btn-ghost">How Admissions Works</a>
      </div>
    </div>
  </header>

  <section class="section section--white">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Three Paths, One Continuum</span>
        <h2>Find the level of care that fits <em>your life.</em></h2>
        <p class="lead">Recovery isn't a single moment — it's a process. Our programs are designed to meet you where you are and move with you as you grow stronger.</p>
      </div>
      <div class="grid grid-3">
        <div class="card featured">
          <span class="card-tag">Residential</span>
          <h3>Inpatient Residential Rehab</h3>
          <p>30, 60, and 90-day programs in a 16-bed co-ed center in Red Bluff, CA. 24/7 clinical support, structured daily schedule, and a calm environment designed for deep healing work.</p>
          <a href="/programs/residential" class="card-link">
            Learn more
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="card">
          <span class="card-tag">Outpatient</span>
          <h3>IOP &amp; PHP</h3>
          <p>Intensive outpatient (IOP) and partial hospitalization (PHP) — structured treatment that fits around work, family, and life. Ideal as a step-down from residential or as standalone care.</p>
          <a href="/programs/outpatient" class="card-link">
            Learn more
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="card">
          <span class="card-tag">Aftercare</span>
          <h3>Sober Living &amp; Aftercare</h3>
          <p>Transitional housing and ongoing support for the long road of recovery. A real community, structured accountability, and continued therapy as you re-establish life on your terms.</p>
          <a href="/programs/sober-living" class="card-link">
            Learn more
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap split">
      <div class="prose wide">
        <h2>Why a continuum of care matters</h2>
        <p>Most people who achieve lasting recovery don't do it in a single stint of treatment. Research consistently shows that longer engagement with structured support — moving from a more intensive setting to a less intensive one at the right pace — produces better long-term outcomes.</p>
        <p>At Sunbright, we've built our programs to work together. A person might enter residential rehab for 60 days, step down to our IOP program two or three days a week, and then transition into sober living while rebuilding daily life. Each transition is planned, not abrupt — and our clinical team stays involved throughout.</p>

        <h2>What we treat</h2>
        <p>Our programs serve people dealing with a wide range of substance use disorders and co-occurring conditions:</p>
        <ul>
          <li><a href="/what-we-treat/alcohol">Alcohol use disorder</a></li>
          <li><a href="/what-we-treat/opioids">Opioid addiction</a> — including prescription painkillers and heroin</li>
          <li>Stimulant and methamphetamine use disorders</li>
          <li><a href="/what-we-treat/dual-diagnosis">Co-occurring mental health conditions</a> (dual diagnosis)</li>
          <li><a href="/what-we-treat/trauma-addiction">Trauma-rooted addiction</a></li>
        </ul>
        <p>Addiction rarely stands alone. Our clinical team is trained to treat the whole person — not just the substance.</p>

        <h2>A nonprofit difference</h2>
        <p>As a <strong>501(c)(3) nonprofit</strong>, Sunbright Recovery Center exists to serve — not to maximize margin. Private pay is accepted today. Treatment isn't free, but we work hard to make it accessible. Learn more about <a href="/insurance">insurance and payment options</a>, or call us to talk through what's possible.</p>

        <h2>Getting started</h2>
        <p>Admissions begins with a conversation — not a form. Call us at <a href="tel:+15305282342">(530) 528-2342</a> or read about <a href="/admissions">how the admissions process works</a>. We serve residents from Red Bluff, Redding, Chico, Sacramento, and across Northern California.</p>
      </div>

      <aside class="aside">
        <h3>Programs at a glance</h3>
        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          16-bed residential center in Red Bluff
        </div>
        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          30, 60, and 90-day residential tracks
        </div>
        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          IOP &amp; PHP outpatient programs
        </div>
        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Sober living &amp; aftercare support
        </div>
        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Faith-integrated, never required
        </div>
        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Private pay accepted today
        </div>
        <a href="/admissions" class="btn btn-navy">Start Admissions</a>
      </aside>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The Sunbright Approach</span>
        <h2>Evidence-based care with <em>real human support.</em></h2>
        <p class="lead">Every program combines proven clinical methods with the kind of personal attention that only a personal and connected center can offer.</p>
      </div>
      <div class="grid grid-3">
        <div class="step">
          <span class="step-n">01</span>
          <h3>Clinical assessment</h3>
          <p>We start by understanding you — your history, your goals, your medical needs. That shapes everything that follows.</p>
        </div>
        <div class="step">
          <span class="step-n">02</span>
          <h3>Personalized treatment plan</h3>
          <p>Your care team builds a plan that fits your diagnosis, your co-occurring conditions, and your life circumstances.</p>
        </div>
        <div class="step">
          <span class="step-n">03</span>
          <h3>Integrated therapies</h3>
          <p>Individual therapy, group sessions, CBT, EMDR for trauma, and faith-based elements for those who want them.</p>
        </div>
        <div class="step">
          <span class="step-n">04</span>
          <h3>Family involvement</h3>
          <p>Recovery heals relationships too. Family education and support are built into the program, not bolted on at the end.</p>
        </div>
        <div class="step">
          <span class="step-n">05</span>
          <h3>Step-down planning</h3>
          <p>Every level of care ends with a clear, supported transition to the next — whether that's IOP, sober living, or community care.</p>
        </div>
        <div class="step">
          <span class="step-n">06</span>
          <h3>Ongoing aftercare</h3>
          <p>We stay connected. Alumni support, ongoing therapy, and community resources keep recovery on track after formal treatment ends.</p>
        </div>
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href="/our-approach" class="btn btn-gold">Read About Our Approach</a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <span class="eyebrow">The first call is free</span>
    <h2>Let's find the right program <em>together.</em></h2>
    <p>Call us for a private, no-pressure conversation about which level of care makes sense for you or your loved one. We'll answer every question honestly.</p>
    <div class="btn-row">
      <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
      <a href="/admissions" class="btn btn-ghost">How Admissions Works</a>
    </div>
  </section>
</SiteLayout>
