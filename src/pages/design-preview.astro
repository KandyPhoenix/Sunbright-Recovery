    .final-priv svg{width:12px;height:12px;color:var(--gold)}

    /* ══ FOOTER ══ */
    footer{background:var(--navy-dk)}
    .f-crisis{background:var(--navy);padding:11px 28px;text-align:center;font-size:13px;color:rgba(255,255,255,.5)}
