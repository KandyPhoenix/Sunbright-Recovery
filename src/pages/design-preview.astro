---
// Design Preview V5 — Matches flyer: warm navy, gold, script font, rich and full
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Sunbright Recovery — Design Preview</title>
  <meta name="robots" content="noindex"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --navy:#1a2e5a; --navy-dk:#101d3a; --navy-mid:#254080; --navy-lt:#edf1fa;
      --gold:#c8900a; --gold-lt:#f0c040; --gold-pale:#fdf5e0; --gold-bg:#fef9ee;
      --cream:#ede4d0; --cream-dk:#ddd2b8; --white:#fff;
      --text:#1a2438; --mid:#3d4a5c; --soft:#6b7a8d; --border:#e2d9c8;
    }
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.6}
    h1,h2,h3,h4{font-family:'Lora',Georgia,serif;line-height:1.2}
    .script{font-family:'Dancing Script',cursive}
    img{display:block;max-width:100%}
    a{text-decoration:none;color:inherit}
    .wrap{max-width:1160px;margin:0 auto;padding:0 28px}

    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 28px;border-radius:8px;font-size:14.5px;font-weight:700;font-family:'Inter',sans-serif;transition:all .2s;cursor:pointer;border:none;text-decoration:none}
    .btn:hover{transform:translateY(-2px)}
    .btn-gold{background:var(--gold);color:#fff;box-shadow:0 4px 16px rgba(200,144,10,.4)}
    .btn-gold:hover{background:#a87008}
    .btn-navy{background:var(--navy);color:#fff;box-shadow:0 4px 14px rgba(26,46,90,.35)}
    .btn-navy:hover{background:var(--navy-dk)}
    .btn-ghost{background:rgba(255,255,255,.14);color:#fff;border:2px solid rgba(255,255,255,.45)}
    .btn-ghost:hover{background:rgba(255,255,255,.25)}
    .btn-outline{background:transparent;color:var(--navy);border:2px solid var(--navy)}
    .btn-outline:hover{background:var(--navy-lt)}

    /* NAV */
    nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(26,46,90,.08)}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;height:110px}
    .nav-in img{height:100px;width:auto}
    .nav-links{display:flex;align-items:center;gap:2px}
    .nav-links a{padding:8px 12px;border-radius:6px;font-size:13.5px;font-weight:500;color:var(--mid);transition:all .15s}
    .nav-links a:hover{color:var(--navy);background:var(--navy-lt)}
    .nav-cta{display:flex;align-items:center;gap:7px;background:var(--navy);color:#fff;padding:11px 20px;border-radius:8px;font-size:14px;font-weight:700;box-shadow:0 2px 12px rgba(26,46,90,.3);transition:all .2s}
    .nav-cta:hover{background:var(--navy-dk);transform:translateY(-1px)}

    /* ══════════════════════════
       HERO — rich, full, navy sky
    ══════════════════════════ */
    .hero{position:relative;overflow:hidden;background:#0d1e3a}

    /* Brightening blue gradient — lighter at bottom (from design-preview link) */
    .hero-bg{position:absolute;inset:0;background:linear-gradient(180deg,#0d1e3a 0%,#152960 50%,#2a4a90 100%)}

    /* Sun beam rays behind logo — hidden for now */
    .hero-rays{display:none}

    /* Gold glow removed */
    .hero-glow{display:none}

    /* Star field */
    .hero-stars{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.55) 1px,transparent 1px),radial-gradient(circle,rgba(255,255,255,.3) 1px,transparent 1px),radial-gradient(circle,rgba(255,255,255,.4) 1px,transparent 1px);background-size:160px 160px,110px 110px,220px 220px;background-position:30px 25px,70px 90px,150px 50px;opacity:.35;pointer-events:none}

    .hero-inner{position:relative;z-index:2;max-width:1160px;margin:0 auto;padding:52px 28px 60px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}

    .hero-left{}
    .hero-tagline-top{font-family:'Dancing Script',cursive;font-size:30px;color:var(--gold-lt);display:block;margin-bottom:6px}
    .hero h1{font-size:clamp(38px,5.5vw,64px);font-weight:700;color:#fff;letter-spacing:-.02em;margin-bottom:10px;line-height:1.06;text-shadow:0 2px 20px rgba(0,0,0,.4)}
    .hero h1 em{font-style:italic;color:var(--gold-lt)}
    .hero-type{font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:14px;display:flex;align-items:center;gap:8px}
    .hero-type::before{content:'';width:24px;height:2px;background:var(--gold-lt);border-radius:2px;display:block}
    .hero-sub{font-size:16.5px;color:rgba(255,255,255,.68);line-height:1.75;margin-bottom:28px;max-width:460px}
    .hero-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}
    .hero-privacy{display:flex;align-items:center;gap:6px;font-size:12.5px;color:rgba(255,255,255,.38)}
    .hero-privacy svg{width:12px;height:12px;color:var(--gold-lt);flex-shrink:0}

    /* Right panel — sun anchored to bottom, centered horizontally, text cropped */
    .hero-right{position:relative;min-height:480px;display:flex;align-items:flex-end;justify-content:center;overflow:visible}
    .hero-sun-only{
      position:relative;
      width:200%;
      margin-left:-50%;
      margin-right:-50%;
      height:440px;
      overflow:hidden;
      pointer-events:none;
      display:flex;
      align-items:flex-start;
      justify-content:center;
    }
    .hero-sun-only img{
      width:100%;
      max-width:none;
      display:block;
      margin:0 auto;
      transform:translateX(95px);
    }
    .hero-logo-wrap{position:relative;display:flex;align-items:center;justify-content:center;padding:20px}
    .hero-logo-wrap::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse,rgba(240,192,64,.15) 0%,transparent 70%);border-radius:50%}
    .hero-logo-wrap img{width:300px;filter:brightness(0) invert(1);opacity:.93;position:relative;z-index:1}
    .hero-badge-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%}
    .hero-badge{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:10px;padding:10px 12px;text-align:center}
    .hero-badge strong{display:block;font-size:13px;font-weight:800;color:#fff;margin-bottom:2px}
    .hero-badge span{font-size:11px;color:rgba(255,255,255,.5)}
    .hero-tagline-pill{background:rgba(200,144,10,.2);border:1px solid rgba(240,192,64,.35);border-radius:100px;padding:9px 20px;font-family:'Dancing Script',cursive;font-size:19px;color:var(--gold-lt);text-align:center;width:100%}

    /* ══ TRUST STRIP — refined pill chips ══ */
    .trust-strip{background:linear-gradient(180deg,var(--navy-dk) 0%,var(--navy-dk) 50%,var(--cream) 50%,var(--cream) 100%);padding:0 28px;position:relative}
    .trust-strip-in{max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;padding:0 0}
    .ts-chip{background:#fff;border:1.5px solid var(--border);border-radius:100px;padding:11px 20px;display:flex;align-items:center;gap:9px;font-size:13px;font-weight:600;color:var(--navy);box-shadow:0 6px 20px rgba(26,46,90,.12);transition:all .2s}
    .ts-chip:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(26,46,90,.18);border-color:var(--gold)}
    .ts-chip .dot{width:8px;height:8px;border-radius:50%;background:var(--gold);flex-shrink:0;box-shadow:0 0 0 3px rgba(240,192,64,.2)}
    .ts-chip.accent{background:var(--navy);color:#fff;border-color:var(--navy)}
    .ts-chip.accent .dot{background:var(--gold-lt);box-shadow:0 0 0 3px rgba(240,192,64,.25)}

    /* ══ 30/60/90 BAND ══ */
    .band{background:var(--navy);padding:56px 28px;text-align:center;position:relative;overflow:hidden}
    .band-inner{position:relative;max-width:900px;margin:0 auto}
    .band-label{font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:24px}
    .band-badges{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
    .band-badge-card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:14px;padding:22px 16px;text-align:center;transition:all .25s}
    .band-badge-card:hover{background:rgba(255,255,255,.12);border-color:var(--gold-lt);transform:translateY(-3px)}
    .band-badge-card strong{display:block;font-family:'Lora',serif;font-size:clamp(20px,2.5vw,30px);font-weight:700;color:var(--gold-lt);margin-bottom:4px;letter-spacing:-.01em}
    .band-badge-card span{font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.6)}
    .band-sub{font-size:18px;color:rgba(255,255,255,.55);margin-bottom:30px;font-family:'Dancing Script',cursive}
    .band-ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
    /* Badge circle — from flyer */
    .band-badge{position:absolute;right:40px;top:50%;transform:translateY(-50%);width:110px;height:110px;border-radius:50%;background:rgba(255,255,255,.07);border:2px solid rgba(240,192,64,.4);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12px}
    .band-badge span{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--gold-lt);line-height:1.5}

    /* ══ FEATURES ══ */
    .features{padding:64px 0;background:var(--cream)}
    .feat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
    .feat-card{background:var(--white);border:1.5px solid var(--border);border-radius:14px;padding:22px 14px;text-align:center;transition:all .2s}
    .feat-card:hover{box-shadow:0 8px 24px rgba(26,46,90,.1);transform:translateY(-3px);border-color:var(--gold)}
    .feat-icon{width:50px;height:50px;border-radius:50%;background:var(--navy);margin:0 auto 12px;display:flex;align-items:center;justify-content:center}
    .feat-card h4{font-family:'Inter',sans-serif;font-size:10.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--navy);margin-bottom:7px}
    .feat-card p{font-size:12px;color:var(--soft);line-height:1.5}

    /* ══ PROGRAMS ══ */
    .programs{padding:72px 0;background:var(--white)}
    .sec-head{text-align:center;margin-bottom:44px}
    .sec-script{font-family:'Dancing Script',cursive;font-size:28px;color:var(--gold);display:block;margin-bottom:2px}
    .sec-h2{font-size:clamp(26px,3.5vw,40px);color:var(--navy);margin-bottom:8px}
    .sec-sub{font-size:16px;color:var(--soft);max-width:480px;margin:0 auto}
    .prog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    .prog-card{border:1.5px solid var(--border);border-radius:16px;padding:28px;background:var(--white);transition:all .25s;cursor:pointer;display:flex;flex-direction:column;position:relative;overflow:hidden}
    .prog-top-bar{position:absolute;top:0;left:0;right:0;height:3px;background:var(--gold);opacity:0;transition:opacity .25s}
    .prog-card:hover{border-color:var(--gold);box-shadow:0 12px 32px rgba(200,144,10,.12);transform:translateY(-3px)}
    .prog-card:hover .prog-top-bar{opacity:1}
    .prog-ico{width:46px;height:46px;border-radius:12px;background:var(--gold-pale);border:1.5px solid var(--cream-dk);display:flex;align-items:center;justify-content:center;margin-bottom:14px}
    .prog-tag{position:absolute;top:18px;right:18px;font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--navy);background:var(--navy-lt);padding:4px 10px;border-radius:100px}
    .prog-card h3{font-size:20px;color:var(--navy);margin-bottom:8px}
    .prog-card p{font-size:14px;color:var(--soft);line-height:1.7;flex:1;margin-bottom:16px}
    .prog-link{display:flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:var(--gold);transition:gap .2s}
    .prog-card:hover .prog-link{gap:9px}

    /* ══ WHAT WE TREAT ══ */
    .treat{padding:72px 0;background:var(--gold-bg)}
    .treat-grid{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center}
    .treat-script{font-family:'Dancing Script',cursive;font-size:26px;color:var(--gold);display:block;margin-bottom:6px}
    .treat h2{font-size:clamp(26px,3.3vw,38px);color:var(--navy);margin-bottom:18px}
    .treat-list{list-style:none;display:flex;flex-direction:column;gap:9px}
    .treat-list li{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:500;color:var(--mid)}
    .treat-check{width:22px;height:22px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .treat-vis{border-radius:18px;overflow:hidden;box-shadow:0 20px 48px rgba(26,46,90,.18);position:relative}
    .treat-vis img{width:100%;height:320px;object-fit:cover}
    .treat-vis-foot{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(26,46,90,.85) 0%,transparent 100%);padding:20px 20px 22px}
    .treat-motto{font-family:'Dancing Script',cursive;font-size:20px;color:var(--gold-lt)}

    /* ══ YOUR JOURNEY ══ */
    .journey{padding:72px 0;background:var(--navy);position:relative;overflow:hidden}
    .journey::before{content:'';position:absolute;top:-100px;right:-100px;width:450px;height:450px;background:radial-gradient(ellipse,rgba(200,144,10,.1),transparent 65%)}
    .journey-grid{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
    .journey-script{font-family:'Dancing Script',cursive;font-size:56px;color:var(--gold-lt);line-height:1;display:block;margin-bottom:2px}
    .journey h2{font-size:clamp(28px,3.5vw,40px);color:#fff;margin-bottom:14px}
    .journey p{font-size:16px;color:rgba(255,255,255,.55);line-height:1.8;margin-bottom:28px}
    .journey-steps{display:flex;flex-direction:column;gap:12px}
    .j-step{display:flex;align-items:flex-start;gap:14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:16px}
    .j-num{width:38px;height:38px;border-radius:50%;background:var(--gold);color:var(--navy-dk);font-size:14px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .j-step h4{font-family:'Inter',sans-serif;font-size:14px;font-weight:700;color:#fff;margin-bottom:3px}
    .j-step p{font-size:12.5px;color:rgba(255,255,255,.45);line-height:1.5}

    /* ══ DONATIONS ══ */
    .donations{padding:80px 0;background:var(--cream)}
    .don-intro{max-width:680px;margin:0 0 32px}
    .don-intro .eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--mid);margin-bottom:10px;display:block}
    .don-intro h2{font-family:'Lora',serif;font-size:clamp(34px,4.5vw,52px);color:#2a2a18;margin-bottom:18px;line-height:1.1;letter-spacing:-.01em}
    .don-intro p{font-size:16px;color:#3a3a28;line-height:1.7;max-width:560px}
    .don-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}
    .don-card{background:var(--white);border:1px solid #e8e0cf;border-radius:14px;padding:24px;transition:all .2s;position:relative}
    .don-card:hover{box-shadow:0 6px 20px rgba(26,46,90,.06);transform:translateY(-2px)}
    .don-card.feat{background:var(--gold-pale);border:1px solid var(--gold-lt)}
    .don-icon-box{width:38px;height:38px;border-radius:8px;background:#f0e8d8;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
    .don-card.feat .don-icon-box{background:var(--gold);color:#fff}
    .don-icon-box svg{width:20px;height:20px;color:#3a3a28}
    .don-card.feat .don-icon-box svg{color:#fff}
    .don-tag{position:absolute;top:22px;right:22px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:var(--gold);padding:4px 10px;border-radius:100px}
    .don-card h3{font-family:'Inter',sans-serif;font-size:17px;font-weight:700;color:#2a2a18;margin-bottom:10px}
    .don-card p{font-size:14px;color:#5a5a45;line-height:1.55;margin-bottom:0}
    .don-link{display:inline-flex;align-items:center;gap:6px;margin-top:16px;font-size:13.5px;font-weight:700;color:#a87008;transition:gap .2s}
    .don-link:hover{gap:10px}
    .don-link svg{width:14px;height:14px}
    .fac-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
    .fac-strip img{border-radius:10px;width:100%;height:160px;object-fit:cover;box-shadow:0 4px 16px rgba(0,0,0,.08);transition:transform .2s}
    .fac-strip img:hover{transform:scale(1.02)}
    .don-cta{background:linear-gradient(135deg,#1f1d14 0%,#0e0c08 100%);border-radius:16px;padding:36px 32px;position:relative;overflow:hidden}
    .don-cta h3{font-family:'Lora',serif;font-size:28px;color:#fff;margin-bottom:8px;font-weight:600}
    .don-cta p{font-size:15px;color:rgba(255,255,255,.55);margin-bottom:22px;max-width:680px;line-height:1.6}
    .don-btns{display:flex;gap:10px;flex-wrap:wrap}
    .don-cta .btn-donate{background:#3a78c4;color:#fff;padding:12px 22px;border-radius:100px;font-weight:700;font-size:14px;display:inline-flex;align-items:center;gap:7px}
    .don-cta .btn-donate:hover{background:#2a5ca0;transform:translateY(-2px)}
    .don-cta .btn-call{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.4);padding:12px 22px;border-radius:100px;font-weight:700;font-size:14px;display:inline-flex;align-items:center;gap:7px}
    .don-cta .btn-call:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.6)}

    /* ══ QUOTE ══ */
    .quote-sec{padding:72px 0;background:var(--white)}
    .q-inner{text-align:center;max-width:680px;margin:0 auto}
    .q-mark{font-family:'Dancing Script',cursive;font-size:72px;color:var(--gold);line-height:.8;display:block;margin-bottom:8px}
    .q-inner blockquote{font-family:'Lora',serif;font-size:clamp(18px,2.5vw,24px);font-style:italic;color:var(--navy);line-height:1.7;margin-bottom:18px}
    .q-inner cite{font-style:normal;font-size:12px;font-weight:700;color:var(--soft);letter-spacing:.06em;text-transform:uppercase}
    .q-heal{margin-top:28px;padding-top:24px;border-top:1px solid var(--border)}
    .q-heal p{font-family:'Dancing Script',cursive;font-size:26px;color:var(--gold)}

    /* ══ FAQ ══ */
    .faq-sec{padding:72px 0;background:var(--cream)}
    .faq-list{max-width:700px;margin:0 auto;display:flex;flex-direction:column;gap:9px}
    .faq-item{background:var(--white);border:1.5px solid var(--border);border-radius:12px;overflow:hidden}
    .faq-item.open{border-color:var(--navy)}
    .faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;background:none;border:none;cursor:pointer;font-family:'Inter',sans-serif;font-size:14.5px;font-weight:600;color:var(--navy);text-align:left;transition:background .15s}
    .faq-q:hover{background:var(--navy-lt)}
    .faq-q svg{width:17px;height:17px;color:var(--gold);flex-shrink:0;transition:transform .25s}
    .faq-item.open .faq-q svg{transform:rotate(180deg)}
    .faq-a{padding:0 20px 15px;font-size:14px;color:var(--mid);line-height:1.75;display:none}
    .faq-item.open .faq-a{display:block}
    .faq-more{text-align:center;margin-top:22px}
    .faq-more a{display:inline-flex;align-items:center;gap:5px;font-size:14px;font-weight:700;color:var(--navy);border-bottom:2px solid var(--gold);padding-bottom:2px;transition:gap .2s}
    .faq-more a:hover{gap:9px}

    /* ══ FINAL CTA ══ */
    .final{padding:72px 0;background:var(--gold-bg)}
    .final-inner{text-align:center}
    .final-script{font-family:'Dancing Script',cursive;font-size:54px;color:var(--gold);display:block;margin-bottom:2px}
    .final h2{font-size:clamp(28px,3.8vw,44px);color:var(--navy);margin-bottom:12px}
    .final p{font-size:17px;color:var(--soft);margin-bottom:30px;max-width:440px;margin-left:auto;margin-right:auto}
    .final-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:18px}
