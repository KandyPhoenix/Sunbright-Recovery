---
// Design Preview V3 — Sun as visual theme, logo colors (navy + gold), light & warm
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sunbright Recovery Center — Design Preview</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:      #1a3270;
      --navy-dk:   #112050;
      --navy-mid:  #2a4a90;
      --navy-pale: #eef2fb;
      --gold:      #f5b800;
      --gold-dk:   #c89600;
      --gold-lt:   #fff8dc;
      --gold-pale: #fffbf0;
      --cream:     #faf8f3;
      --cream-dk:  #f2ede2;
      --white:     #ffffff;
      --text:      #1a2438;
      --text-mid:  #3d4a5c;
      --text-soft: #7a8494;
      --border:    #e8e4da;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      background: var(--white);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    h1,h2,h3,h4 { font-family: 'Lora', Georgia, serif; line-height: 1.2; }
    img { display: block; max-width: 100%; }
    a { text-decoration: none; color: inherit; }

    .container { max-width: 1160px; margin: 0 auto; padding: 0 28px; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 28px; border-radius: 12px;
      font-size: 15px; font-weight: 700; font-family: 'Inter', sans-serif;
      transition: all .2s; cursor: pointer; border: none; text-decoration: none;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-gold  { background: var(--gold); color: var(--navy-dk); box-shadow: 0 4px 16px rgba(245,184,0,.4); }
    .btn-gold:hover { background: #ffc200; box-shadow: 0 6px 22px rgba(245,184,0,.5); }
    .btn-navy  { background: var(--navy); color: #fff; box-shadow: 0 4px 14px rgba(26,50,112,.3); }
    .btn-navy:hover { background: var(--navy-dk); }
    .btn-ghost { background: rgba(255,255,255,.14); color: #fff; border: 1.5px solid rgba(255,255,255,.35); backdrop-filter: blur(4px); }
    .btn-ghost:hover { background: rgba(255,255,255,.24); }
    .btn-outline { background: transparent; color: var(--navy); border: 2px solid var(--navy); }
    .btn-outline:hover { background: var(--navy-pale); }

    /* ─── NAV ─── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,.97); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 16px rgba(26,50,112,.06);
    }
    .nav-inner {
      max-width: 1160px; margin: 0 auto; padding: 0 28px;
      display: flex; align-items: center; justify-content: space-between;
      height: 88px;
    }
    .nav-logo img { height: 72px; width: auto; }
    .nav-links { display: flex; align-items: center; gap: 2px; }
    .nav-links a {
      padding: 8px 13px; border-radius: 8px;
      font-size: 13.5px; font-weight: 500; color: var(--text-mid);
      transition: all .15s;
    }
    .nav-links a:hover { color: var(--navy); background: var(--navy-pale); }
    .nav-cta {
      display: flex; align-items: center; gap: 7px;
      background: var(--navy); color: #fff;
      padding: 11px 20px; border-radius: 10px;
      font-size: 14px; font-weight: 700;
      box-shadow: 0 2px 10px rgba(26,50,112,.3);
      transition: all .2s;
    }
    .nav-cta:hover { background: var(--navy-dk); transform: translateY(-1px); }


    /* ─── HERO ─── */
    .hero {
      background: var(--navy);
      display: flex; align-items: center;
      position: relative; overflow: hidden;
      padding: 64px 28px 72px;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 100% 80% at 60% 120%, #2a4a90 0%, #1a3270 50%, #0d1e50 100%);
    }

    .hero-inner {
      position: relative; z-index: 2;
      max-width: 1160px; margin: 0 auto; width: 100%;
      display: grid; grid-template-columns: 1fr auto;
      align-items: center; gap: 48px;
    }

    .hero h1 {
      font-size: clamp(36px, 5.5vw, 64px);
      font-weight: 700; color: #fff;
      letter-spacing: -.02em; margin-bottom: 14px;
      line-height: 1.1;
    }
    .hero h1 em { font-style: italic; color: var(--gold); }

    .hero-sub {
      font-size: 17px; color: rgba(255,255,255,.68);
      line-height: 1.7; margin-bottom: 30px; max-width: 500px;
    }

    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }

    .hero-privacy {
      display: flex; align-items: center; gap: 6px;
      font-size: 13px; color: rgba(255,255,255,.4);
    }
    .hero-privacy svg { width: 13px; height: 13px; color: var(--gold); flex-shrink: 0; }

    /* Sun image — right side, white, cropped to just the sun */
    .hero-sun-wrap {
      width: 220px; height: 175px;
      overflow: hidden; flex-shrink: 0;
    }
    .hero-sun-wrap img {
      width: 220px;
      filter: brightness(0) invert(1);
      opacity: .88;
      display: block;
    }

    /* Trust strip */
    .trust-strip {
      background: var(--gold);
      padding: 14px 28px;
    }
    .trust-strip-inner {
      max-width: 1160px; margin: 0 auto;
      display: flex; align-items: center; justify-content: center;
      gap: 28px; flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: 7px;
      font-size: 13px; font-weight: 700; color: var(--navy-dk);
    }
    .trust-item svg { width: 14px; height: 14px; flex-shrink: 0; }


    /* ─── SECTION COMMON ─── */
    section { padding: 80px 0; }

    /* Sun motif divider used between sections */
    .sun-divider {
      display: flex; align-items: center; justify-content: center;
      gap: 12px; margin-bottom: 40px;
    }
    .sun-divider .line { flex: 1; max-width: 80px; height: 1.5px; background: var(--gold); border-radius: 2px; opacity: .5; }

    .section-label {
      text-align: center;
      font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: var(--gold-dk); margin-bottom: 10px;
    }
    .section-h2 {
      font-size: clamp(26px, 3.8vw, 42px);
      color: var(--navy); text-align: center; margin-bottom: 10px;
    }
    .section-sub {
      font-size: 17px; color: var(--text-soft);
      text-align: center; max-width: 520px;
      margin: 0 auto 52px;
    }
    .section-h2.left { text-align: left; }
    .section-sub.left { text-align: left; margin: 0 0 40px; }


    /* ─── PROGRAMS ─── */
    .programs { background: var(--white); }
    .programs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .prog-card {
      border: 1.5px solid var(--border); border-radius: 20px; padding: 30px;
      background: var(--white); transition: all .25s; cursor: pointer;
      display: flex; flex-direction: column; position: relative; overflow: hidden;
    }
    .prog-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), rgba(245,184,0,.3));
      opacity: 0; transition: opacity .25s;
    }
    .prog-card:hover { border-color: var(--gold); box-shadow: 0 12px 36px rgba(245,184,0,.15); transform: translateY(-4px); }
    .prog-card:hover::before { opacity: 1; }
    .prog-card-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
    .prog-icon {
      width: 52px; height: 52px; border-radius: 16px;
      background: var(--gold-pale); border: 1.5px solid var(--gold-lt);
      display: flex; align-items: center; justify-content: center;
    }
    .prog-tag {
      font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      color: var(--navy); background: var(--navy-pale);
      padding: 4px 10px; border-radius: 100px;
    }
    .prog-card h3 { font-size: 21px; color: var(--navy); margin-bottom: 8px; }
    .prog-card p { font-size: 14px; color: var(--text-soft); line-height: 1.7; flex: 1; margin-bottom: 20px; }
    .prog-link {
      display: flex; align-items: center; gap: 6px;
      font-size: 13.5px; font-weight: 700; color: var(--gold-dk);
      transition: gap .2s;
    }
    .prog-card:hover .prog-link { gap: 10px; }


    /* ─── TRUST PILLARS ─── */
    .trust-pillars { background: var(--gold-pale); }
    .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .pillar { text-align: center; }
    .pillar-icon {
      width: 72px; height: 72px; border-radius: 50%;
      background: var(--navy); margin: 0 auto 18px;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 8px 24px rgba(26,50,112,.25);
    }
    .pillar h3 { font-size: 20px; color: var(--navy); margin-bottom: 10px; }
    .pillar p { font-size: 14.5px; color: var(--text-mid); line-height: 1.7; max-width: 280px; margin: 0 auto; }


    /* ─── WHAT WE TREAT ─── */
    .conditions { background: var(--white); }
    .conditions-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .cond-card {
      background: var(--cream); border: 1.5px solid var(--border);
      border-radius: 18px; padding: 28px 20px;
      text-align: center; transition: all .25s; cursor: pointer;
    }
    .cond-card:hover {
      background: var(--navy); border-color: var(--navy);
      transform: translateY(-3px); box-shadow: 0 8px 24px rgba(26,50,112,.2);
    }
    .cond-card:hover span { color: #fff; }
    .cond-card .icon { font-size: 32px; margin-bottom: 12px; display: block; }
    .cond-card span { font-size: 14px; font-weight: 600; color: var(--navy); transition: color .25s; }


    /* ─── MEET LINDA ─── */
    .meet-linda { background: var(--navy-pale); }
    .meet-linda-inner {
      display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
    }
    .meet-linda-text .label {
      font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
      color: var(--gold-dk); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
    }
    .meet-linda-text .label span { width: 20px; height: 2px; background: var(--gold); border-radius: 2px; display: block; }
    .meet-linda-text h2 { font-size: clamp(24px, 3vw, 36px); color: var(--navy); margin-bottom: 16px; line-height: 1.3; }
    .meet-linda-text p { font-size: 16px; color: var(--text-mid); line-height: 1.8; margin-bottom: 24px; }
    .meet-linda-text a {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 14px; font-weight: 700; color: var(--navy);
      border-bottom: 2px solid var(--gold); padding-bottom: 2px;
      transition: gap .2s;
    }
    .meet-linda-text a:hover { gap: 10px; }
    .meet-linda-graphic {
      display: flex; align-items: center; justify-content: center;
    }


    /* ─── ADMISSIONS ─── */
    .admissions { background: var(--white); }
    .steps-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin-bottom: 44px; }
    .step-card {
      background: var(--cream); border: 1.5px solid var(--border);
      border-radius: 18px; padding: 24px;
    }
    .step-num {
      width: 44px; height: 44px; border-radius: 50%;
      background: var(--navy); color: #fff;
      font-size: 14px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 14px;
      box-shadow: 0 4px 12px rgba(26,50,112,.3);
    }
    .step-card h3 { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
    .step-card p { font-size: 13.5px; color: var(--text-soft); line-height: 1.65; }
    .admissions-cta { text-align: center; }


    /* ─── DONATIONS ─── */
    .donations { background: var(--cream); }
    .facility-photos {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 40px 0 48px;
    }
    .facility-photos img {
      border-radius: 14px; width: 100%; height: 188px; object-fit: cover;
      box-shadow: 0 4px 16px rgba(0,0,0,.1); transition: transform .25s;
    }
    .facility-photos img:hover { transform: scale(1.02); }
    .donations-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }
    .don-card {
      background: var(--white); border: 1.5px solid var(--border);
      border-radius: 18px; padding: 24px; transition: box-shadow .2s;
    }
    .don-card:hover { box-shadow: 0 6px 20px rgba(26,50,112,.08); }
    .don-card.featured { border: 2px solid var(--gold); }
    .don-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
    .don-card .icon { font-size: 28px; }
    .don-card .badge {
      font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      color: var(--navy); background: var(--gold-lt);
      padding: 4px 10px; border-radius: 100px; border: 1px solid var(--gold-lt);
    }
    .don-card h3 { font-size: 17px; color: var(--navy); margin-bottom: 10px; }
    .don-card ul { list-style: none; display: flex; flex-direction: column; gap: 5px; }
    .don-card ul li {
      display: flex; align-items: center; gap: 8px;
      font-size: 13px; color: var(--text-mid);
    }
    .don-card ul li::before {
      content: ''; width: 5px; height: 5px; border-radius: 50%;
      background: var(--gold); flex-shrink: 0;
    }
    .don-cta {
      background: var(--navy); border-radius: 20px; padding: 48px 40px; text-align: center;
      position: relative; overflow: hidden;
    }
    .don-cta::before {
      content: '';
      position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
      width: 500px; height: 300px;
      background: radial-gradient(ellipse, rgba(245,184,0,.12), transparent 70%);
    }
    .don-cta h3 { font-size: 28px; color: #fff; margin-bottom: 10px; position: relative; }
    .don-cta p { font-size: 16px; color: rgba(255,255,255,.55); margin-bottom: 28px; position: relative; max-width: 480px; margin-left: auto; margin-right: auto; }
    .don-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; position: relative; }


    /* ─── QUOTE ─── */
    .quote-section { background: var(--navy); padding: 80px 0; position: relative; overflow: hidden; }
    .quote-section::before {
      content: '';
      position: absolute; top: -40px; left: 50%; transform: translateX(-50%);
      width: 600px; height: 400px;
      background: radial-gradient(ellipse, rgba(245,184,0,.08), transparent 70%);
    }
    .quote-inner { position: relative; text-align: center; max-width: 760px; margin: 0 auto; }
    .quote-inner blockquote {
      font-family: 'Lora', serif; font-size: clamp(20px, 2.8vw, 28px);
      font-style: italic; color: #fff; line-height: 1.65; margin: 24px 0;
    }
    .quote-inner cite { font-style: normal; font-size: 13.5px; font-weight: 600; color: rgba(255,255,255,.45); letter-spacing: .04em; }


    /* ─── FAQ ─── */
    .faq-section { background: var(--white); }
    .faq-list { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
    .faq-item { background: var(--cream); border: 1.5px solid var(--border); border-radius: 14px; overflow: hidden; }
    .faq-item.open { border-color: var(--navy); background: #fff; }
    .faq-q {
      width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
      padding: 18px 22px; background: none; border: none; cursor: pointer;
      font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600;
      color: var(--navy); text-align: left; transition: background .15s;
    }
    .faq-q svg { width: 18px; height: 18px; color: var(--gold-dk); flex-shrink: 0; transition: transform .25s; }
    .faq-item.open .faq-q svg { transform: rotate(180deg); }
    .faq-a { padding: 0 22px 18px; font-size: 14px; color: var(--text-mid); line-height: 1.75; display: none; }
    .faq-item.open .faq-a { display: block; }
    .faq-more { text-align: center; margin-top: 28px; }
    .faq-more a {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 14px; font-weight: 700; color: var(--navy);
      border-bottom: 2px solid var(--gold); padding-bottom: 2px;
      transition: gap .2s;
    }
    .faq-more a:hover { gap: 10px; }


    /* ─── FINAL CTA ─── */
    .final-cta { background: var(--gold-pale); padding: 80px 0; }
    .final-cta-inner { text-align: center; }
    .final-cta h2 { font-size: clamp(28px, 4vw, 48px); color: var(--navy); margin-bottom: 12px; }
    .final-cta p { font-size: 18px; color: var(--text-soft); margin-bottom: 36px; max-width: 480px; margin-left: auto; margin-right: auto; }
    .final-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 20px; }
    .final-privacy {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      font-size: 13px; color: var(--text-soft);
    }
    .final-privacy svg { width: 13px; height: 13px; color: var(--gold-dk); }


    /* ─── FOOTER ─── */
    footer { background: var(--navy-dk); }
    .footer-crisis {
      background: var(--navy); padding: 13px 28px;
      text-align: center; font-size: 13px; color: rgba(255,255,255,.55);
    }
    .footer-crisis a { color: var(--gold); font-weight: 700; }
    .footer-main { padding: 56px 28px 40px; max-width: 1160px; margin: 0 auto; }
    .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }
    .footer-brand img { height: 52px; width: auto; margin-bottom: 16px; filter: brightness(0) invert(1); opacity: .8; }
    .footer-brand p { font-size: 13px; color: rgba(255,255,255,.35); line-height: 1.7; margin-bottom: 20px; }
    .footer-contact { display: flex; flex-direction: column; gap: 9px; }
    .footer-contact a { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.4); transition: color .15s; }
    .footer-contact a:hover { color: rgba(255,255,255,.85); }
    .footer-contact .phone { color: var(--gold) !important; font-weight: 700; font-size: 15px; }
    .footer-col h4 { font-family: 'Inter', sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.25); margin-bottom: 14px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .footer-col ul a { font-size: 13px; color: rgba(255,255,255,.4); transition: color .15s; }
    .footer-col ul a:hover { color: rgba(255,255,255,.85); }
    .footer-col + .footer-col { margin-top: 0; }
    .footer-col .mt { margin-top: 24px; }
    .footer-bottom {
      max-width: 1160px; margin: 0 auto;
      border-top: 1px solid rgba(255,255,255,.07);
      padding: 18px 28px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 12px; color: rgba(255,255,255,.22);
    }
    .footer-bottom a { color: rgba(255,255,255,.3); }

    /* Mobile sticky */
    .sticky-call {
      position: fixed; bottom: 20px; right: 20px; z-index: 200;
    }
    .sticky-call a {
      display: flex; align-items: center; gap: 8px;
      background: var(--navy); color: #fff;
      padding: 13px 20px; border-radius: 100px;
      font-size: 14px; font-weight: 700;
      box-shadow: 0 8px 24px rgba(26,50,112,.45);
      transition: all .2s;
    }
    .sticky-call a:hover { background: var(--navy-dk); transform: translateY(-2px); }
    .sticky-call svg { width: 16px; height: 16px; }

    svg.phone { width: 16px; height: 16px; flex-shrink: 0; }
  </style>
</head>
<body>

<!-- ══════════════════════════════
     NAV
══════════════════════════════ -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="/logo.png" alt="Sunbright Recovery Center" />
    </a>
    <div class="nav-links">
      <a href="/programs">Programs</a>
      <a href="/what-we-treat">What We Treat</a>
      <a href="/our-approach">Our Approach</a>
      <a href="/admissions">Admissions</a>
      <a href="/insurance">Insurance</a>
      <a href="/team">Team</a>
      <a href="/contact">Contact</a>
    </div>
