    .faq-q:hover{background:rgba(240,192,64,.05)}
    .faq-q svg{width:18px;height:18px;color:var(--gold);flex-shrink:0;transition:transform .25s}
    .faq-item.open .faq-q svg{transform:rotate(180deg);color:#a87008}
    .faq-a{padding:0 22px 20px;font-size:14.5px;color:var(--mid);line-height:1.8;display:none}
