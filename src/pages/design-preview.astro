---
// Design Preview — High-fidelity homepage mockup
// Earth tones + landscape palette, real photos, polished visual design
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sunbright Recovery Center — Design Preview</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --terra:    #c8683a;
      --terra-dk: #a55228;
      --terra-lt: #f0e0d4;
      --stone:    #3d3530;
      --stone-dk: #2a2420;
      --stone-md: #504540;
      --stone-lt: #f5f3f1;
      --moss:     #3c5028;
      --moss-lt:  #e8eddf;
      --sand:     #ecdcc4;
      --sand-lt:  #faf7f2;
      --sand-dk:  #d4c0a0;
      --water:    #3a7d94;
      --water-dk: #1f3f4e;
      --water-lt: #d8eaef;
      --gold:     #f5b800;
      --navy:     #1a3270;
      --ink:      #2a2420;
      --ink-mid:  #504540;
      --ink-soft: #7d6e63;
      --white:    #ffffff;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--ink);
      background: var(--white);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    h1,h2,h3,h4 { font-family: 'Lora', Georgia, serif; line-height: 1.2; }

    img { display: block; max-width: 100%; }
    a { text-decoration: none; color: inherit; }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    /* ─── UTILITY ─── */
    .tag {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 100px;
    }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 28px; border-radius: 12px;
      font-size: 15px; font-weight: 700; font-family: 'Inter', sans-serif;
      transition: all .2s; cursor: pointer; border: none;
      text-decoration: none;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-terra  { background: var(--terra);  color: #fff; box-shadow: 0 4px 16px rgba(200,104,58,.35); }
    .btn-terra:hover  { background: var(--terra-dk); box-shadow: 0 6px 20px rgba(200,104,58,.45); }
    .btn-stone  { background: var(--stone);  color: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.2); }
    .btn-stone:hover  { background: var(--stone-dk); }
    .btn-ghost  { background: rgba(255,255,255,.12); color: #fff; border: 1.5px solid rgba(255,255,255,.3); backdrop-filter: blur(4px); }
    .btn-ghost:hover  { background: rgba(255,255,255,.22); }
    .btn-moss   { background: var(--moss); color: #fff; }
    .btn-moss:hover { background: #2f3f1f; }

    /* ─── NAV ─── */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,.96); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0,0,0,.06);
      box-shadow: 0 1px 12px rgba(0,0,0,.06);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 24px;
      display: flex; align-items: center; justify-content: space-between;
      height: 88px;
    }
    .nav-logo img { height: 72px; width: auto; }
    .nav-links { display: flex; align-items: center; gap: 4px; }
    .nav-links a {
      padding: 8px 12px; border-radius: 8px; font-size: 13.5px; font-weight: 500;
      color: var(--ink-mid); transition: all .15s;
    }
    .nav-links a:hover { color: var(--stone); background: var(--stone-lt); }
    .nav-cta {
      display: flex; align-items: center; gap: 8px;
      background: var(--terra); color: #fff;
      padding: 10px 18px; border-radius: 10px;
      font-size: 14px; font-weight: 700; transition: all .2s;
    }
    .nav-cta:hover { background: var(--terra-dk); transform: translateY(-1px); }
    .nav-cta svg { width: 15px; height: 15px; }


    /* ─── HERO ─── */
    .hero {
      position: relative; min-height: 88vh;
      display: flex; align-items: center;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0;
    }
    .hero-bg img {
      width: 100%; height: 100%; object-fit: cover; object-position: center;
    }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(105deg, rgba(42,36,32,.92) 0%, rgba(61,53,48,.78) 45%, rgba(61,53,48,.45) 100%);
    }
    /* Warm gold glow from top — the "sunrise" */
    .hero-glow {
      position: absolute; top: -120px; left: 50%;
      transform: translateX(-50%);
      width: 700px; height: 400px;
      background: radial-gradient(ellipse, rgba(245,184,0,.18) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-content {
      position: relative; z-index: 2;
      max-width: 1200px; margin: 0 auto; padding: 80px 24px;
      max-width: 720px; margin-left: max(24px, calc((100vw - 1200px) / 2));
    }
    .hero-eyebrow {
      display: flex; align-items: center; gap: 10px;
      color: var(--gold); font-size: 13px; font-weight: 600;
      letter-spacing: .04em; margin-bottom: 20px;
    }
    .hero-eyebrow .line { width: 32px; height: 2px; background: var(--gold); border-radius: 2px; }
    .hero h1 {
      font-size: clamp(42px, 6vw, 72px);
      font-weight: 700; color: #fff;
      line-height: 1.08; margin-bottom: 20px;
      letter-spacing: -.02em;
    }
    .hero h1 em { font-style: italic; color: var(--gold); }
    .hero-sub {
      font-size: 18px; color: rgba(255,255,255,.8);
      line-height: 1.7; margin-bottom: 36px; max-width: 560px;
    }
    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
    .hero-privacy {
      display: flex; align-items: center; gap: 8px;
      font-size: 13px; color: rgba(255,255,255,.55);
    }
    .hero-privacy svg { width: 14px; height: 14px; color: var(--gold); flex-shrink: 0; }

    /* Trust bar below hero */
    .trust-bar {
      background: var(--sand);
      border-bottom: 1px solid var(--sand-dk);
      padding: 16px 24px;
    }
    .trust-bar-inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; align-items: center; justify-content: center;
      gap: 32px; flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: 8px;
      font-size: 13px; font-weight: 600; color: var(--stone-md);
    }
    .trust-item .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--terra); flex-shrink: 0; }


    /* ─── PROGRAMS ─── */
    .programs { padding: 80px 0; background: var(--white); }
    .section-header { margin-bottom: 48px; }
    .section-header h2 { font-size: clamp(28px, 4vw, 42px); color: var(--stone-dk); margin-bottom: 10px; }
    .section-header p { font-size: 17px; color: var(--ink-soft); max-width: 520px; }
    .programs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .program-card {
      background: var(--sand-lt); border: 1.5px solid var(--sand-dk);
      border-radius: 20px; padding: 28px;
      transition: all .25s; cursor: pointer;
      display: flex; flex-direction: column;
    }
    .program-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(61,53,48,.12);
      border-color: var(--terra); background: #fff;
    }
    .program-icon {
      width: 48px; height: 48px; border-radius: 14px;
      background: var(--sand); display: flex; align-items: center; justify-content: center;
      font-size: 22px; margin-bottom: 18px; transition: background .25s;
    }
    .program-card:hover .program-icon { background: var(--terra-lt); }
    .program-tag {
      margin-left: auto; font-size: 11px; font-weight: 700;
      color: var(--terra); background: var(--terra-lt);
      padding: 4px 10px; border-radius: 100px;
      border: 1px solid rgba(200,104,58,.25);
    }
    .program-card h3 { font-size: 20px; color: var(--stone-dk); margin-bottom: 8px; }
    .program-card p { font-size: 14px; color: var(--ink-soft); line-height: 1.65; flex: 1; margin-bottom: 20px; }
    .program-link {
      display: flex; align-items: center; gap: 6px;
      font-size: 13.5px; font-weight: 700; color: var(--terra);
      transition: gap .2s;
    }
    .program-card:hover .program-link { gap: 10px; }


    /* ─── WAVE DIVIDER ─── */
    .wave { display: block; width: 100%; line-height: 0; }


    /* ─── TRUST PILLARS ─── */
    .trust-pillars {
      padding: 80px 0 100px;
      background: var(--stone);
      position: relative; overflow: hidden;
    }
    .trust-pillars::before {
      content: '';
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        45deg, transparent, transparent 40px,
        rgba(255,255,255,.015) 40px, rgba(255,255,255,.015) 41px
      );
    }
    .trust-pillars-inner { position: relative; z-index: 1; }
    .trust-pillars h2 { font-size: clamp(26px, 3.5vw, 40px); color: #fff; text-align: center; margin-bottom: 10px; }
    .trust-pillars .sub { font-size: 17px; color: rgba(255,255,255,.55); text-align: center; margin-bottom: 56px; }
    .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .pillar { text-align: center; }
    .pillar-icon {
      width: 64px; height: 64px; border-radius: 50%;
      background: var(--terra); margin: 0 auto 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 26px;
      box-shadow: 0 8px 24px rgba(200,104,58,.4);
    }
    .pillar h3 { font-size: 20px; color: #fff; margin-bottom: 10px; }
    .pillar p { font-size: 14px; color: rgba(255,255,255,.6); line-height: 1.7; max-width: 260px; margin: 0 auto; }


    /* ─── WHAT WE TREAT ─── */
    .conditions { padding: 80px 0; background: var(--stone-lt); }
    .conditions h2 { font-size: clamp(26px, 3.5vw, 40px); color: var(--stone-dk); text-align: center; margin-bottom: 10px; }
    .conditions .sub { font-size: 17px; color: var(--ink-soft); text-align: center; margin-bottom: 48px; }
    .conditions-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .condition-card {
      background: #fff; border: 1.5px solid #e8e3de;
      border-radius: 18px; padding: 28px 20px;
      text-align: center; transition: all .25s; cursor: pointer;
    }
    .condition-card:hover {
      border-color: var(--terra); background: var(--terra-lt);
      transform: translateY(-3px); box-shadow: 0 8px 24px rgba(200,104,58,.12);
    }
    .condition-card .icon { font-size: 32px; margin-bottom: 12px; }
    .condition-card span { font-size: 14px; font-weight: 600; color: var(--stone-md); }


    /* ─── MEET LINDA ─── */
    .meet-linda {
      padding: 80px 0; background: var(--water-dk);
      position: relative; overflow: hidden;
    }
    .meet-linda::after {
      content: '';
      position: absolute; top: -80px; right: -80px;
      width: 400px; height: 400px;
      background: var(--water); opacity: .12;
      border-radius: 50%; blur: 40px;
    }
    .meet-linda-inner { position: relative; z-index: 1; max-width: 680px; }
    .meet-linda .eyebrow {
      display: flex; align-items: center; gap: 8px;
      color: var(--terra); font-size: 13px; font-weight: 600;
      letter-spacing: .05em; text-transform: uppercase; margin-bottom: 20px;
    }
    .meet-linda h2 { font-size: clamp(24px, 3.5vw, 38px); color: #fff; margin-bottom: 16px; line-height: 1.3; }
    .meet-linda p { font-size: 17px; color: rgba(255,255,255,.65); line-height: 1.75; margin-bottom: 28px; }
    .meet-linda a {
      display: inline-flex; align-items: center; gap: 8px;
      color: var(--terra); font-size: 14px; font-weight: 700;
      transition: gap .2s;
    }
    .meet-linda a:hover { gap: 14px; }


    /* ─── ADMISSIONS STEPS ─── */
    .admissions { padding: 80px 0; background: #fff; }
    .admissions h2 { font-size: clamp(26px, 3.5vw, 40px); color: var(--stone-dk); text-align: center; margin-bottom: 10px; }
    .admissions .sub { font-size: 17px; color: var(--ink-soft); text-align: center; margin-bottom: 56px; }
    .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; position: relative; margin-bottom: 44px; }
    .steps-grid::before {
      content: ''; position: absolute;
      top: 24px; left: calc(12.5% + 24px); right: calc(12.5% + 24px);
      height: 2px; background: linear-gradient(90deg, var(--terra), var(--sand-dk));
      opacity: .3;
    }
    .step { text-align: left; }
    .step-num {
      width: 48px; height: 48px; border-radius: 50%;
      background: var(--terra); color: #fff;
      font-size: 14px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 16px;
      box-shadow: 0 4px 14px rgba(200,104,58,.35);
    }
    .step h3 { font-size: 16px; font-family: 'Inter', sans-serif; font-weight: 700; color: var(--stone-dk); margin-bottom: 6px; }
    .step p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.65; }
    .admissions-cta { text-align: center; }


    /* ─── DONATIONS ─── */
    .donations {
      padding: 80px 0;
      background: linear-gradient(160deg, var(--sand) 0%, var(--sand-lt) 100%);
      position: relative; overflow: hidden;
    }
    .donations::before {
      content: '';
      position: absolute; top: -100px; right: -100px;
      width: 500px; height: 500px;
      background: var(--sand-dk); opacity: .3;
      border-radius: 50%;
    }
    .donations-header { text-align: center; max-width: 640px; margin: 0 auto 16px; position: relative; }
    .donations-header h2 { font-size: clamp(26px, 3.5vw, 40px); color: var(--stone-dk); margin-bottom: 12px; }
    .donations-header p { font-size: 17px; color: var(--ink-mid); line-height: 1.7; }

    /* Photo strip */
    .facility-photos {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
      margin: 40px 0; position: relative;
    }
    .facility-photos img {
      border-radius: 14px; width: 100%; height: 180px;
      object-fit: cover; object-position: center;
      box-shadow: 0 4px 16px rgba(0,0,0,.12);
      transition: transform .25s;
    }
    .facility-photos img:hover { transform: scale(1.02); }
    .facility-photos img:nth-child(1) { height: 200px; }
    .facility-photos img:nth-child(3) { object-position: center top; }

    .donations-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
      position: relative; margin-bottom: 32px;
    }
    .donation-card {
      background: #fff; border: 1.5px solid var(--sand-dk);
      border-radius: 18px; padding: 24px;
      transition: all .2s;
    }
    .donation-card:hover { box-shadow: 0 8px 24px rgba(61,53,48,.1); transform: translateY(-2px); }
    .donation-card.featured { border-color: var(--stone-md); border-width: 2px; }
    .donation-card-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
    .donation-card .icon { font-size: 28px; }
    .donation-card .badge {
      font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      color: var(--stone); background: var(--stone-lt); border: 1px solid #d4cbc3;
      padding: 4px 10px; border-radius: 100px;
    }
    .donation-card h3 { font-size: 17px; color: var(--stone-dk); margin-bottom: 10px; }
    .donation-card ul { list-style: none; }
    .donation-card ul li {
      display: flex; align-items: center; gap: 8px;
      font-size: 13px; color: var(--ink-mid); padding: 3px 0;
    }
    .donation-card ul li::before {
      content: ''; width: 5px; height: 5px; border-radius: 50%;
      background: var(--terra); flex-shrink: 0;
    }

    /* Donation CTA block */
    .donation-cta {
      background: var(--stone); border-radius: 20px;
      padding: 48px 40px; text-align: center;
      position: relative; overflow: hidden;
    }
    .donation-cta::before {
      content: '';
      position: absolute; top: -60px; left: 50%; transform: translateX(-50%);
      width: 400px; height: 200px;
      background: radial-gradient(ellipse, rgba(200,104,58,.15), transparent 70%);
    }
    .donation-cta h3 { font-size: 28px; color: #fff; margin-bottom: 10px; position: relative; }
    .donation-cta p { font-size: 16px; color: rgba(255,255,255,.55); margin-bottom: 28px; max-width: 480px; margin-left: auto; margin-right: auto; position: relative; }
    .donation-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; position: relative; }


    /* ─── QUOTE ─── */
    .quote-section {
      padding: 80px 0;
      background: var(--moss);
      position: relative; overflow: hidden;
    }
    .quote-section::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% -20%, rgba(255,255,255,.06), transparent 60%);
    }
    .quote-inner { position: relative; text-align: center; max-width: 760px; margin: 0 auto; }
    .quote-mark {
      font-family: 'Lora', Georgia, serif;
      font-size: 80px; line-height: .8;
      color: var(--terra); margin-bottom: 8px;
      opacity: .7;
    }
    .quote-inner blockquote {
      font-family: 'Lora', Georgia, serif;
      font-size: clamp(20px, 3vw, 28px);
      font-style: italic; font-weight: 400;
      color: #fff; line-height: 1.6;
      margin-bottom: 24px;
    }
    .quote-inner cite {
      font-style: normal; font-size: 14px;
      font-weight: 600; color: rgba(255,255,255,.5);
      letter-spacing: .04em;
    }
    .quote-divider {
      width: 48px; height: 3px; background: var(--terra);
      border-radius: 2px; margin: 20px auto 0;
    }


    /* ─── FAQ ─── */
    .faq-section { padding: 80px 0; background: var(--sand-lt); }
    .faq-section h2 { font-size: clamp(26px, 3.5vw, 40px); color: var(--stone-dk); text-align: center; margin-bottom: 48px; }
    .faq-list { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
    .faq-item {
      background: #fff; border: 1.5px solid #e8e3de;
      border-radius: 14px; overflow: hidden;
    }
    .faq-q {
      width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
      padding: 18px 22px; background: none; border: none; cursor: pointer;
      font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600;
      color: var(--stone-dk); text-align: left; transition: background .15s;
    }
    .faq-q:hover { background: var(--stone-lt); }
    .faq-q svg { width: 18px; height: 18px; color: var(--terra); flex-shrink: 0; transition: transform .25s; }
    .faq-a { padding: 0 22px 18px; font-size: 14px; color: var(--ink-soft); line-height: 1.7; display: none; }
    .faq-item.open .faq-a { display: block; }
    .faq-item.open .faq-q svg { transform: rotate(180deg); }
    .faq-item.open { border-color: var(--terra); }
    .faq-more { text-align: center; margin-top: 28px; }
    .faq-more a {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 14px; font-weight: 700; color: var(--terra);
      transition: gap .2s;
    }
    .faq-more a:hover { gap: 10px; }


    /* ─── FINAL CTA ─── */
    .final-cta {
      padding: 80px 0;
      background: var(--stone-dk);
      position: relative; overflow: hidden;
    }
    .final-cta::before {
      content: '';
      position: absolute; bottom: -80px; left: 50%; transform: translateX(-50%);
      width: 600px; height: 300px;
      background: radial-gradient(ellipse, rgba(200,104,58,.12), transparent 70%);
    }
    .final-cta-inner { position: relative; text-align: center; }
    .final-cta h2 { font-size: clamp(28px, 4vw, 48px); color: #fff; margin-bottom: 12px; }
    .final-cta p { font-size: 18px; color: rgba(255,255,255,.55); margin-bottom: 36px; max-width: 480px; margin-left: auto; margin-right: auto; }
    .final-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px; }
    .final-cta-privacy {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      font-size: 13px; color: rgba(255,255,255,.35);
    }
    .final-cta-privacy svg { width: 13px; height: 13px; color: var(--terra); }


    /* ─── FOOTER ─── */
    footer { background: #1a1612; }
    .footer-crisis {
      background: var(--stone); padding: 12px 24px;
      text-align: center; font-size: 13px; color: rgba(255,255,255,.6);
    }
    .footer-crisis a { color: var(--gold); font-weight: 700; }
    .footer-main { padding: 56px 24px 40px; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; max-width: 1200px; margin: 0 auto; }
    .footer-brand img { height: 52px; width: auto; margin-bottom: 16px; filter: brightness(0) invert(1); opacity: .85; }
    .footer-brand p { font-size: 13px; color: rgba(255,255,255,.4); line-height: 1.7; margin-bottom: 20px; }
    .footer-contact { display: flex; flex-direction: column; gap: 8px; }
    .footer-contact a { display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(255,255,255,.45); transition: color .15s; }
    .footer-contact a:hover { color: rgba(255,255,255,.8); }
