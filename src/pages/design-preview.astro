    .q-heal p{font-family:'Dancing Script',cursive;font-size:26px;color:var(--gold)}

    /* ══ FAQ — two-column, softer, calmer ══ */
    .faq-sec{padding:80px 0;background:linear-gradient(180deg,var(--cream) 0%,#f5ede0 100%)}
    .faq-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:64px;align-items:start}
    .faq-side .script-sub{font-family:'Dancing Script',cursive;font-size:30px;color:var(--gold);display:block;margin-bottom:4px;line-height:1.1}
    .faq-side h2{font-family:'Lora',serif;font-size:clamp(30px,3.8vw,44px);color:var(--navy);margin-bottom:18px;line-height:1.15;letter-spacing:-.01em}
