    .f-tagline{font-family:'Dancing Script',cursive;font-size:17px;color:rgba(255,255,255,.35);margin-bottom:8px;line-height:1.2}
    .f-brand p{font-size:12.5px;color:rgba(255,255,255,.32);line-height:1.55;margin-bottom:10px}
    .f-contact{display:flex;flex-direction:column;gap:12px;margin-bottom:4px}
    .f-contact a{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:rgba(255,255,255,.45);transition:color .15s;line-height:1.5}
    .f-contact a svg{margin-top:2px;flex-shrink:0;color:var(--gold-lt)}
    .f-contact a:hover{color:rgba(255,255,255,.85)}
    .f-contact .phone{color:var(--gold-lt) !important;font-weight:700;font-size:14px}
    .f-col h4{font-family:'Inter',sans-serif;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.22);margin-bottom:8px}
    .f-col ul{list-style:none;display:flex;flex-direction:column;gap:5px}
    .f-col ul a{font-size:12.5px;color:rgba(255,255,255,.38);transition:color .15s;line-height:1.4}
    .f-col ul a:hover{color:rgba(255,255,255,.85)}
    .f-col .mt{margin-top:14px}
    .f-bot{max-width:1160px;margin:0 auto;border-top:1px solid rgba(255,255,255,.06);padding:12px 28px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.2)}
