---
import SiteLayout from '../../layouts/SiteLayout.astro';

const meta = {
  title: 'Conditions We Treat | Sunbright Recovery Center California',
  description:
    'Alcohol, opioids, stimulants, dual diagnosis, and trauma-rooted addiction. Evidence-based treatment for substance use disorder in Northern California.',
  primaryKeyword: 'addiction treatment california',
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'What We Treat', url: '/what-we-treat' },
];
---

<SiteLayout {...meta} breadcrumbs={breadcrumbs} activeNav="treat">
  <header class="page-header">
    <div class="wrap ph-inner">
      <span class="eyebrow">What We Treat</span>
      <h1>Addiction rarely travels <em>alone.</em></h1>
      <p class="lead">Alcohol, opioids, stimulants, dual diagnosis, and trauma-rooted addiction — we treat the whole person, not just the substance. Evidence-based addiction treatment in Northern California, close to home.</p>
      <div class="btn-row">
        <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
        <a href="/admissions" class="btn btn-ghost">Start Admissions</a>
      </div>
    </div>
  </header>

  <section class="section section--white">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Evidence-Based Care</span>
        <h2>We meet people where <em>they are.</em></h2>
        <p class="lead">At Sunbright Recovery Center in Red Bluff, CA, we understand that no two people arrive at addiction the same way. Our clinical team addresses the underlying roots — trauma, mental health, chronic pain, life circumstances — not just the symptoms on the surface.</p>
      </div>

      <div class="grid grid-3">

        <div class="card is-link">
          <div class="card-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <span class="card-tag">Alcohol Use Disorder</span>
          <h3>Alcohol Addiction</h3>
          <p>Alcohol is the most commonly misused substance in California. Our residential and outpatient programs address physical dependency, cravings, and the life patterns that keep people stuck.</p>
          <a href="/what-we-treat/alcohol" class="card-link">Learn about alcohol treatment <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>

        <div class="card is-link">
          <div class="card-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          </div>
          <span class="card-tag">Opioid Use Disorder</span>
          <h3>Opioid Addiction</h3>
          <p>From prescription painkillers to heroin and fentanyl, opioid addiction is treatable. We provide trauma-informed care, family support, and MAT referral coordination for a safe recovery path.</p>
          <a href="/what-we-treat/opioids" class="card-link">Learn about opioid treatment <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>

        <div class="card is-link">
          <div class="card-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <span class="card-tag">Co-Occurring Disorders</span>
          <h3>Dual Diagnosis</h3>
          <p>Addiction and mental health conditions — depression, anxiety, PTSD, bipolar disorder — frequently co-occur. Our dual diagnosis track, backed by Parish Health &amp; Wellness expertise, treats both at once.</p>
          <a href="/what-we-treat/dual-diagnosis" class="card-link">Learn about dual diagnosis <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>

        <div class="card is-link">
          <div class="card-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <span class="card-tag">Trauma &amp; Addiction</span>
          <h3>Trauma-Rooted Addiction</h3>
          <p>Many people use substances to manage the pain of unprocessed trauma or PTSD. Our trauma-informed model creates safety first, then helps residents do the deeper healing work.</p>
          <a href="/what-we-treat/trauma-addiction" class="card-link">Learn about trauma care <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></a>
        </div>

        <div class="card">
          <div class="card-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <span class="card-tag">Stimulant Use</span>
          <h3>Stimulant Use Disorder</h3>
          <p>Methamphetamine and cocaine use disorder responds well to structured residential care, behavioral therapy, and community support — all part of our program continuum.</p>
          <p style="font-size:13px;color:var(--soft);margin-top:10px;">Addressed within our residential &amp; outpatient programs. <a href="/programs" style="color:var(--gold-dk);font-weight:600;">View programs.</a></p>
        </div>

        <div class="card">
          <div class="card-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <span class="card-tag">Mental Health Support</span>
          <h3>Mental Health &amp; Wellness</h3>
          <p>Even when addiction is the primary concern, mental wellness is woven into every aspect of care — from individual counseling to faith-integrated group work and family involvement.</p>
          <p style="font-size:13px;color:var(--soft);margin-top:10px;">Integrated throughout all programs. <a href="/our-approach" style="color:var(--gold-dk);font-weight:600;">Our approach.</a></p>
        </div>

      </div>
    </div>
  </section>

  <section class="section section--cream section--tight">
    <div class="wrap">
      <div class="callout">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p><strong>Addiction is a medical condition — not a moral failure.</strong> Whatever substance brought you or your loved one to this page, you are in the right place. Sunbright Recovery Center provides compassionate, evidence-based care in a safe, judgment-free environment in Red Bluff, California. Serving Redding, Chico, Sacramento, and all of Tehama County.</p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">A Full Continuum of Care</span>
        <h2>The right level of care, <em>at the right time.</em></h2>
        <p class="lead">We offer a stepped care model so people can move through recovery at a pace that fits their clinical needs — from intensive residential to community-based sober living.</p>
      </div>

      <div class="features">
        <div class="feature">
          <div class="f-ic">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <div>
            <h3><a href="/programs/residential">Residential Rehab (30, 60, 90 days)</a></h3>
            <p>Immersive 24/7 care at our 16-bed center in Red Bluff. Structured days, individual therapy, group counseling, and faith-integrated programming for those who need to step fully out of their environment.</p>
          </div>
        </div>

        <div class="feature">
          <div class="f-ic">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <h3><a href="/programs/outpatient">Intensive Outpatient &amp; PHP</a></h3>
            <p>Structured daytime or evening programming that fits around work, family, and life — ideal for those stepping down from residential or who need significant support without full-time residency.</p>
          </div>
        </div>

        <div class="feature">
          <div class="f-ic">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <h3><a href="/programs/sober-living">Sober Living &amp; Aftercare</a></h3>
            <p>Community, accountability, and peer support for the long road ahead. Sober living bridges residential care and independent life, dramatically improving long-term recovery outcomes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <span class="eyebrow">Northern California Nonprofit Rehab</span>
    <h2>Recovery is possible. <em>Let's talk.</em></h2>
    <p>A private, no-pressure conversation costs nothing. Call us to ask questions, learn about your options, or help a loved one take their first step.</p>
    <div class="btn-row">
      <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
      <a href="/admissions" class="btn btn-ghost">How Admissions Works</a>
    </div>
  </section>
</SiteLayout>
