---
import SiteLayout from '../layouts/SiteLayout.astro';
import { faqPageSchema } from '../schema/faqPage';

const meta = {
  title: 'Frequently Asked Questions | Sunbright Recovery Center',
  description:
    'Common questions about rehab cost, length, privacy, insurance, what to bring, and what to expect at Sunbright Recovery Center in Northern California.',
  primaryKeyword: 'rehab faq',
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'FAQs', url: '/faqs' },
];

const faqsCost = [
  {
    question: 'How much does residential treatment at Sunbright cost?',
    answer:
      'Program fees vary depending on the length of stay (30, 60, or 90 days) and the level of care. We are transparent about our rates and will provide a full cost breakdown during the admissions conversation — no surprises. As a 501(c)(3) nonprofit, our fees are structured to cover care, not to generate profit or shareholder returns. Call (530) 528-2342 or email info@sunbrightrecovery.org for current pricing.',
  },
  {
    question: 'Is treatment free?',
    answer:
      'Treatment is not free — providing quality, 24/7 residential care involves real costs. But we work hard to make it as accessible as possible. As a nonprofit, we do not charge beyond what is needed to sustain the program. We accept private pay today, we work to keep recovery accessible, and we encourage you to call to discuss your specific financial situation. We will always be honest with you about what is and isn\'t possible.',
  },
  {
    question: 'Does Sunbright accept insurance?',
    answer:
      'Not yet. Sunbright is private pay at this time — we are not currently in-network with any insurance plans. As a nonprofit, we are working through the credentialing process so we can accept coverage in the future. Call us at (530) 528-2342 to talk through private-pay options, and see our Insurance & Payment page for the latest. We will never promise coverage we cannot confirm.',
  },
  {
    question: 'What payment methods are accepted?',
    answer:
      'We accept private pay (cash, check, wire transfer, and major credit/debit cards). Sliding-scale and payment plan options may be available depending on financial need — ask our admissions team. We are a nonprofit, and we take financial accessibility seriously.',
  },
];

const faqsProgram = [
  {
    question: 'How long is the residential program?',
    answer:
      'We offer 30-day, 60-day, and 90-day residential programs. The right length depends on the severity and duration of the addiction, the presence of co-occurring mental health conditions, prior treatment history, and how a person is responding to treatment. Our clinical team will recommend a length during the intake assessment, and we can adjust as treatment progresses. Longer stays are generally associated with better long-term outcomes.',
  },
  {
    question: 'What happens after residential treatment — is there aftercare?',
    answer:
      'Yes. Discharge without a continuing-care plan is one of the most common reasons people relapse. Before you leave Sunbright, we build an aftercare plan that may include our sober-living program, intensive outpatient (IOP), outpatient therapy, community support groups (AA, NA, SMART Recovery), and ongoing check-ins. Learn more about our sober-living and outpatient options at /programs/sober-living and /programs/outpatient.',
  },
  {
    question: 'Does Sunbright provide medical detox?',
    answer:
      'Sunbright is a residential treatment center, not a medical detox facility. If a medically supervised detox is needed — for alcohol withdrawal, opioid dependence, or other substances where withdrawal can be dangerous — we will connect you with a licensed detox provider and coordinate a warm handoff to Sunbright immediately after. Please do not attempt to stop alcohol or benzodiazepine use abruptly without medical supervision; withdrawal from these substances can be life-threatening.',
  },
  {
    question: 'What is a typical day like at Sunbright?',
    answer:
      'Days are structured but not regimented to the point of feeling institutional. A typical day includes individual counseling sessions, group therapy, life-skills workshops, time for reflection or journaling, meals together, recreation time, and — for those who want it — faith-integrated activities like prayer, meditation, or spiritual reading. Structure is intentional: routine is one of the foundations of early recovery.',
  },
  {
    question: 'Is Sunbright co-ed?',
    answer:
      'Yes. Sunbright is a co-ed center, serving both men and women within our 16-bed facility. We maintain appropriate structure and boundaries within the residential environment. If you have questions about gender-specific programming or accommodations, please contact our admissions team.',
  },
];

const faqsPrivacyAccess = [
  {
    question: 'Is my treatment private? Who will know I\'m here?',
    answer:
      'Your privacy is protected by federal law (42 CFR Part 2, which governs substance use treatment records, and HIPAA). We cannot confirm or deny that you are in our program to anyone without your written consent — including family members, employers, or law enforcement, except in specific legally defined circumstances. Your records are kept confidential. We take this seriously.',
  },
  {
    question: 'Can I have my phone while I\'m in treatment?',
    answer:
      'Phone and device policies are part of the clinical structure of the program. In the early days of treatment, limiting screen time and outside contact helps residents settle in, reduce anxiety triggers, and focus on the work of recovery. We will share our specific policy during the admissions process and during your arrival orientation. Most residents appreciate the structure once they\'re in it.',
  },
  {
    question: 'Can family members visit?',
    answer:
      'Yes, with appropriate scheduling and within our visitation guidelines. We strongly encourage family involvement at the right time — typically after an initial settling-in period. Family therapy sessions, when available and consented to by the resident, are a structured and clinically guided way for families to engage. Visit our family resources page at /family-resources for more guidance on supporting your loved one.',
  },
];

const faqsFaithAndLocation = [
  {
    question: 'Is Sunbright a religious program? Do I have to participate in faith activities?',
    answer:
      'Sunbright is a faith-integrated program — meaning faith is one of the tools available to support recovery, for those who want it. Many people find that spiritual practice — prayer, meditation, community, a sense of meaning — is a powerful part of their healing. But faith is never required, imposed, or used as a condition of participation. You will not be asked to convert, attend church, or pray as part of treatment. The spiritual dimension is offered, not mandated.',
  },
  {
    question: 'Where is Sunbright located? Who do you serve?',
    answer:
      'Sunbright Recovery Center is located at 22425 Sunbright Ave, Red Bluff, CA 96080, in Tehama County in Northern California. We serve people from across the region — Red Bluff, Redding, Chico, Sacramento, and surrounding communities — who are looking for quality residential addiction treatment without driving to the Bay Area or Southern California.',
  },
  {
    question: 'What makes a nonprofit treatment center different?',
    answer:
      'Most residential rehabs in California are for-profit businesses — many owned by national chains or private equity firms — where revenue goals influence clinical decisions. As a 501(c)(3) nonprofit, Sunbright has no investors, no profit motive, and no earnings calls. Every dollar from program fees, donations, and grants goes back into care. Our only goal is your recovery. That is a structural difference that matters.',
  },
];

const faqsAdmissions = [
  {
    question: 'What should I bring to residential treatment?',
    answer:
      'We provide a detailed packing list during the admissions process. Generally: comfortable clothing for 30–90 days (layered, as seasons can shift in Northern California), personal hygiene items (no alcohol-based products), prescription medications in original labeled bottles, a journal if you like to write, and a small amount of cash for personal items. We do not allow: alcohol or drugs (obviously), weapons, substances in unmarked containers, or devices that may disrupt the therapeutic environment. Ask our admissions team for the complete list.',
  },
  {
    question: 'How do I start the admissions process?',
    answer:
      'Call us at (530) 528-2342 or email info@sunbrightrecovery.org. Our admissions team will have a private, no-pressure conversation with you or your loved one — listening to what\'s happening, answering questions, and helping you understand whether Sunbright is the right fit. If it is, we\'ll walk you through the assessment, paperwork, and arrival process. If it\'s not, we\'ll help point you toward options that are. Learn more at /admissions.',
  },
];

const allFaqs = [...faqsCost, ...faqsProgram, ...faqsPrivacyAccess, ...faqsFaithAndLocation, ...faqsAdmissions];
const schema = faqPageSchema(allFaqs);
---

<SiteLayout {...meta} breadcrumbs={breadcrumbs} schema={schema}>
  <header class="page-header">
    <div class="wrap ph-inner">
      <span class="eyebrow">Frequently Asked Questions</span>
      <h1>Your <em>rehab questions</em> answered honestly.</h1>
      <p class="lead">Before you call, it helps to know what to expect. We've gathered the questions families and individuals ask us most — about cost, length, privacy, insurance, faith, and what it's actually like to be in treatment at Sunbright. If you don't see your question here, just call or email us.</p>
      <div class="btn-row">
        <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
        <a href="/admissions" class="btn btn-ghost">How Admissions Works</a>
      </div>
    </div>
  </header>

  <!-- Cost & Payment -->
  <section class="section section--white">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow">Cost &amp; Payment</span>
        <h2>What does <em>treatment cost</em> — and how do I pay?</h2>
        <p class="lead">Money is one of the first things people worry about when considering treatment. We believe in honest, upfront answers — no bait-and-switch, no hidden fees.</p>
      </div>
      <div class="faq">
        {faqsCost.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-body">{f.answer}</div>
          </details>
        ))}
      </div>
      <div class="callout" style="margin-top:28px;max-width:820px">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p><strong>Talking through cost:</strong> Sunbright is private pay at this time. Call us at <a href="tel:+15305282342">(530) 528-2342</a> and we'll give you an honest picture of costs and options before you commit to anything. See also: <a href="/insurance">Insurance &amp; Payment</a>.</p>
      </div>
    </div>
  </section>

  <!-- Program -->
  <section class="section section--cream">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow">The Program</span>
        <h2>What does treatment at Sunbright <em>actually look like?</em></h2>
        <p class="lead">Understanding what you're signing up for before you arrive makes the transition easier. Here's what to expect from our programs.</p>
      </div>
      <div class="faq">
        {faqsProgram.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-body">{f.answer}</div>
          </details>
        ))}
      </div>
      <div class="callout navy" style="margin-top:28px;max-width:820px">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p><strong>Explore our programs in detail:</strong> <a href="/programs/residential">Residential Rehab</a> · <a href="/programs/outpatient">Intensive Outpatient (IOP)</a> · <a href="/programs/sober-living">Sober Living &amp; Aftercare</a>. Or <a href="/our-approach">read about our clinical approach</a>.</p>
      </div>
    </div>
  </section>

  <!-- Privacy & Access -->
  <section class="section section--white">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow">Privacy &amp; Access</span>
        <h2>Who will know — and what <em>are your rights?</em></h2>
        <p class="lead">Privacy concerns stop a lot of people from seeking help. The protections are real — here's what the law says and how we apply it.</p>
      </div>
      <div class="faq">
        {faqsPrivacyAccess.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-body">{f.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Faith & Location -->
  <section class="section section--cream">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow">Faith, Location &amp; About Us</span>
        <h2>Who we are and <em>where we stand.</em></h2>
      </div>
      <div class="faq">
        {faqsFaithAndLocation.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-body">{f.answer}</div>
          </details>
        ))}
      </div>
      <div class="callout" style="margin-top:28px;max-width:820px">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <p><strong>Sunbright Recovery Center</strong> · 22425 Sunbright Ave, Red Bluff, CA 96080 · <a href="tel:+15305282342">(530) 528-2342</a> · <a href="mailto:info@sunbrightrecovery.org">info@sunbrightrecovery.org</a></p>
      </div>
    </div>
  </section>

  <!-- Admissions -->
  <section class="section section--white">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow">Getting Started</span>
        <h2>What to bring and <em>how to begin.</em></h2>
      </div>
      <div class="faq">
        {faqsAdmissions.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-body">{f.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--navy section--tight">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Quick Reference</span>
        <h2>What we can <em>confirm right now.</em></h2>
      </div>
      <ul class="checks grid grid-2">
        <li><strong>16-bed co-ed residential center</strong> — intimate, not institutional.</li>
        <li><strong>30, 60, and 90-day programs</strong> — tailored to clinical need, not arbitrary timelines.</li>
        <li><strong>501(c)(3) nonprofit</strong> — care, not profits, is the mission.</li>
        <li><strong>Private pay accepted today</strong> — Private pay accepted today.</li>
        <li><strong>Faith-integrated, never required</strong> — the spiritual dimension is a resource, not a rule.</li>
        <li><strong>Northern California</strong> — serving Red Bluff, Redding, Chico, Sacramento, and Tehama County.</li>
        <li><strong>Medical detox via referral</strong> — we coordinate and receive you after detox is complete.</li>
        <li><strong>Aftercare included</strong> — discharge without a continuing-care plan is not an option here.</li>
      </ul>
    </div>
  </section>

  <section class="section section--cream section--tight">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Still Have Questions?</span>
        <h2>Explore more or <em>talk to us directly.</em></h2>
      </div>
      <div class="grid grid-3">
        <a href="/about" class="card is-link">
          <div class="card-tag">About</div>
          <h3>About Sunbright</h3>
          <p>Our story, our nonprofit model, and why we built a recovery center in Red Bluff.</p>
          <span class="card-link">Read more <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/our-approach" class="card is-link">
          <div class="card-tag">Clinical</div>
          <h3>Our Approach</h3>
          <p>How we integrate evidence-based therapy, trauma-informed care, and optional faith support.</p>
          <span class="card-link">Read more <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/admissions" class="card is-link">
          <div class="card-tag">Next Step</div>
          <h3>Admissions Process</h3>
          <p>Step-by-step: from first call to first day. What to expect and how to prepare.</p>
          <span class="card-link">How it works <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <span class="eyebrow">Ready to take the next step?</span>
    <h2>A private conversation <em>costs nothing.</em></h2>
    <p>Call us and you'll speak with a real member of our team — not a call center, not a script. We'll listen, answer your questions, and help you figure out whether Sunbright is the right fit. No pressure, no commitment.</p>
    <div class="btn-row">
      <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
      <a href="/contact" class="btn btn-ghost">Send Us a Message</a>
    </div>
  </section>
</SiteLayout>
