---
// Get Involved — Donations, Volunteers & Sponsors
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Get Involved — Sunbright Recovery Center</title>
  <meta name="description" content="Donate, adopt a room, sponsor a space, or volunteer. Every dollar goes directly toward opening Sunbright Recovery Center in Red Bluff, CA."/>
  <meta name="robots" content="index,follow"/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="Sunbright Recovery Center"/>
  <meta property="og:title" content="Get Involved — Sunbright Recovery Center"/>
  <meta property="og:description" content="Donate, adopt a room, sponsor a space, or volunteer. Every dollar goes directly toward opening Sunbright Recovery Center in Red Bluff, CA."/>
  <meta property="og:url" content="https://sunbright-recovery.pages.dev/get-involved"/>
  <meta property="og:image" content="https://sunbright-recovery.pages.dev/images/facility-wide.jpg"/>
  <meta property="og:image:alt" content="Sunbright Recovery Center, Red Bluff, CA"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --navy:#1a2e5a;--navy-dk:#101d3a;--navy-mid:#254080;--navy-lt:#edf1fa;
      --gold:#c8900a;--gold-lt:#f0c040;--gold-pale:#fdf5e0;--gold-bg:#fef9ee;
      --cream:#ede4d0;--cream-dk:#ddd2b8;--white:#fff;
      --text:#1a2438;--mid:#3d4a5c;--soft:#6b7a8d;--border:#e2d9c8;
    }
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.6}
    h1,h2,h3,h4{font-family:'Lora',Georgia,serif;line-height:1.2}
    a{text-decoration:none;color:inherit}
    img{display:block;max-width:100%}
    .wrap{max-width:1160px;margin:0 auto;padding:0 28px}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;background:transparent;backdrop-filter:none;border-bottom:1px solid transparent;box-shadow:none;transition:background .3s,backdrop-filter .3s,border-color .3s,box-shadow .3s}
    nav.nav-scrolled{background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(26,46,90,.08)}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;height:110px;overflow:hidden;gap:0}
    .nav-in img{height:108px;width:auto;flex-shrink:0;filter:brightness(0) invert(1);opacity:.95;transition:filter .3s,opacity .3s}
    nav.nav-scrolled .nav-in img{filter:none;opacity:1}
    .nav-links{display:flex;align-items:center;gap:4px;margin-left:20px}
    .nav-links a{padding:8px 16px;border-radius:8px;font-size:14px;font-weight:600;color:rgba(255,255,255,.9);transition:all .2s;display:flex;align-items:center;gap:7px}
    .nav-links a svg{width:16px;height:16px;flex-shrink:0;opacity:.8}
    .nav-links a:hover,.nav-links a.active{color:var(--gold-lt);background:rgba(255,255,255,.1)}
    .nav-links a:hover svg,.nav-links a.active svg{opacity:1}
    nav.nav-scrolled .nav-links a{color:var(--navy)}
    nav.nav-scrolled .nav-links a:hover,nav.nav-scrolled .nav-links a.active{color:#a87008;background:var(--navy-lt)}
    .nav-cta{display:flex;align-items:center;gap:7px;background:#fff;color:var(--navy);padding:11px 20px;border-radius:8px;font-size:14px;font-weight:700;border:none;box-shadow:none;transition:all .25s;margin-left:auto}
    .nav-cta:hover{background:var(--cream);color:var(--navy-dk);transform:translateY(-1px)}
    nav.nav-scrolled .nav-cta{background:var(--gold);color:#fff;box-shadow:0 2px 12px rgba(200,144,10,.35)}
    nav.nav-scrolled .nav-cta:hover{background:#a87008}

    /* PAGE HEADER */
    .page-header{padding:160px 0 72px;background:linear-gradient(160deg,var(--navy-dk) 0%,var(--navy) 60%,#254080 100%);position:relative;overflow:hidden}
    .page-header::before{content:'';position:absolute;top:-80px;right:-80px;width:500px;height:500px;background:radial-gradient(ellipse,rgba(200,144,10,.1),transparent 65%);pointer-events:none}
    .page-header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold-lt),transparent)}
    .ph-eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:10px;display:block}
    .ph-h1{font-size:clamp(32px,4.5vw,52px);color:#fff;letter-spacing:-.02em;margin-bottom:14px;line-height:1.1}
    .ph-h1 em{font-style:italic;color:var(--gold-lt)}
    .ph-sub{font-size:16px;color:rgba(255,255,255,.6);line-height:1.75;max-width:560px}

    /* HOW TO GIVE */
    .how-section{padding:72px 0 48px}
    .sec-eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:block}
    .sec-h2{font-size:clamp(26px,3vw,36px);color:var(--navy);letter-spacing:-.02em;margin-bottom:12px}
    .sec-sub{font-size:15px;color:var(--mid);line-height:1.75;max-width:560px;margin-bottom:36px}

    /* PAYMENT METHODS */
    .donate-now{background:var(--navy);border-radius:20px;padding:44px 40px;margin-bottom:48px;position:relative;overflow:hidden}
    .donate-now::before{content:'';position:absolute;top:-40px;right:-40px;width:300px;height:300px;background:radial-gradient(ellipse,rgba(200,144,10,.12),transparent 65%);pointer-events:none}
    .dn-head{position:relative;margin-bottom:28px}
    .dn-head h3{font-family:'Lora',serif;font-size:clamp(22px,2.8vw,32px);color:#fff;margin-bottom:8px}
    .dn-head p{font-size:15px;color:rgba(255,255,255,.55);line-height:1.6;max-width:500px}
    .method-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
    @media(max-width:860px){.method-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:480px){.method-grid{grid-template-columns:1fr}}
    .method-card{background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.2);border-radius:14px;padding:22px 20px;display:flex;flex-direction:column;align-items:center;gap:10px;transition:all .25s;text-align:center}
    a.method-card{cursor:pointer}
    a.method-card:hover{background:rgba(255,255,255,.14);border-color:rgba(240,192,64,.5);transform:translateY(-3px)}
    .method-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px}
    .venmo-ico{background:#3d95ce;color:#fff}
    .cash-ico{background:#00c244;color:#fff}
    .square-ico{background:#fff;color:#000}
    .check-ico{background:rgba(200,144,10,.15);color:var(--gold-lt)}
    .method-name{font-size:14px;font-weight:700;color:#fff}
    .method-handle{font-size:12px;color:rgba(255,255,255,.55);font-weight:600}
    .method-desc{font-size:11.5px;color:rgba(255,255,255,.38);line-height:1.4}
    .dn-note{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:rgba(255,255,255,.4);line-height:1.6;position:relative}
    .dn-note svg{flex-shrink:0;color:var(--gold-lt);margin-top:2px}
    .dn-note a{color:rgba(255,255,255,.65);font-weight:700;transition:color .2s}
    .dn-note a:hover{color:var(--gold-lt)}

    /* DONATION ROWS */
    .don-section{padding:0 0 64px}
    .row-label{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:18px;padding-bottom:10px;border-bottom:1.5px solid var(--border);display:block}
    .don-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:40px}
    .don-grid.two{grid-template-columns:repeat(2,1fr)}
    @media(max-width:760px){.don-grid,.don-grid.two{grid-template-columns:1fr}}
    .don-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:28px 24px;position:relative;transition:box-shadow .2s}
    .don-card:hover{box-shadow:0 8px 28px rgba(26,46,90,.1)}
    .don-card.feat{border-color:var(--gold);background:var(--gold-pale)}
    .don-card.urgent{border-color:#e8a020;background:#fffbf2}
    .don-tag{font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:12px}
    .urgent .don-tag{color:#c07020}
    .don-icon-box{width:44px;height:44px;border-radius:11px;background:var(--navy-lt);display:flex;align-items:center;justify-content:center;margin-bottom:14px}
    .don-icon-box svg{width:22px;height:22px;color:var(--navy)}
    .feat .don-icon-box{background:rgba(200,144,10,.12)}
    .feat .don-icon-box svg{color:var(--gold)}
    .urgent .don-icon-box{background:#fff3e0}
    .urgent .don-icon-box svg{color:#c07020}
    .don-card h3{font-size:17px;color:var(--navy);margin-bottom:8px}
    .don-card p{font-size:14px;color:var(--mid);line-height:1.7}
    .don-link{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:13px;font-weight:700;color:var(--gold)}
    .don-link:hover{text-decoration:underline}

    /* PARTNERS SECTION */
    .partners-section{background:var(--navy);border-radius:24px;padding:56px 52px;margin-bottom:64px;position:relative;overflow:hidden}
    .partners-section::before{content:'';position:absolute;top:-80px;right:-80px;width:500px;height:500px;background:radial-gradient(ellipse,rgba(200,144,10,.1),transparent 65%);pointer-events:none}
    .partners-section::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold-lt),transparent)}
    .pb-head{position:relative;max-width:620px;margin-bottom:36px}
    .pb-eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block}
    .pb-head h3{font-family:'Lora',serif;font-size:clamp(24px,3vw,34px);color:#fff;margin-bottom:10px;line-height:1.2}
    .pb-head p{font-size:15px;color:rgba(255,255,255,.55);line-height:1.75}
    .pb-tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:36px;position:relative}
    @media(max-width:760px){.pb-tiers{grid-template-columns:1fr}}
    .pb-tier{background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.12);border-radius:16px;padding:26px 24px;transition:all .25s}
    .pb-tier:hover{background:rgba(255,255,255,.1);border-color:rgba(240,192,64,.4)}
    .pb-tier-icon{width:44px;height:44px;border-radius:11px;background:rgba(240,192,64,.12);border:1px solid rgba(240,192,64,.25);display:flex;align-items:center;justify-content:center;margin-bottom:16px}
    .pb-tier-icon svg{width:20px;height:20px;color:var(--gold-lt)}
    .pb-tier h4{font-family:'Lora',serif;font-size:17px;color:#fff;margin-bottom:8px}
    .pb-tier p{font-size:13px;color:rgba(255,255,255,.45);line-height:1.65}
    .pb-tier ul{list-style:none;margin-top:12px;display:flex;flex-direction:column;gap:6px}
    .pb-tier ul li{font-size:12.5px;color:rgba(255,255,255,.4);padding-left:14px;position:relative;line-height:1.5}
    .pb-tier ul li::before{content:'·';position:absolute;left:0;color:var(--gold-lt)}
    .pb-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:28px;border-top:1px solid rgba(255,255,255,.1);position:relative}
    .pb-bottom p{font-size:14px;color:rgba(255,255,255,.45);line-height:1.6;max-width:480px}
    .pb-cta{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#fff;padding:13px 28px;border-radius:9px;font-size:14px;font-weight:700;white-space:nowrap;transition:all .2s;flex-shrink:0}
    .pb-cta:hover{background:#a87008;transform:translateY(-1px);box-shadow:0 8px 24px rgba(200,144,10,.35)}

    /* DONOR WALL */
    .donor-section{padding:64px 0;background:var(--cream)}
    .donor-section .wrap-inner{max-width:1160px;margin:0 auto;padding:0 28px}
    .donor-intro{max-width:600px;margin-bottom:40px}
    .donor-intro .sec-eyebrow{color:var(--navy)}
    .donor-intro .sec-h2{font-size:clamp(24px,2.8vw,34px)}
    .donor-intro p{font-size:15px;color:var(--mid);line-height:1.75}
    .donor-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:32px}
    @media(max-width:600px){.donor-grid{grid-template-columns:1fr}}
    .donor-card{background:var(--white);border:1.5px solid var(--border);border-radius:14px;padding:20px 22px;display:flex;align-items:flex-start;gap:14px}
    .donor-badge{width:44px;height:44px;border-radius:50%;background:var(--navy-lt);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:'Lora',serif;font-size:16px;font-weight:700;color:var(--navy)}
    .donor-badge.gold{background:var(--gold-pale);border:2px solid var(--gold-lt);color:var(--gold)}
    .donor-name{font-size:14.5px;font-weight:700;color:var(--navy);margin-bottom:3px}
    .donor-type{font-size:12px;color:var(--soft)}
    .donor-list{display:grid;grid-template-columns:1fr 1fr;margin-bottom:32px;background:var(--white);border:1.5px solid var(--border);border-radius:14px;overflow:hidden}
    .donor-list-item{padding:11px 20px;border-bottom:1px solid var(--border)}
    .donor-list-item:nth-last-child(-n+2){border-bottom:none}
    .donor-list-name{display:block;font-size:14px;font-weight:700;color:var(--navy);margin-bottom:2px}
    .donor-list-sub{display:block;font-size:11.5px;color:var(--soft)}
    @media(max-width:600px){.donor-list{grid-template-columns:1fr}.donor-list-item:nth-last-child(-n+2){border-bottom:1px solid var(--border)}.donor-list-item:last-child{border-bottom:none}}
    .donor-empty{background:var(--white);border:2px dashed var(--cream-dk);border-radius:16px;padding:48px 32px;text-align:center}
    .donor-empty svg{width:40px;height:40px;color:var(--cream-dk);margin:0 auto 14px}
    .donor-empty p{font-size:14px;color:var(--soft);line-height:1.7;max-width:380px;margin:0 auto}
    .donor-empty strong{color:var(--navy)}
    .donor-cta-row{text-align:center;margin-top:8px}
    .btn-donor{display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;padding:13px 28px;border-radius:9px;font-size:14px;font-weight:700;transition:all .2s}
    .btn-donor:hover{background:var(--navy-dk);transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,46,90,.25)}

    /* FOOTER */
    footer{background:var(--navy-dk)}
    .f-crisis{background:var(--navy);padding:11px 28px;text-align:center;font-size:13px;color:rgba(255,255,255,.6)}
    .f-crisis a{color:var(--gold-lt);font-weight:700;transition:color .2s}
    .f-crisis a:hover{color:#fff}
    .f-main{padding:28px 28px 6px;max-width:1160px;margin:0 auto}
    .f-grid{display:grid;grid-template-columns:140px 1.3fr 1fr 1fr 1.2fr;gap:30px;align-items:start}
    @media(max-width:880px){.f-grid{grid-template-columns:1fr 1fr;gap:26px}}
    @media(max-width:520px){.f-grid{grid-template-columns:1fr}}
    .f-brand img{width:140px;max-width:140px;height:auto;filter:brightness(0) invert(1);opacity:.95;display:block}
    .f-tagline{font-family:'Dancing Script',cursive;font-size:18px;color:var(--gold-lt);margin-bottom:8px;line-height:1.25}
    .f-brand-p{font-size:12.5px;color:rgba(255,255,255,.4);line-height:1.6;margin:0}
    .f-contact{display:flex;flex-direction:column;gap:12px;margin-bottom:4px}
    .f-contact a{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:rgba(255,255,255,.45);transition:color .15s;line-height:1.5}
    .f-contact a svg{margin-top:2px;flex-shrink:0;color:var(--gold-lt)}
    .f-contact a:hover{color:rgba(255,255,255,.85)}
    .f-contact .phone{color:var(--gold-lt) !important;font-weight:700;font-size:14px}
    .f-col h4{font-family:'Dancing Script',cursive;font-size:16px;font-weight:700;color:rgba(255,255,255,.7);margin-bottom:10px}
    .f-col ul{list-style:none;display:flex;flex-direction:column;gap:2px}
    .f-col ul a{font-size:12px;color:rgba(255,255,255,.4);transition:color .15s;line-height:1.3}
    .f-col ul a:hover{color:var(--gold-lt)}
    .f-col .mt{margin-top:10px}
    .f-bot{max-width:1160px;margin:0 auto;border-top:1px solid rgba(255,255,255,.06);padding:8px 28px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.2)}
    .f-bot a{color:rgba(255,255,255,.28);transition:color .2s}
    .f-bot a:hover{color:var(--gold-lt)}
    .f-heal{font-family:'Dancing Script',cursive;font-size:15px;color:rgba(255,255,255,.25)}
  </style>
</head>
<body>

<nav>
  <div class="nav-in">
    <a href="/"><img src="/logo.png" alt="Sunbright Recovery Center"/></a>
    <div class="nav-links">
      <a href="/about"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>About</a>
      <a href="/events"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>Events</a>
      <a href="/get-involved" class="active"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>Get Involved</a>
      <a href="/#faq"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>FAQ</a>
      <a href="/contact"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>Contact</a>
    </div>
    <a href="https://square.link/u/nmGvq3xp" target="_blank" rel="noopener" class="nav-cta">
      <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      Donate Now
    </a>
  </div>
</nav>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="wrap">
    <span class="ph-eyebrow">Get Involved</span>
    <h1 class="ph-h1">Support<br/><em>Recovery.</em></h1>
    <p class="ph-sub">Sunbright Recovery is preparing to open its doors in Red Bluff. Every donation — large or small — goes directly toward opening day and deepening the care we can offer to people in recovery.</p>
  </div>
</div>

<!-- HOW TO GIVE -->
<section class="how-section">
  <div class="wrap">
    <span class="sec-eyebrow">Give Today</span>
    <h2 class="sec-h2">Ways to Give</h2>
    <p class="sec-sub">Use any method below. All donations are processed securely and every dollar goes directly toward equipping the center and opening our doors.</p>

    <div class="donate-now">
      <div class="dn-head">
        <h3>Every Contribution Makes a Difference</h3>
        <p>Choose what works for you. Every dollar goes directly toward opening Sunbright's doors and changing lives in our community.</p>
      </div>
      <div class="method-grid">
        <a href="https://square.link/u/nmGvq3xp" target="_blank" rel="noopener" class="method-card">
          <div class="method-icon square-ico">
            <svg fill="currentColor" viewBox="0 0 24 24" width="26" height="26"><rect x="3" y="3" width="18" height="18" rx="2"/><rect x="8" y="8" width="8" height="8" rx="1" fill="white"/></svg>
          </div>
          <span class="method-name">Credit / Debit Card</span>
