---
import SiteLayout from '../layouts/SiteLayout.astro';
import { faqPageSchema } from '../schema/faqPage';

const meta = {
  title: 'Contact Sunbright Recovery Center | Red Bluff, California',
  description:
    'Call 530-528-2342 or send a private message. Sunbright Recovery Center, 22425 Sunbright Ave, Red Bluff, CA 96080. Your conversation is confidential.',
  primaryKeyword: 'sunbright recovery contact',
  activeNav: 'contact',
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact' },
];

const faqs = [
  {
    question: 'Is my message confidential?',
    answer:
      'Yes. Everything you share with us stays private. We will never disclose that you contacted us or share your information with anyone outside our clinical team. For your own protection, please do not include sensitive medical details in writing — we will cover those by phone.',
  },
  {
    question: 'How quickly will you respond?',
    answer:
      'We aim to respond to all messages within one business day. For urgent questions, calling (530) 528-2342 is always the fastest way to reach someone on our team.',
  },
  {
    question: 'Can I just call instead of filling out the form?',
    answer:
      'Absolutely. Many people prefer to call, and we welcome that. Dial (530) 528-2342 any time during business hours for a private conversation with our team. If we miss you, we will call back the same day.',
  },
];

const schema = [faqPageSchema(faqs)];
---

<SiteLayout {...meta} breadcrumbs={breadcrumbs} schema={schema}>
  <header class="page-header">
    <div class="wrap ph-inner">
      <span class="eyebrow">Get in Touch</span>
      <h1>We're here. <em>Reach out anytime.</em></h1>
      <p class="lead">Whether you are looking for help for yourself, asking questions for a loved one, or simply want to learn more — a real person will read your message and respond. Your conversation is confidential.</p>
      <div class="btn-row">
        <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
        <a href="/admissions" class="btn btn-ghost">How Admissions Works</a>
      </div>
    </div>
  </header>

  <section class="section section--white">
    <div class="wrap split">

      <!-- LEFT: contact form -->
      <div>
        <div class="prose" style="max-width:100%">
          <h2 style="margin-top:0">Send us a private message</h2>
          <p style="font-size:15px;margin-bottom:24px">Fill in a few details and we will be back in touch within one business day. Your message is confidential — please do not include sensitive medical details here; we will cover those by phone.</p>
        </div>

        <form action="mailto:info@sunbrightrecovery.org" method="post" enctype="text/plain">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
            <div>
              <label for="contact-name" style="display:block;font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--navy);margin-bottom:6px">Your Name <span style="color:var(--gold)">*</span></label>
              <input id="contact-name" type="text" name="Name" placeholder="First and last name" required
                style="width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;font-family:'Inter',sans-serif;font-size:14.5px;color:var(--text);background:var(--white);outline:none" />
            </div>
            <div>
              <label for="contact-phone" style="display:block;font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--navy);margin-bottom:6px">Phone</label>
              <input id="contact-phone" type="tel" name="Phone" placeholder="(xxx) xxx-xxxx"
                style="width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;font-family:'Inter',sans-serif;font-size:14.5px;color:var(--text);background:var(--white);outline:none" />
            </div>
          </div>

          <div style="margin-bottom:16px">
            <label for="contact-email" style="display:block;font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--navy);margin-bottom:6px">Email <span style="color:var(--gold)">*</span></label>
            <input id="contact-email" type="email" name="Email" placeholder="your@email.com" required
              style="width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;font-family:'Inter',sans-serif;font-size:14.5px;color:var(--text);background:var(--white);outline:none" />
          </div>

          <div style="margin-bottom:24px">
            <label for="contact-message" style="display:block;font-size:12.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--navy);margin-bottom:6px">How can we help? <span style="color:var(--gold)">*</span></label>
            <textarea id="contact-message" name="How can we help" rows="6" placeholder="Tell us a little about what's going on and what you're looking for. You don't need to have it all figured out." required
              style="width:100%;padding:12px 14px;border:1.5px solid var(--border);border-radius:8px;font-family:'Inter',sans-serif;font-size:14.5px;color:var(--text);background:var(--white);outline:none;resize:vertical;line-height:1.6"></textarea>
          </div>

          <div class="callout" style="margin-bottom:20px">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <p><strong>Privacy note:</strong> Your message is confidential. Please do not include sensitive medical details, diagnoses, insurance member IDs, or substance information in this form — we will cover those topics privately by phone.</p>
          </div>

          <button type="submit" class="btn btn-navy" style="width:100%;justify-content:center;padding:15px 28px;font-size:15px;border:none;cursor:pointer">
            Send Message
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" style="width:16px;height:16px"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </button>
          <p style="font-size:12px;color:var(--soft);text-align:center;margin-top:12px;line-height:1.5">We respond personally within one business day. For urgent needs, call (530) 528-2342.</p>
        </form>
      </div>

      <!-- RIGHT: contact info panel -->
      <aside class="aside">
        <h3>Reach us directly</h3>

        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <div>
            <strong style="display:block;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--soft);margin-bottom:2px">Phone</strong>
            <a href="tel:+15305282342" style="color:var(--navy);font-weight:700;font-size:15px">(530) 528-2342</a>
          </div>
        </div>

        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <div>
            <strong style="display:block;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--soft);margin-bottom:2px">Email</strong>
            <a href="mailto:info@sunbrightrecovery.org" style="color:var(--navy);font-weight:600;font-size:14px">info@sunbrightrecovery.org</a>
          </div>
        </div>

        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <div>
            <strong style="display:block;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--soft);margin-bottom:2px">Address</strong>
            <a href="https://maps.google.com/?q=22425+Sunbright+Ave+Red+Bluff+CA+96080" target="_blank" rel="noopener" style="color:var(--navy);font-size:14px;line-height:1.5">22425 Sunbright Ave<br/>Red Bluff, CA 96080</a>
          </div>
        </div>

        <div class="aside-row">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>
            <strong style="display:block;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--soft);margin-bottom:2px">Hours</strong>
            <span style="font-size:14px;color:var(--mid)">Mon – Fri, 8 am – 5 pm PT<br/>Weekend calls welcome</span>
          </div>
        </div>

        <div style="border-top:1px solid var(--border);margin:16px 0"></div>

        <p style="font-size:13.5px;color:var(--mid);line-height:1.65;margin-bottom:14px">Want to see the center before deciding? We offer private, no-pressure tours most weekdays. Call or send a message to schedule a visit.</p>
        <a href="/tour" class="btn btn-outline" style="width:100%;justify-content:center">Schedule a Tour</a>

        <div style="border-top:1px solid var(--border);margin:16px 0"></div>

        <p style="font-size:13px;color:var(--soft);line-height:1.6">Ready to talk about admissions? Visit our <a href="/admissions" style="color:var(--gold-dk);font-weight:600">admissions page</a> to learn what to expect from first call to first day.</p>
      </aside>
    </div>
  </section>

  <section class="section section--cream section--tight">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Common questions</span>
        <h2>About getting in <em>touch</em></h2>
      </div>
      <div class="faq">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <div class="faq-body">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <span class="eyebrow">You don't have to figure this out alone</span>
    <h2>One conversation can <em>change everything.</em></h2>
    <p>Call us now for a private, no-pressure conversation. We will listen, answer your questions honestly, and help you understand the options — with no obligation to do anything next.</p>
    <div class="btn-row">
      <a href="tel:+15305282342" class="btn btn-gold">Call (530) 528-2342</a>
      <a href="/admissions" class="btn btn-ghost">How Admissions Works</a>
    </div>
  </section>
</SiteLayout>
