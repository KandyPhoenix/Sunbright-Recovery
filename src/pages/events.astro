---
// Events — Fundraisers, Raffles & Community Events
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Events & Fundraisers — Sunbright Recovery Center</title>
  <meta name="description" content="Join Sunbright Recovery Center at our upcoming fundraisers and community events in Red Bluff, CA. Every event helps us open our doors."/>
  <meta name="robots" content="index,follow"/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="Sunbright Recovery Center"/>
  <meta property="og:title" content="Events &amp; Fundraisers — Sunbright Recovery Center"/>
  <meta property="og:description" content="Join Sunbright Recovery Center at our upcoming fundraisers and community events in Red Bluff, CA. Every event helps us open our doors."/>
  <meta property="og:url" content="https://www.sunbrightrecovery.org/events"/>
  <meta property="og:image" content="https://www.sunbrightrecovery.org/images/facility-wide.jpg"/>
  <meta property="og:image:alt" content="Sunbright Recovery Center, Red Bluff, CA"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --navy:#1a2e5a;--navy-dk:#101d3a;--navy-mid:#254080;--navy-lt:#edf1fa;
      --gold:#c8900a;--gold-lt:#f0c040;--gold-pale:#fdf5e0;--gold-bg:#fef9ee;
      --cream:#ede4d0;--cream-dk:#ddd2b8;--white:#fff;
      --text:#1a2438;--mid:#3d4a5c;--soft:#6b7a8d;--border:#e2d9c8;
    }
    html{scroll-behavior:smooth}
    body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.6;min-height:100vh;display:flex;flex-direction:column}
    h1,h2,h3,h4{font-family:'Lora',Georgia,serif;line-height:1.2}
    a{text-decoration:none;color:inherit}
    .wrap{max-width:1160px;margin:0 auto;padding:0 28px}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;background:transparent;backdrop-filter:none;border-bottom:1px solid transparent;box-shadow:none;transition:background .3s,backdrop-filter .3s,border-color .3s,box-shadow .3s}
    nav.nav-scrolled{background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(26,46,90,.08)}
    .nav-in{max-width:1160px;margin:0 auto;padding:0 28px;display:flex;align-items:center;height:110px;overflow:hidden;gap:0}
    .nav-in img{height:108px;width:auto;flex-shrink:0;filter:brightness(0) invert(1);opacity:.95;transition:filter .3s,opacity .3s}
    nav.nav-scrolled .nav-in img{filter:none;opacity:1}
    .nav-links{display:flex;align-items:center;gap:4px;margin-left:20px}
    .nav-links a{padding:8px 16px;border-radius:8px;font-size:14px;font-weight:600;color:rgba(255,255,255,.9);transition:all .2s;display:flex;align-items:center;gap:7px}
    .nav-links a svg{width:16px;height:16px;flex-shrink:0;opacity:.8}
    .nav-links a:hover,.nav-links a.active{color:var(--gold-lt);background:rgba(255,255,255,.1)}
    .nav-links a:hover svg,.nav-links a.active svg{opacity:1}
    nav.nav-scrolled .nav-links a{color:var(--navy)}
    nav.nav-scrolled .nav-links a:hover,nav.nav-scrolled .nav-links a.active{color:#a87008;background:var(--navy-lt)}
    .nav-cta{display:flex;align-items:center;gap:7px;background:#fff;color:var(--navy);padding:11px 20px;border-radius:8px;font-size:14px;font-weight:700;border:none;box-shadow:none;transition:all .25s;margin-left:auto}
    .nav-cta:hover{background:var(--cream);color:var(--navy-dk);transform:translateY(-1px)}
    nav.nav-scrolled .nav-cta{background:var(--gold);color:#fff}
    nav.nav-scrolled .nav-cta:hover{background:#a87008}

    /* PAGE HEADER */
    .page-header{padding:160px 0 72px;background:linear-gradient(160deg,var(--navy-dk) 0%,var(--navy) 60%,#254080 100%);position:relative;overflow:hidden}
    .page-header::before{content:'';position:absolute;top:-80px;right:-80px;width:500px;height:500px;background:radial-gradient(ellipse,rgba(200,144,10,.1),transparent 65%);pointer-events:none}
    .page-header::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold-lt),transparent)}
    .ph-eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-lt);margin-bottom:10px;display:block}
    .ph-h1{font-size:clamp(32px,4.5vw,52px);color:#fff;letter-spacing:-.02em;margin-bottom:14px;line-height:1.1}
    .ph-h1 em{font-style:italic;color:var(--gold-lt)}
    .ph-sub{font-size:16px;color:rgba(255,255,255,.6);line-height:1.75;max-width:520px}

    /* EVENTS */
    main{flex:1;padding:72px 0 80px}
    .sec-eyebrow{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:block}
    .sec-h2{font-size:clamp(24px,2.8vw,34px);color:var(--navy);letter-spacing:-.02em;margin-bottom:12px}
    .sec-sub{font-size:15px;color:var(--mid);line-height:1.75;margin-bottom:40px;max-width:580px}

    .event-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-bottom:64px}
    @media(max-width:720px){.event-grid{grid-template-columns:1fr}}

    .event-card{border:1.5px solid var(--border);border-radius:20px;overflow:hidden;transition:box-shadow .2s;display:flex;flex-direction:column}
    .event-card:hover{box-shadow:0 10px 36px rgba(26,46,90,.1)}
    .event-card.featured{border-color:var(--gold)}

    .event-header{background:var(--navy);padding:28px 28px 24px;position:relative;overflow:hidden}
    .event-header::before{content:'';position:absolute;top:-30px;right:-30px;width:200px;height:200px;background:radial-gradient(ellipse,rgba(200,144,10,.15),transparent 65%);pointer-events:none}
    .event-badge{display:inline-block;background:rgba(240,192,64,.2);border:1px solid rgba(240,192,64,.4);color:var(--gold-lt);font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;padding:4px 10px;border-radius:20px;margin-bottom:14px}
    .event-header h3{font-family:'Lora',serif;font-size:24px;color:#fff;margin-bottom:8px;position:relative}
    .event-date-line{display:flex;align-items:center;gap:8px;font-size:13px;color:rgba(255,255,255,.45);position:relative}
    .event-date-line svg{color:var(--gold-lt);flex-shrink:0}

    .event-body{padding:28px;flex:1;display:flex;flex-direction:column}
    .event-body p{font-size:14.5px;color:var(--mid);line-height:1.75;flex:1}
    .event-details{margin-top:20px;display:flex;flex-direction:column;gap:8px}
    .event-detail{display:flex;align-items:flex-start;gap:10px;font-size:13.5px;color:var(--mid)}
    .event-detail svg{color:var(--gold);flex-shrink:0;margin-top:2px}
    .event-detail strong{color:var(--text);font-weight:600}
    .event-ctas{margin-top:24px;display:flex;gap:10px;flex-wrap:wrap}
    .btn-ev-primary{display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;padding:11px 20px;border-radius:8px;font-size:13.5px;font-weight:700;transition:all .2s}
    .btn-ev-primary:hover{background:var(--navy-dk);transform:translateY(-1px)}
    .btn-ev-ghost{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--navy);padding:11px 20px;border-radius:8px;font-size:13.5px;font-weight:600;border:1.5px solid var(--border);transition:all .2s}
    .btn-ev-ghost:hover{border-color:var(--gold);color:var(--gold)}

    .tbd-note{background:var(--gold-pale);border:1px solid rgba(200,144,10,.3);border-radius:8px;padding:10px 14px;font-size:12.5px;color:var(--mid);margin-top:16px;line-height:1.5}
    .tbd-note strong{color:var(--navy)}

    /* STAY CONNECTED */
    .stay-band{background:var(--cream);border-radius:20px;padding:48px;text-align:center;margin-bottom:48px}
    .stay-band .script{font-family:'Dancing Script',cursive;font-size:22px;color:var(--gold);margin-bottom:8px;display:block}
    .stay-band h2{font-size:clamp(22px,2.5vw,30px);color:var(--navy);margin-bottom:12px}
    .stay-band p{font-size:15px;color:var(--mid);line-height:1.75;max-width:480px;margin:0 auto 28px}
    .stay-ctas{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .btn-stay{display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;padding:13px 24px;border-radius:9px;font-size:14px;font-weight:700;transition:all .2s}
    .btn-stay:hover{background:var(--navy-dk);transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,46,90,.25)}
    .btn-stay-ghost{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--navy);padding:13px 24px;border-radius:9px;font-size:14px;font-weight:600;border:1.5px solid var(--border);transition:all .2s}
    .btn-stay-ghost:hover{border-color:var(--gold);color:var(--gold)}

    /* SOCIAL */
    .social-row{display:flex;gap:12px;justify-content:center;margin-top:20px}
    .social-btn{display:inline-flex;align-items:center;gap:8px;background:var(--white);border:1.5px solid var(--border);color:var(--navy);padding:10px 18px;border-radius:8px;font-size:13.5px;font-weight:600;transition:all .2s}
    .social-btn:hover{border-color:var(--gold);color:var(--gold);transform:translateY(-1px)}
    .social-btn svg{width:18px;height:18px}

    /* FOOTER */
    footer{background:var(--navy-dk)}
    .f-crisis{background:var(--navy);padding:11px 28px;text-align:center;font-size:13px;color:rgba(255,255,255,.6)}
    .f-crisis a{color:var(--gold-lt);font-weight:700;transition:color .2s}
    .f-crisis a:hover{color:#fff}
    .f-main{padding:28px 28px 6px;max-width:1160px;margin:0 auto}
    .f-grid{display:grid;grid-template-columns:190px 1.3fr 1fr 1fr 1.2fr;gap:30px;align-items:start}
    @media(max-width:880px){.f-grid{grid-template-columns:1fr 1fr;gap:26px}}
    @media(max-width:520px){.f-grid{grid-template-columns:1fr}}
    .f-brand img{width:190px;max-width:190px;height:auto;filter:brightness(0) invert(1);opacity:.95;display:block}
    .f-tagline{font-family:'Dancing Script',cursive;font-size:18px;color:var(--gold-lt);margin-bottom:8px;line-height:1.25}
    .f-brand-p{font-size:12.5px;color:rgba(255,255,255,.4);line-height:1.6;margin:0}
    .f-contact{display:flex;flex-direction:column;gap:12px;margin-bottom:4px}
    .f-contact a{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:rgba(255,255,255,.45);transition:color .15s;line-height:1.5}
    .f-contact a svg{margin-top:2px;flex-shrink:0;color:var(--gold-lt)}
    .f-contact a:hover{color:rgba(255,255,255,.85)}
    .f-contact .phone{color:var(--gold-lt) !important;font-weight:700;font-size:14px}
    .f-col h4{font-family:'Dancing Script',cursive;font-size:16px;font-weight:700;color:rgba(255,255,255,.7);margin-bottom:10px}
    .f-col ul{list-style:none;display:flex;flex-direction:column;gap:2px}
    .f-col ul a{font-size:12px;color:rgba(255,255,255,.4);transition:color .15s;line-height:1.3}
    .f-col ul a:hover{color:var(--gold-lt)}
    .f-col .mt{margin-top:10px}
    .f-bot{max-width:1160px;margin:0 auto;border-top:1px solid rgba(255,255,255,.06);padding:8px 28px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:rgba(255,255,255,.2)}
    .f-bot a{color:rgba(255,255,255,.28);transition:color .2s}
    .f-bot a:hover{color:var(--gold-lt)}
    .f-heal{font-family:'Dancing Script',cursive;font-size:15px;color:rgba(255,255,255,.25)}
  </style>
</head>
<body>

<nav>
  <div class="nav-in">
    <a href="/"><img src="/logo.png" alt="Sunbright Recovery Center"/></a>
    <div class="nav-links">
      <a href="/"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>Home</a>
      <a href="/about"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>About</a>
      <a href="/events" class="active"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>Events</a>
      <a href="/get-involved"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>Get Involved</a>
      <a href="/#faq"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>FAQ</a>
      <a href="/contact"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>Contact</a>
    </div>
    <a href="/get-involved" class="nav-cta">
      <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      Donate Now
    </a>
  </div>
</nav>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="wrap">
    <span class="ph-eyebrow">Events &amp; Fundraisers</span>
    <h1 class="ph-h1">Come together.<br/><em>Change a life.</em></h1>
    <p class="ph-sub">Every event is an opportunity to connect with the Sunbright community, have fun, and help open our doors. We'd love to see you there.</p>
  </div>
</div>

<main>
  <div class="wrap">

    <span class="sec-eyebrow">Upcoming Events</span>
    <h2 class="sec-h2">Mark your calendar</h2>
    <p class="sec-sub">Come out, get involved, and help us bring hope and recovery to Tehama County.</p>

    <div class="event-grid">

      <!-- Silent Auction Fundraiser -->
      <div class="event-card featured" style="grid-column:1/-1">
        <div class="event-header">
          <span class="event-badge">Silent Auction &middot; Fundraiser</span>
          <h3>Silent Auction Fundraiser &amp; Donation Drive</h3>
          <div class="event-date-line">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Saturday, June 27 &nbsp;&middot;&nbsp; 5:00 PM – 8:00 PM
          </div>
        </div>
        <div class="event-body" style="display:grid;grid-template-columns:1fr 1fr;gap:32px">
          <div>
            <p style="margin-bottom:18px">Help us bring hope and recovery to Tehama County! We're collecting themed gift baskets, gift certificates, and auction items — and inviting the whole community to come out on June 27 to bid and celebrate together.</p>
            <div class="event-details">
              <div class="event-detail">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span><strong>Location:</strong> Sunbright Recovery Center<br/>22425 Sunbright Ave, Red Bluff, CA</span>
              </div>
              <div class="event-detail">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span><strong>Time:</strong> 5:00 PM – 8:00 PM</span>
              </div>
              <div class="event-detail" style="background:rgba(200,144,10,.08);border:1px solid rgba(200,144,10,.25);border-radius:8px;padding:10px 12px;margin-top:4px">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#c8900a"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span><strong style="color:var(--text)">Basket donation deadline: June 19</strong><br/><span style="font-size:12.5px;color:var(--soft)">Donate or drop off baskets before the event</span></span>
              </div>
            </div>
            <div style="background:var(--navy-lt);border-radius:12px;padding:14px 16px;font-size:13px;color:var(--mid);line-height:1.6;margin-top:20px">
              <strong style="color:var(--navy)">Contact Faith O'Dell, Program Director</strong><br/>
              Call/Text: <a href="tel:+15307272211" style="color:var(--gold);font-weight:700">(530) 727-2211</a><br/>
              Email: <a href="mailto:info@sunbrightrecovery.org" style="color:var(--gold);font-weight:700">info@sunbrightrecovery.org</a>
            </div>
            <div class="event-ctas" style="margin-top:20px">
              <a href="https://www.facebook.com/profile.php?id=61590180493030" target="_blank" rel="noopener" class="btn-ev-primary">
                <svg fill="currentColor" viewBox="0 0 24 24" width="15" height="15"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                View on Facebook
              </a>
              <a href="/contact" class="btn-ev-ghost">Questions? Contact Us</a>
            </div>
          </div>
          <div>
            <p style="font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:14px">How You Can Help</p>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:20px">
              <li style="display:flex;gap:10px;font-size:13.5px;color:var(--mid)"><svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#c8900a;flex-shrink:0;margin-top:2px"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Donate a themed gift basket (no alcohol)</li>
              <li style="display:flex;gap:10px;font-size:13.5px;color:var(--mid)"><svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:#c8900a;flex-shrink:0;margin-top:2px"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>Donate gift certificates or gift cards</li>
