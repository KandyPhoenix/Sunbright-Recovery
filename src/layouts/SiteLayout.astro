        <div class="f-legal"><a href="/client-rights">Client Rights &amp; Grievances</a><br/><a href="/first-14-days">First 14 Days Policy</a><br/><a href="/workplace-safety">IIPP</a> &nbsp;|&nbsp; <a href="/privacy-policy">Privacy Policy</a></div>
      </div>
      <div class="f-col">
