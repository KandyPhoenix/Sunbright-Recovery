---
/**
 * SiteLayout — shared layout for the full Sunbright Recovery site structure.
 *
 * Renders the approved navy/gold design system (src/styles/site.css), the
 * site-wide nav + footer, full SEO meta (title, description, canonical, Open
 * Graph, Twitter), and JSON-LD schema (Organization site-wide + any
 * page-specific schema + an auto-generated BreadcrumbList).
 *
 * NOTE: every page is noindex while PRELAUNCH is true in src/config/site.ts.
 * At launch follow seo/launch-checklist.md (flip PRELAUNCH, swap robots.txt,
 * sitemap filter and llms.txt) — only after the December site visit and Kandy's yes.
 */
import '../styles/site.css';
import { organizationSchema } from '../schema/organization';
import { breadcrumbSchema } from '../schema/breadcrumb';
import { SITE, SITE_NAME, PHONE_DISPLAY, PHONE_TEL, EMAIL, PRELAUNCH, GA4_ID, DHCS_LICENSE_URL, absUrl } from '../config/site';

interface Crumb { name: string; url: string; }

interface Props {
  title: string;            // <title> + og:title (brand suffix added automatically)
  description: string;      // meta description (150–160 chars)
  primaryKeyword?: string;  // documentation only — the page's target query
  canonical?: string;       // defaults to the live .org URL for this path
  noindex?: boolean;        // defaults true until launch
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[]; // page-specific JSON-LD
  breadcrumbs?: Crumb[];    // [{name,url}] — also emitted as BreadcrumbList schema
  activeNav?: string;       // nav key to highlight: programs | treat | approach | admissions | insurance | team | contact
}

// The site homepage now lives at the root "/" (design-preview was promoted to
// index.astro). On launch, just flip the `noindex` default below to false.
const HOME = '/';

const {
  title,
  description,
  canonical = absUrl(Astro.url.pathname),
  noindex = PRELAUNCH,
  ogImage = '/images/facility-wide.jpg',
  schema,
  breadcrumbs = [],
  activeNav,
} = Astro.props;

const siteName = SITE_NAME;
// Titles that already name Sunbright are used as-is (keeps them within ~60 chars).
const fullTitle = title.includes('Sunbright') ? title : `${title} | ${siteName}`;
const ogImageUrl = new URL(ogImage, SITE).href;

// Assemble JSON-LD: org (site-wide) + breadcrumbs + page schema
const schemaBlocks: Record<string, unknown>[] = [organizationSchema()];
if (breadcrumbs.length) {
  schemaBlocks.push(
    breadcrumbSchema(breadcrumbs.map((c) => ({ name: c.name, url: absUrl(c.url) })))
  );
}
if (Array.isArray(schema)) schemaBlocks.push(...schema);
else if (schema) schemaBlocks.push(schema);

const navLinks = [
  { key: 'about', href: '/about/', label: 'About' },
  { key: 'programs', href: '/programs/', label: 'Programs' },
  { key: 'treat', href: '/what-we-treat', label: 'What We Treat' },
  { key: 'approach', href: '/our-approach', label: 'Our Approach' },
  { key: 'admissions', href: '/admissions', label: 'Admissions' },
  { key: 'insurance', href: '/insurance', label: 'Insurance' },
  { key: 'team', href: '/team', label: 'Team' },
  { key: 'contact', href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  <meta name="geo.region" content="US-CA" />
  <meta name="geo.placename" content="Red Bluff, California" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <meta property="og:locale" content="en_US" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  {GA4_ID && !noindex && (
    <Fragment>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        // No form field values or health details are ever sent (see CLAUDE.md, Privacy & HIPAA).
        gtag('config', GA4_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
      </script>
    </Fragment>
  )}

  {schemaBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</head>
<body>

<nav>
  <div class="nav-in">
    <a href={HOME} aria-label="Sunbright Recovery Center — home"><img src="/logo.png" alt="Sunbright Recovery Center" /></a>
    <div class="nav-links">
      {navLinks.map((l) => (
        <a href={l.href} aria-current={activeNav === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <a href={`tel:${PHONE_TEL}`} class="nav-cta">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      {PHONE_DISPLAY}
    </a>
  </div>
</nav>

<!-- Breadcrumbs are emitted as BreadcrumbList JSON-LD (above) for SEO, but the
     visible breadcrumb bar is intentionally omitted from the page chrome. -->

<main>
  <slot />
</main>

<footer>
  <div class="f-crisis">Call us: <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a> &nbsp;·&nbsp; Medical emergency: 911 &nbsp;·&nbsp; Crisis: call or text <a href="tel:988">988</a></div>
  <div class="f-main">
    <div class="f-grid">
