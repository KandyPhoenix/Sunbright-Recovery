---
const programs = [
  { label: 'Residential Rehab', href: '/programs/residential' },
  { label: 'Outpatient (IOP/PHP)', href: '/programs/outpatient' },
  { label: 'Sober Living', href: '/programs/sober-living' },
];

const conditions = [
  { label: 'Alcohol Use Disorder', href: '/what-we-treat/alcohol' },
  { label: 'Opioid Addiction', href: '/what-we-treat/opioids' },
  { label: 'Dual Diagnosis', href: '/what-we-treat/dual-diagnosis' },
  { label: 'Trauma & Addiction', href: '/what-we-treat/trauma-addiction' },
];

const quickLinks = [
  { label: 'About Sunbright', href: '/about' },
  { label: 'Our Approach', href: '/our-approach' },
  { label: 'Insurance & Medi-Cal', href: '/insurance' },
  { label: 'Admissions', href: '/admissions' },
  { label: 'Meet Our Team', href: '/team' },
  { label: 'Family Resources', href: '/family-resources' },
  { label: 'FAQs', href: '/faqs' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-navy-900 text-white">
  <!-- Crisis bar -->
  <div class="bg-navy-800 border-b border-white/10 py-3">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 text-sm text-center">
      <span class="font-medium text-navy-100">If this is a medical emergency, call 911.</span>
      <span class="text-navy-500 hidden sm:inline">|</span>
      <span class="text-navy-100">National Recovery Helpline (SAMHSA):
        <a href="tel:+18006624357" class="font-semibold text-gold-400 hover:text-gold-300 transition-colors">1-800-662-4357</a>
      </span>
    </div>
  </div>

  <!-- Main footer -->
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 group mb-5">
          <img
            src="/logo.png"
            alt="Sunbright Recovery Center"
            class="h-12 w-auto brightness-0 invert opacity-90"
            onerror="this.style.display='none'"
          />
        </a>
        <p class="text-sm text-navy-300 leading-relaxed mb-6">
          Faith-integrated, evidence-based addiction recovery. Founded by Linda Spyres, LCSW, LAADC-CA — 20+ years serving Northern California.
        </p>
        <div class="space-y-2.5 text-sm">
          <div class="flex items-start gap-2 text-navy-400">
            <svg class="w-4 h-4 text-gold-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>22425 Sunbright Ave<br />Red Bluff, CA 96080</span>
          </div>
          <a href="tel:+15307272211" class="flex items-center gap-2 text-gold-400 hover:text-gold-300 transition-colors font-semibold">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            (530) 727-2211
          </a>
          <a href="mailto:admissions@sunbrightrecovery.com" class="flex items-center gap-2 text-navy-400 hover:text-white transition-colors text-xs">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            admissions@sunbrightrecovery.com
          </a>
        </div>
      </div>

      <!-- Programs -->
      <div>
        <h3 class="text-xs font-semibold text-navy-400 uppercase tracking-widest mb-4">Programs</h3>
        <ul class="space-y-2">
          {programs.map(link => (
            <li>
              <a href={link.href} class="text-sm text-navy-300 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>

        <h3 class="text-xs font-semibold text-navy-400 uppercase tracking-widest mb-4 mt-8">What We Treat</h3>
        <ul class="space-y-2">
          {conditions.map(link => (
            <li>
              <a href={link.href} class="text-sm text-navy-300 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-xs font-semibold text-navy-400 uppercase tracking-widest mb-4">About</h3>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-navy-300 hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Insurance + credentials -->
      <div>
        <h3 class="text-xs font-semibold text-navy-400 uppercase tracking-widest mb-4">Insurance Accepted</h3>
        <ul class="space-y-2 text-sm text-navy-300 mb-8">
          {['Medi-Cal', 'Medicare', 'Private Insurance', 'Sliding Scale Available'].map(item => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-gold-500 flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>

        <h3 class="text-xs font-semibold text-navy-400 uppercase tracking-widest mb-4">Credentials</h3>
        <ul class="space-y-1 text-xs text-navy-400">
          <li>Linda Spyres, LCSW</li>
          <li>LAADC-CA</li>
          <li>20+ years addiction treatment</li>
          <li>Faith Odell, SUDRC</li>
        </ul>

        <p class="text-xs text-navy-500 mt-6">
          An affiliate of
          <a href="https://phwcare.com" class="text-sky-400 hover:text-sky-300 transition-colors">Parish Health and Wellness</a>
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-navy-500">
      <p>&copy; {new Date().getFullYear()} Sunbright Recovery Center. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/accessibility" class="hover:text-white transition-colors">Accessibility</a>
        <span class="flex items-center gap-1">
          <svg class="w-3 h-3 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          HIPAA Compliant
        </span>
      </div>
    </div>
  </div>
</footer>
