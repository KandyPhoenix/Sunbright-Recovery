---
interface Props {
  h1: string;
  subhead: string;
  trustLine?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  privacyNote?: boolean;
  centered?: boolean;
  size?: 'full' | 'compact';
}

const {
  h1,
  subhead,
  trustLine,
  primaryCta = { label: 'Call (530) 528-2342', href: 'tel:+15305282342' },
  secondaryCta,
  privacyNote = true,
  centered = false,
  size = 'full',
} = Astro.props;
---

<section class={`relative overflow-hidden bg-gradient-to-br from-navy-900 via-navy-800 to-sky-700 ${size === 'full' ? 'py-20 lg:py-28' : 'py-14 lg:py-20'}`}>
  <!-- Warm gold glow effect (inspired by the sun in the logo) -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gold-500 opacity-10 rounded-full blur-3xl"></div>
    <div class="absolute top-8 left-1/2 -translate-x-1/2 w-[300px] h-[300px] bg-gold-400 opacity-15 rounded-full blur-2xl"></div>
  </div>

  <!-- Subtle wave bottom edge -->
  <div class="absolute bottom-0 left-0 right-0 h-12 overflow-hidden" aria-hidden="true">
    <svg viewBox="0 0 1200 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" preserveAspectRatio="none">
      <path d="M0 48L50 40C100 32 200 16 300 12C400 8 500 16 600 20C700 24 800 24 900 20C1000 16 1100 8 1150 4L1200 0V48H0Z" fill="white"/>
    </svg>
  </div>

  <div class={`relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 ${centered ? 'text-center' : ''}`}>
    <div class={`max-w-3xl ${centered ? 'mx-auto' : ''}`}>

      {trustLine && (
        <div class={`flex items-center gap-2 text-sm text-gold-400 font-medium mb-5 ${centered ? 'justify-center' : ''}`}>
          <span class="w-1 h-4 bg-gold-500 rounded-full flex-shrink-0"></span>
          <span>{trustLine}</span>
        </div>
      )}

      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold text-white leading-tight mb-5">
        {h1}
      </h1>

      <p class="text-lg sm:text-xl text-navy-200 leading-relaxed mb-8 max-w-2xl">
        {subhead}
      </p>

      <div class={`flex flex-col sm:flex-row gap-3 ${centered ? 'justify-center' : ''}`}>
        <a
          href={primaryCta.href}
          class="flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-400 text-navy-900 px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md shadow-gold-900/30 hover:shadow-lg hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {primaryCta.label}
        </a>

        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/25 hover:border-white/40 px-6 py-3.5 rounded-xl text-base font-semibold transition-all backdrop-blur-sm hover:-translate-y-0.5"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>

      {privacyNote && (
        <p class={`mt-5 text-sm text-navy-300 flex items-center gap-1.5 ${centered ? 'justify-center' : ''}`}>
          <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Your call is completely private. We follow HIPAA confidentiality.
        </p>
      )}
    </div>
  </div>
</section>
