---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  heading?: string;
}

const {
  items,
  heading = 'Frequently Asked Questions',
} = Astro.props;
---

<section class="py-14 lg:py-20 bg-cream-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-3xl lg:text-4xl font-semibold text-ink-900 text-center mb-10">
      {heading}
    </h2>

    <div class="space-y-3" itemscope itemtype="https://schema.org/FAQPage">
      {items.map((item, i) => (
        <div
          class="bg-white rounded-xl border border-navy-100 overflow-hidden"
          itemscope
          itemprop="mainEntity"
          itemtype="https://schema.org/Question"
        >
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 text-left hover:bg-navy-50 transition-colors"
            aria-expanded="false"
          >
            <span class="font-medium text-ink-900 text-base" itemprop="name">{item.question}</span>
            <svg
              class="faq-icon w-5 h-5 text-navy-400 flex-shrink-0 transition-transform duration-200"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            class="faq-panel hidden px-6 pb-5"
            itemscope
            itemprop="acceptedAnswer"
            itemtype="https://schema.org/Answer"
          >
            <p class="text-ink-500 leading-relaxed text-sm" itemprop="text">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href="/faqs" class="text-sm font-medium text-navy-600 hover:text-navy-800 transition-colors inline-flex items-center gap-1.5">
        See all FAQs
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !panel.classList.contains('hidden');

      panel.classList.toggle('hidden', isOpen);
      icon.style.transform = isOpen ? '' : 'rotate(180deg)';
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
