---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: 'home' | 'outpatient' | 'sober';
  tag?: string;
}

const { title, description, href, icon = 'home', tag } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col bg-white rounded-2xl border border-navy-100 p-6 shadow-sm hover:shadow-md hover:border-navy-200 transition-all hover:-translate-y-0.5"
>
  <div class="flex items-start justify-between mb-4">
    <div class="w-11 h-11 rounded-xl bg-navy-50 group-hover:bg-navy-100 transition-colors flex items-center justify-center flex-shrink-0">
      {icon === 'home' && (
        <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      )}
      {icon === 'outpatient' && (
        <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      )}
      {icon === 'sober' && (
        <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      )}
    </div>
    {tag && (
      <span class="text-xs font-medium text-navy-700 bg-gold-50 px-2.5 py-1 rounded-full border border-gold-200">
        {tag}
      </span>
    )}
  </div>

  <h3 class="font-serif text-lg font-semibold text-ink-900 mb-2 group-hover:text-navy-700 transition-colors">
    {title}
  </h3>
  <p class="text-sm text-ink-500 leading-relaxed flex-1 mb-4">
    {description}
  </p>

  <span class="flex items-center gap-1.5 text-sm font-medium text-navy-600 group-hover:gap-2.5 transition-all">
    Learn more
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </span>
</a>
