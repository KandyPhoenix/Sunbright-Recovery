---
interface Props {
  heading?: string;
  subtext?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'gold' | 'navy' | 'light';
}

const {
  heading = 'Ready to take the first step?',
  subtext = 'Call us today. Your conversation is private, judgment-free, and completely confidential.',
  primaryCta = { label: 'Call (530) 528-2342', href: 'tel:+15305282342' },
  secondaryCta,
  variant = 'navy',
} = Astro.props;

const bgClass = {
  navy: 'bg-navy-800',
  gold: 'bg-gold-500',
  light: 'bg-navy-50',
}[variant];

const headingClass = {
  navy: 'text-white',
  gold: 'text-navy-900',
  light: 'text-navy-900',
}[variant];

const subtextClass = {
  navy: 'text-navy-300',
  gold: 'text-navy-800',
  light: 'text-ink-500',
}[variant];

const btnClass = {
  navy: 'bg-gold-500 hover:bg-gold-400 text-navy-900',
  gold: 'bg-navy-800 hover:bg-navy-900 text-white',
  light: 'bg-navy-700 hover:bg-navy-800 text-white',
}[variant];

const secondaryBtnClass = {
  navy: 'bg-white/10 hover:bg-white/20 text-white border border-white/25',
  gold: 'bg-white/30 hover:bg-white/50 text-navy-900 border border-navy-200',
  light: 'bg-white hover:bg-navy-50 text-navy-700 border border-navy-200',
}[variant];
---

<section class={`${bgClass} py-14 lg:py-16`}>
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class={`font-serif text-3xl lg:text-4xl font-semibold ${headingClass} mb-3`}>
      {heading}
    </h2>
    <p class={`text-lg ${subtextClass} mb-8 max-w-xl mx-auto`}>
      {subtext}
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={primaryCta.href}
        class={`flex items-center justify-center gap-2 ${btnClass} px-7 py-3.5 rounded-xl text-base font-bold transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5`}
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class={`flex items-center justify-center gap-2 ${secondaryBtnClass} px-7 py-3.5 rounded-xl text-base font-semibold transition-all hover:-translate-y-0.5`}
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
    <p class={`mt-5 text-sm ${subtextClass} flex items-center justify-center gap-1.5`}>
      <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      HIPAA confidential. No commitment required.
    </p>
  </div>
</section>
